    public void Undefined_enums_are_rejected()
    {
        Assert.Throws<ArgumentOutOfRangeException>(() =>
            new FetchJob(Guid.NewGuid(), 1, (FetchTrigger)99, FetchMode.Recent, 1));
    }
}

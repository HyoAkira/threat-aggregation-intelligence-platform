<file path="src/ThreatIntelligence.Infrastructure/Persistence/Repositories/FetchHistoryRepository.cs">
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.Abstractions.Persistence;
using ThreatIntelligence.Domain.Entities;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Persistence.Repositories;

/// <summary>
/// Uses a fresh DbContext per operation so history writes are never inside the IOC transaction.
/// </summary>
public sealed class FetchHistoryRepository(
    IDbContextFactory<ThreatIntelligenceDbContext> contextFactory) : IFetchHistoryRepository
{
    public async Task AddAsync(FetchHistory history, CancellationToken cancellationToken)
    {
        await using var context = await contextFactory.CreateDbContextAsync(cancellationToken);
        context.FetchHistory.Add(history);
        await context.SaveChangesAsync(cancellationToken);
    }

    public async Task UpdateAsync(FetchHistory history, CancellationToken cancellationToken)
    {
        await using var context = await contextFactory.CreateDbContextAsync(cancellationToken);
        context.FetchHistory.Update(history);
        await context.SaveChangesAsync(cancellationToken);
    }

    public async Task<FetchHistory?> GetByJobIdAsync(Guid jobId, CancellationToken cancellationToken)
    {
        await using var context = await contextFactory.CreateDbContextAsync(cancellationToken);
        return await context.FetchHistory
            .AsNoTracking()
            .SingleOrDefaultAsync(h => h.JobId == jobId, cancellationToken);
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Persistence/Repositories/IocRepository.cs">
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.Abstractions.Hashing;
using ThreatIntelligence.Application.Abstractions.Persistence;
using ThreatIntelligence.Domain.Entities;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Hashing;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Persistence.Repositories;

public sealed class IocRepository(
    ThreatIntelligenceDbContext dbContext,
    IValueHasher hasher) : IIocRepository
{
    public async Task<IoC?> FindByEndpointIdentityAsync(
        int providerId,
        IocType iocType,
        string normalizedValue,
        int? port,
        CancellationToken cancellationToken)
    {
        var hash = hasher.Hash(normalizedValue);
        var portKey = port ?? 0;

        var candidate = await dbContext.Iocs
            .AsNoTracking()
            .SingleOrDefaultAsync(
                i => i.ProviderId == providerId
                    && i.IocType == iocType
                    && i.IocValueHash == hash
                    && EF.Property<int>(i, "PortKey") == portKey,
                cancellationToken);

        if (candidate is null)
        {
            return null;
        }

        return ValueEquality.Matches(candidate.IocValueHash, candidate.IocValue, normalizedValue, hasher)
            ? candidate
            : null;
    }

    public async Task<IoC?> FindByProviderRecordIdAsync(
        int providerId,
        string providerRecordId,
        CancellationToken cancellationToken)
    {
        return await dbContext.Iocs
            .AsNoTracking()
            .SingleOrDefaultAsync(
                i => i.ProviderId == providerId && i.ProviderRecordId == providerRecordId,
                cancellationToken);
    }

    public async Task<IReadOnlyList<IoC>> GetGroupedAsync(
        IocType iocType,
        string normalizedValue,
        CancellationToken cancellationToken)
    {
        var hash = hasher.Hash(normalizedValue);

        var candidates = await dbContext.Iocs
            .AsNoTracking()
            .Where(i => i.IocType == iocType && i.IocValueHash == hash)
            .ToListAsync(cancellationToken);

        return candidates
            .Where(i => ValueEquality.Matches(i.IocValueHash, i.IocValue, normalizedValue, hasher))
            .ToList();
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Persistence/Repositories/UnitOfWork.cs">
using Microsoft.EntityFrameworkCore.Storage;
using ThreatIntelligence.Application.Abstractions.Persistence;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Persistence.Repositories;

public sealed class UnitOfWork(ThreatIntelligenceDbContext dbContext) : IUnitOfWork
{
    private IDbContextTransaction? _transaction;

    public async Task BeginAsync(CancellationToken cancellationToken)
    {
        _transaction = await dbContext.Database.BeginTransactionAsync(cancellationToken);
    }

    public async Task CommitAsync(CancellationToken cancellationToken)
    {
        await dbContext.SaveChangesAsync(cancellationToken);

        if (_transaction is not null)
        {
            await _transaction.CommitAsync(cancellationToken);
            await _transaction.DisposeAsync();
            _transaction = null;
        }
    }

    public async Task RollbackAsync(CancellationToken cancellationToken)
    {
        if (_transaction is not null)
        {
            await _transaction.RollbackAsync(cancellationToken);
            await _transaction.DisposeAsync();
            _transaction = null;
        }

        dbContext.ChangeTracker.Clear();
    }
}
</file>


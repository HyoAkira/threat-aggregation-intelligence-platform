<file path="src/ThreatIntelligence.Infrastructure/Reporting/MarkdownPdfRenderer.cs">
using System.ComponentModel;
using System.Diagnostics;
using System.Text;
using System.Text.RegularExpressions;
using Microsoft.Extensions.Logging;
using ThreatIntelligence.Application.AI;

namespace ThreatIntelligence.Infrastructure.Reporting;

public sealed class MarkdownPdfRenderer(
    string pandocPath,
    string templatePath,
    ILogger<MarkdownPdfRenderer> logger) : IMarkdownPdfRenderer
{
    private const long MaxPdfBytes = 10 * 1024 * 1024;

    public async Task<byte[]> RenderAsync(
        string markdown,
        PdfReportMetadata metadata,
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            throw new PdfRenderingException("pdf_input_invalid", "The report is empty.");
        }

        if (markdown.Length > PdfReportLimits.MaxMarkdownCharacters)
        {
            throw new PdfRenderingException(
                "pdf_input_too_large",
                "The report exceeds the PDF input size limit.");
        }

        // Reports are text-only. Reject image syntax so a caller cannot make pandoc read an
        // arbitrary server-local file while converting the document.
        if (Regex.IsMatch(markdown, @"!\s*\["))
        {
            throw new PdfRenderingException(
                "pdf_input_invalid",
                "Image content is not supported in PDF exports.");
        }

        if (!File.Exists(templatePath))
        {
            throw new PdfRenderingException(
                "pdf_template_missing",
                "The PDF template is not available.");
        }

        using var renderTimeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        renderTimeout.CancelAfter(TimeSpan.FromSeconds(60));
        var renderCancellationToken = renderTimeout.Token;

        var workDirectory = Path.Combine(
            Path.GetTempPath(),
            "threat-intelligence-pdf",
            Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(workDirectory);

        var markdownPath = Path.Combine(workDirectory, "report.md");
        var outputPath = Path.Combine(workDirectory, "report.pdf");

        try
        {
            await File.WriteAllTextAsync(
                markdownPath,
                markdown,
                new UTF8Encoding(encoderShouldEmitUTF8Identifier: false),
                renderCancellationToken);

            var processStartInfo = new ProcessStartInfo
            {
                FileName = pandocPath,
                WorkingDirectory = workDirectory,
                UseShellExecute = false,
                CreateNoWindow = true,
                RedirectStandardError = true,
            };
            processStartInfo.ArgumentList.Add(markdownPath);
            processStartInfo.ArgumentList.Add("--from=gfm-raw_html");
            processStartInfo.ArgumentList.Add("--standalone");
            processStartInfo.ArgumentList.Add("--template");
            processStartInfo.ArgumentList.Add(templatePath);
            processStartInfo.ArgumentList.Add("--pdf-engine=xelatex");
            processStartInfo.ArgumentList.Add("--pdf-engine-opt=--no-shell-escape");
            processStartInfo.ArgumentList.Add("--number-sections");
            processStartInfo.ArgumentList.Add("--metadata");
            processStartInfo.ArgumentList.Add("title:IOC Threat Intelligence Report");
            processStartInfo.ArgumentList.Add("--metadata");
            processStartInfo.ArgumentList.Add($"subtitle:Indicator of Compromise {metadata.IocId}");
            processStartInfo.ArgumentList.Add("--metadata");
            processStartInfo.ArgumentList.Add(
                $"date:{metadata.GeneratedAtUtc.ToUniversalTime():yyyy-MM-dd HH:mm} UTC");
            processStartInfo.ArgumentList.Add("--output");
            processStartInfo.ArgumentList.Add(outputPath);

            using var process = new Process { StartInfo = processStartInfo };
            try
            {
                if (!process.Start())
                {
                    throw new PdfRenderingException(
                        "pdf_renderer_unavailable",
                        "The PDF renderer could not be started.");
                }
            }
            catch (Win32Exception exception)
            {
                throw new PdfRenderingException(
                    "pdf_renderer_unavailable",
                    "Pandoc is not installed or cannot be started.",
                    exception);
            }

            var standardErrorTask = process.StandardError.ReadToEndAsync(renderCancellationToken);
            try
            {
                await process.WaitForExitAsync(renderCancellationToken);
            }
            catch (OperationCanceledException) when (renderTimeout.IsCancellationRequested)
            {
                TryKill(process);
                if (!cancellationToken.IsCancellationRequested)
                {
                    throw new PdfRenderingException(
                        "pdf_render_timeout",
                        "The PDF conversion exceeded its time limit.");
                }

                throw;
            }

            var standardError = await standardErrorTask;
            if (process.ExitCode != 0)
            {
                logger.LogWarning(
                    "Pandoc failed to render IOC report with exit code {ExitCode}; stderr length {ErrorLength}",
                    process.ExitCode,
                    standardError.Length);
                throw new PdfRenderingException(
                    "pdf_render_failed",
                    "Pandoc could not render the report.");
            }

            var fileInfo = new FileInfo(outputPath);
            if (!fileInfo.Exists || fileInfo.Length == 0 || fileInfo.Length > MaxPdfBytes)
            {
                throw new PdfRenderingException(
                    "pdf_render_failed",
                    "Pandoc did not produce a valid PDF.");
            }

            return await File.ReadAllBytesAsync(outputPath, renderCancellationToken);
        }
        finally
        {
            TryDeleteDirectory(workDirectory);
        }
    }

    private static void TryKill(Process process)
    {
        try
        {
            if (!process.HasExited)
            {
                process.Kill(entireProcessTree: true);
            }
        }
        catch (InvalidOperationException)
        {
            // The process may have exited between HasExited and Kill.
        }
    }

    private static void TryDeleteDirectory(string path)
    {
        try
        {
            if (Directory.Exists(path))
            {
                Directory.Delete(path, recursive: true);
            }
        }
        catch (IOException)
        {
            // Temporary cleanup must not mask the render result.
        }
        catch (UnauthorizedAccessException)
        {
            // Temporary cleanup must not mask the render result.
        }
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Storage/RawFeedStore.cs">
using System.Globalization;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Infrastructure.Configuration;

namespace ThreatIntelligence.Infrastructure.Storage;

/// <summary>
/// Writes provider feeds to <c>{BasePath}/{provider}/{recents|fulls}/{stem}_{timestamp}{ext}</c>.
/// Files are written to a sibling <c>.tmp</c> file and renamed into place so a failed or
/// cancelled write never leaves a partial feed. Storage failures are wrapped in
/// <see cref="TransientFetchException"/>.
/// </summary>
public sealed class RawFeedStore : IRawFeedStore
{
    private const string RecentFolder = "recents";
    private const string FullFolder = "fulls";
    private const int CopyBufferSize = 81920;

    private static readonly string[] CompoundExtensions = [".json.gz", ".json.zip"];

    private readonly string _basePath;
    private readonly TimeProvider _timeProvider;
    private readonly ILogger<RawFeedStore> _logger;

    public RawFeedStore(
        RawStorageOptions options,
        TimeProvider timeProvider,
        ILogger<RawFeedStore>? logger = null)
    {
        _basePath = options.BasePath;
        _timeProvider = timeProvider;
        _logger = logger ?? NullLogger<RawFeedStore>.Instance;
    }

    public async Task<RawFeedFile> SaveAsync(
        string providerSlug,
        RawFeedCategory category,
        string sourceFileName,
        Stream content,
        CancellationToken cancellationToken)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(providerSlug);
        ArgumentNullException.ThrowIfNull(content);
        cancellationToken.ThrowIfCancellationRequested();

        if (providerSlug.Contains(Path.DirectorySeparatorChar)
            || providerSlug.Contains(Path.AltDirectorySeparatorChar)
            || providerSlug.Contains("..", StringComparison.Ordinal))
        {
            throw new ArgumentException("Provider slug must be a single path segment.", nameof(providerSlug));
        }

        var directory = Path.Combine(Path.GetFullPath(_basePath), providerSlug, FolderFor(category));
        var fileName = BuildFileName(sourceFileName);

        try
        {
            Directory.CreateDirectory(directory);
            var finalPath = EnsureUnique(Path.Combine(directory, fileName));
            var tempPath = finalPath + ".tmp";

            try
            {
                await using (var destination = new FileStream(
                    tempPath,
                    FileMode.CreateNew,
                    FileAccess.Write,
                    FileShare.None,
                    CopyBufferSize,
                    FileOptions.Asynchronous | FileOptions.SequentialScan))
                {
                    await content.CopyToAsync(destination, CopyBufferSize, cancellationToken).ConfigureAwait(false);
                }

                File.Move(tempPath, finalPath);
            }
            catch
            {
                TryDelete(tempPath);
                throw;
            }

            var length = new FileInfo(finalPath).Length;
            _logger.LogInformation(
                "Raw feed persisted Provider={Provider} Category={Category} Path={Path} Bytes={Bytes}",
                providerSlug,
                category,
                finalPath,
                length);

            return new RawFeedFile(providerSlug, category, Path.GetFileName(finalPath), finalPath, length);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or NotSupportedException or System.Security.SecurityException)
        {
            throw new TransientFetchException(
                $"Failed to persist raw {providerSlug} {category} feed to disk.",
                ex);
        }
    }

    public Stream OpenRead(RawFeedFile file)
    {
        ArgumentNullException.ThrowIfNull(file);

        return new FileStream(
            file.Path,
            FileMode.Open,
            FileAccess.Read,
            FileShare.Read,
            CopyBufferSize,
            FileOptions.Asynchronous | FileOptions.SequentialScan);
    }

    private static string FolderFor(RawFeedCategory category) => category switch
    {
        RawFeedCategory.Recent => RecentFolder,
        RawFeedCategory.Full => FullFolder,
        _ => throw new ArgumentOutOfRangeException(nameof(category), category, null)
    };

    private string BuildFileName(string sourceFileName)
    {
        var (stem, extension) = SplitExtension(sourceFileName);
        var timestamp = _timeProvider.GetUtcNow().ToString("yyyyMMdd'T'HHmmss'Z'", CultureInfo.InvariantCulture);
        return $"{stem}_{timestamp}{extension}";
    }

    private static (string Stem, string Extension) SplitExtension(string sourceFileName)
    {
        var name = Path.GetFileName(sourceFileName);

        foreach (var compound in CompoundExtensions)
        {
            if (name.EndsWith(compound, StringComparison.OrdinalIgnoreCase))
            {
                return (name[..^compound.Length], compound);
            }
        }

        var extension = Path.GetExtension(name);
        return extension.Length == 0
            ? (name, string.Empty)
            : (name[..^extension.Length], extension);
    }

    private static string EnsureUnique(string path)
    {
        if (!File.Exists(path))
        {
            return path;
        }

        var directory = Path.GetDirectoryName(path)!;
        var stem = Path.GetFileNameWithoutExtension(path);
        var extension = Path.GetExtension(path);

        for (var suffix = 1; ; suffix++)
        {
            var candidate = Path.Combine(directory, $"{stem}_{suffix}{extension}");
            if (!File.Exists(candidate))
            {
                return candidate;
            }
        }
    }

    private static void TryDelete(string path)
    {
        try
        {
            if (File.Exists(path))
            {
                File.Delete(path);
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // Best-effort cleanup; the original failure is what matters.
        }
    }
}
</file>

<file path="tests/ThreatIntelligence.IntegrationTests/AdminAiApiTests.cs">
using System.Net;
using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Security.Claims;
using System.Text;
using System.Text.Json.Nodes;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.IdentityModel.JsonWebTokens;
using Microsoft.IdentityModel.Tokens;
using ThreatIntelligence.Domain.Enums;

namespace ThreatIntelligence.IntegrationTests;

/// <summary>
/// Verifies that the AI admin endpoints inherit the api/admin Admin-role requirement and that
/// a full AI settings flow works end to end through the HTTP pipeline.
/// </summary>
[Collection("sqlserver")]
public sealed class AdminAiApiTests(SqlServerFixture fixture) : IAsyncLifetime
{
    private const string Issuer = "threat-intelligence-tests";
    private const string Audience = "threat-intelligence-api-tests";
    private const string Secret = "integration-test-jwt-secret-that-is-at-least-sixty-four-bytes-long!!";

    private AdminAiApiFactory _factory = null!;
    private HttpClient _client = null!;
    private string _connectionString = null!;

    public async Task InitializeAsync()
    {
        await fixture.ResetDataAsync();
        _connectionString = fixture.ConnectionString;
        _factory = new AdminAiApiFactory(_connectionString);
        _client = _factory.CreateClient(new WebApplicationFactoryClientOptions
        {
            AllowAutoRedirect = false,
            BaseAddress = new Uri("https://localhost")
        });
        using var startup = await _client.GetAsync("/health/live");
        startup.EnsureSuccessStatusCode();
    }

    public async Task DisposeAsync()
    {
        _client.Dispose();
        await _factory.DisposeAsync();
    }

    [Fact]
    public async Task Anonymous_caller_cannot_read_or_change_ai_settings()
    {
        using var read = await _client.GetAsync("/api/admin/ai/settings");
        Assert.Equal(HttpStatusCode.Unauthorized, read.StatusCode);
        var problem = (await read.Content.ReadFromJsonAsync<JsonObject>())!;
        Assert.Equal("unauthenticated", (string)problem["code"]!);

        using var change = await _client.PutAsJsonAsync("/api/admin/ai/settings",
            new { baseUrl = "http://ollama:11434", modelId = "llama3.1", enabled = true });
        Assert.Equal(HttpStatusCode.Unauthorized, change.StatusCode);
    }

    [Fact]
    public async Task Non_admin_cannot_read_or_change_ai_settings()
    {
        using var read = await GetAuthorized("/api/admin/ai/settings", UserRole.User);
        Assert.Equal(HttpStatusCode.Forbidden, read.StatusCode);
        var problem = (await read.Content.ReadFromJsonAsync<JsonObject>())!;
        Assert.Equal("forbidden", (string)problem["code"]!);

        using var change = await PutAuthorized("/api/admin/ai/settings",
            new { baseUrl = "http://ollama:11434", modelId = "llama3.1", enabled = true }, UserRole.User);
        Assert.Equal(HttpStatusCode.Forbidden, change.StatusCode);
    }

    [Fact]
    public async Task Non_admin_cannot_read_or_publish_the_report_policy()
    {
        using var read = await GetAuthorized("/api/admin/ai/report-policy", UserRole.User);
        Assert.Equal(HttpStatusCode.Forbidden, read.StatusCode);

        using var publish = await PutAuthorized("/api/admin/ai/report-policy",
            new { text = "Yönerge", expectedVersion = (int?)null }, UserRole.User);
        Assert.Equal(HttpStatusCode.Forbidden, publish.StatusCode);
    }

    [Fact]
    public async Task Admin_saves_and_reads_ai_settings_through_the_api()
    {
        using var save = await PutAuthorized("/api/admin/ai/settings",
            new { baseUrl = "http://ollama:11434", modelId = "llama3.1", enabled = true }, UserRole.Admin);
        Assert.Equal(HttpStatusCode.OK, save.StatusCode);
        var saved = (await save.Content.ReadFromJsonAsync<JsonObject>())!;
        Assert.Equal("http://ollama:11434", (string)saved["baseUrl"]!);
        Assert.False((bool)saved["apiKeyConfigured"]!);

        using var read = await GetAuthorized("/api/admin/ai/settings", UserRole.Admin);
        Assert.Equal(HttpStatusCode.OK, read.StatusCode);
        var body = (await read.Content.ReadFromJsonAsync<JsonObject>())!;
        Assert.Equal("http://ollama:11434", (string)body["baseUrl"]!);
        Assert.Equal("llama3.1", (string)body["modelId"]!);
        Assert.True((bool)body["enabled"]!);
    }

    [Fact]
    public async Task Invalid_save_returns_problem_details_and_preserves_previous_settings()
    {
        using var first = await PutAuthorized("/api/admin/ai/settings",
            new { baseUrl = "http://ollama:11434", modelId = "llama3.1", enabled = true }, UserRole.Admin);
        Assert.Equal(HttpStatusCode.OK, first.StatusCode);

        using var invalid = await PutAuthorized("/api/admin/ai/settings",
            new { baseUrl = "not-a-url", modelId = "llama3.1", enabled = true }, UserRole.Admin);
        Assert.Equal(HttpStatusCode.BadRequest, invalid.StatusCode);
        Assert.Equal("application/problem+json", invalid.Content.Headers.ContentType?.MediaType);
        var problem = (await invalid.Content.ReadFromJsonAsync<JsonObject>())!;
        Assert.Equal("invalid_ai_settings", (string)problem["code"]!);

        using var read = await GetAuthorized("/api/admin/ai/settings", UserRole.Admin);
        var body = (await read.Content.ReadFromJsonAsync<JsonObject>())!;
        Assert.Equal("http://ollama:11434", (string)body["baseUrl"]!);
    }

    private Task<HttpResponseMessage> GetAuthorized(string path, UserRole role)
    {
        var request = new HttpRequestMessage(HttpMethod.Get, path);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", CreateToken(role));
        return _client.SendAsync(request);
    }

    private Task<HttpResponseMessage> PutAuthorized(string path, object payload, UserRole role)
    {
        var request = new HttpRequestMessage(HttpMethod.Put, path)
        {
            Content = JsonContent.Create(payload)
        };
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", CreateToken(role));
        return _client.SendAsync(request);
    }

    private static string CreateToken(UserRole role)
    {
        var now = DateTimeOffset.UtcNow;
        var descriptor = new SecurityTokenDescriptor
        {
            Issuer = Issuer,
            Audience = Audience,
            NotBefore = now.UtcDateTime,
            Expires = now.AddHours(1).UtcDateTime,
            Subject = new ClaimsIdentity([
                new Claim(ClaimTypes.Name, $"admin-api-{role}"),
                new Claim(ClaimTypes.Role, role.ToString())
            ]),
            SigningCredentials = new SigningCredentials(
                new SymmetricSecurityKey(Encoding.UTF8.GetBytes(Secret)),
                SecurityAlgorithms.HmacSha256)
        };

        return new JsonWebTokenHandler().CreateToken(descriptor);
    }

    private sealed class AdminAiApiFactory : WebApplicationFactory<Program>
    {
        private readonly Dictionary<string, string?> _previousEnvironment;

        public AdminAiApiFactory(string connectionString)
        {
            var environment = new Dictionary<string, string?>
            {
                ["DATABASE__CONNECTIONSTRING"] = connectionString,
                ["RABBITMQ__HOST"] = "localhost",
                ["RABBITMQ__PORT"] = "5672",
                ["RABBITMQ__USER"] = "guest",
                ["RABBITMQ__PASSWORD"] = "guest",
                ["RABBITMQ__EXCHANGE"] = "test-exchange",
                ["JWT__SECRET"] = Secret,
                ["JWT__ISSUER"] = Issuer,
                ["JWT__AUDIENCE"] = Audience,
                ["JWT__EXPIRYMINUTES"] = "480",
                ["AUTH__PASSWORDWORKFACTOR"] = "4",
                ["THREATFOX__APIKEY"] = "test-api-key",
                ["ADMIN__USERNAME"] = "admin-api-admin",
                ["ADMIN__PASSWORD"] = "Admin-test-password!",
                ["LOGGING__MINIMUMLEVEL"] = "Information",
                ["ENCRYPTION__ROOTKEY"] = "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
                ["ENCRYPTION__KEYVERSION"] = "1"
            };

            _previousEnvironment = environment.Keys.ToDictionary(key => key, Environment.GetEnvironmentVariable);
            foreach (var (key, value) in environment)
            {
                Environment.SetEnvironmentVariable(key, value);
            }
        }

        protected override void ConfigureWebHost(IWebHostBuilder builder) => builder.UseEnvironment("Testing");

        protected override void Dispose(bool disposing)
        {
            base.Dispose(disposing);
            foreach (var (key, value) in _previousEnvironment)
            {
                Environment.SetEnvironmentVariable(key, value);
            }
        }
    }
}

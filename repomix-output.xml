<file path="src/ThreatIntelligence.Infrastructure/Fetches/FetchGuardEvaluator.cs">
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Domain.Entities;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Fetches;

/// <summary>
/// Shared guard math used by both trigger-time reservation and consume-time rechecks so the two
/// paths cannot diverge. The current job is excluded from the active/cooldown lookups.
/// </summary>
public static class FetchGuardEvaluator
{
    public static async Task<FetchReservationRejection?> GetRejectionAsync(
        ThreatIntelligenceDbContext context,
        Provider? provider,
        Guid? currentJobId,
        FetchMode mode,
        DateTime nowUtc,
        CancellationToken cancellationToken)
    {
        if (provider is null)
        {
            return FetchReservationRejection.ProviderNotFound;
        }

        if (!Supports(provider, mode))
        {
            return FetchReservationRejection.UnsupportedMode;
        }

        if (!provider.IsEnabled)
        {
            return FetchReservationRejection.Disabled;
        }

        if (await context.FetchHistory.AnyAsync(
                h => h.ProviderId == provider.Id && h.JobId != currentJobId &&
                    (h.Status == FetchStatus.Queued || h.Status == FetchStatus.Running), cancellationToken))
        {
            return FetchReservationRejection.ActiveFetch;
        }

        var cooldown = Cooldown(provider, mode);
        if (cooldown is null)
        {
            return null;
        }

        var latest = await context.FetchHistory
            .Where(h => h.ProviderId == provider.Id && h.Mode == mode && h.JobId != currentJobId)
            .OrderByDescending(h => h.StartedAt)
            .Select(h => (DateTime?)h.StartedAt)
            .FirstOrDefaultAsync(cancellationToken);
        return latest.HasValue && nowUtc - latest.Value < cooldown.Value
            ? FetchReservationRejection.Cooldown
            : null;
    }

    public static bool Supports(Provider provider, FetchMode mode) => provider.HasMode(mode);

    private static TimeSpan? Cooldown(Provider provider, FetchMode mode) => provider.CooldownFor(mode);
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Fetches/FetchJobConsumer.cs">
using MassTransit;
using Microsoft.Extensions.Logging;
using ThreatIntelligence.Application.Fetches;

namespace ThreatIntelligence.Infrastructure.Fetches;

public sealed class FetchJobConsumer(
    IFetchLifecycle fetchLifecycle,
    IProviderFetchExecutor executor,
    ILogger<FetchJobConsumer> logger) : IConsumer<FetchJob>
{
    public async Task Consume(ConsumeContext<FetchJob> context)
    {
        var job = context.Message;
        if (!await fetchLifecycle.TryStartAsync(job, context.GetRetryAttempt() > 0, context.CancellationToken))
        {
            logger.LogInformation("Skipping obsolete fetch job {JobId} for provider {ProviderId}", job.JobId, job.ProviderId);
            return;
        }

        try
        {
            var result = await executor.ExecuteAsync(job, context.CancellationToken);
            await fetchLifecycle.SucceedAsync(job, result.RecordsAdded, result.RecordsUpdated, context.CancellationToken);
        }
        catch (Exception exception)
        {
            var attempt = context.GetRetryAttempt();
            var classified = FetchErrorClassifier.Classify(exception);
            if (classified is TerminalFetchException)
            {
                logger.LogError(
                    exception,
                    "Fetch job {JobId} for provider {ProviderId} mode {Mode} hit a terminal failure on attempt {Attempt}",
                    job.JobId,
                    job.ProviderId,
                    job.Mode,
                    attempt + 1);
                await fetchLifecycle.FailAsync(job, classified.Message, context.CancellationToken);
                return;
            }

            if (attempt >= 3)
            {
                logger.LogError(
                    exception,
                    "Fetch job {JobId} for provider {ProviderId} mode {Mode} exhausted retries at attempt {Attempt}",
                    job.JobId,
                    job.ProviderId,
                    job.Mode,
                    attempt);
                await fetchLifecycle.FailAsync(job, classified.Message, context.CancellationToken);
            }
            else
            {
                logger.LogWarning(
                    exception,
                    "Fetch job {JobId} for provider {ProviderId} mode {Mode} hit a transient failure on attempt {Attempt}; will retry",
                    job.JobId,
                    job.ProviderId,
                    job.Mode,
                    attempt);
            }

            throw classified;
        }
    }
}

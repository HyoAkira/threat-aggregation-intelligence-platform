<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/ThreatFoxExportClient.cs">
using System.Diagnostics;
using System.Net;
using System.Text;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Infrastructure.Configuration;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Streams ThreatFox JSON exports. Recent mode maps to the combined <c>recent.json</c> file;
/// full mode maps to <c>full.json.zip</c>. The API key lives only in the constructed URL for
/// the upstream request and is never placed into log or exception output.
/// </summary>
public sealed class ThreatFoxExportClient : IThreatFoxExportClient
{
    public const string DefaultBaseUrl = "https://threatfox-api.abuse.ch";

    private const string RecentExportFileName = "recent.json";
    private const string FullExportFileName = "full.json.zip";

    private readonly HttpClient _httpClient;
    private readonly string? _legacyApiKey;
    private readonly string _baseUrl;
    private readonly ILogger<ThreatFoxExportClient> _logger;

    public ThreatFoxExportClient(
        HttpClient httpClient,
        ThreatFoxOptions options,
        string baseUrl = DefaultBaseUrl,
        ILogger<ThreatFoxExportClient>? logger = null)
    {
        _httpClient = httpClient;
        _legacyApiKey = options.ApiKey;
        _baseUrl = baseUrl;
        _logger = logger ?? NullLogger<ThreatFoxExportClient>.Instance;

        if (_httpClient.DefaultRequestHeaders.UserAgent.Count > 0)
        {
            return;
        }

        _httpClient.DefaultRequestHeaders.UserAgent.ParseAdd("ThreatIntelligence.Worker/1.0");
    }

    public Task<ThreatFoxExportStream> FetchRecentAsync(CancellationToken cancellationToken)
        => FetchAsync(RecentExportFileName, _legacyApiKey, cancellationToken);

    public Task<ThreatFoxExportStream> FetchFullAsync(CancellationToken cancellationToken)
        => FetchAsync(FullExportFileName, _legacyApiKey, cancellationToken);

    public Task<ThreatFoxExportStream> FetchRecentAsync(string? apiKey, CancellationToken cancellationToken)
        => FetchAsync(RecentExportFileName, apiKey, cancellationToken);

    public Task<ThreatFoxExportStream> FetchFullAsync(string? apiKey, CancellationToken cancellationToken)
        => FetchAsync(FullExportFileName, apiKey, cancellationToken);

    /// <summary>The deterministic export URI for a file name; visible for tests.</summary>
    internal Uri BuildExportUri(string fileName, string? apiKey = null)
    {
        var keySegment = string.IsNullOrWhiteSpace(apiKey) ? string.Empty : $"{apiKey}/";
        return new Uri($"{_baseUrl.TrimEnd('/')}/v2/files/exports/{keySegment}{fileName}");
    }

    private async Task<ThreatFoxExportStream> FetchAsync(string fileName, string? apiKey, CancellationToken cancellationToken)
    {
        using var request = new HttpRequestMessage(HttpMethod.Get, BuildExportUri(fileName, apiKey));

        _logger.LogInformation("ThreatFox export request starting FileName={FileName}", fileName);

        var stopwatch = Stopwatch.StartNew();
        var response = await _httpClient
            .SendAsync(request, HttpCompletionOption.ResponseHeadersRead, cancellationToken)
            .ConfigureAwait(false);
        stopwatch.Stop();

        if (!response.IsSuccessStatusCode)
        {
            var payloadPrefix = await ReadDiagnosticPrefixAsync(response, cancellationToken).ConfigureAwait(false);
            _logger.LogError(
                "ThreatFox export request failed FileName={FileName} StatusCode={StatusCode} ElapsedMs={ElapsedMs} PayloadPrefix={PayloadPrefix}",
                fileName,
                (int)response.StatusCode,
                stopwatch.ElapsedMilliseconds,
                payloadPrefix);

            // 5xx/network failures classify as retryable transport failures via FetchErrorClassifier;
            // 429/401/403 and other 4xx classify as terminal. No URL or key in the message.
            throw response.StatusCode >= HttpStatusCode.InternalServerError
                ? new ProviderFetchHttpException(response.StatusCode, "ThreatFox export request failed.")
                : new ProviderFetchHttpException(response.StatusCode, "ThreatFox export request was rejected.");
        }

        _logger.LogInformation(
            "ThreatFox export response received FileName={FileName} StatusCode={StatusCode} ContentType={ContentType} ContentLength={ContentLength} ElapsedMs={ElapsedMs}",
            fileName,
            (int)response.StatusCode,
            response.Content.Headers.ContentType?.ToString(),
            response.Content.Headers.ContentLength,
            stopwatch.ElapsedMilliseconds);

        var content = await response.Content
            .ReadAsStreamAsync(cancellationToken)
            .ConfigureAwait(false);

        return new ThreatFoxExportStream(fileName, content);
    }

    private static async Task<string> ReadDiagnosticPrefixAsync(
        HttpResponseMessage response,
        CancellationToken cancellationToken)
    {
        try
        {
            await using var body = await response.Content
                .ReadAsStreamAsync(cancellationToken)
                .ConfigureAwait(false);

            var buffer = new byte[512];
            var read = await body.ReadAsync(buffer, cancellationToken).ConfigureAwait(false);
            if (read == 0)
            {
                return "<empty body>";
            }

            var text = Encoding.UTF8.GetString(buffer, 0, read).Replace('\r', ' ').Replace('\n', ' ').Trim();
            return text.Length > 0 ? text : "<non-text body>";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return "<unreadable body>";
        }
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/ThreatFoxFetchExecutor.cs">
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;
using ThreatIntelligence.Application.BatchWriter;
using ThreatIntelligence.Application.Abstractions.Secrets;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Application.ProviderRecords;
using ThreatIntelligence.Domain.Enums;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

public sealed class ThreatFoxFetchExecutor(
    IThreatFoxExportClient client,
    ThreatFoxRecentParser recentParser,
    ThreatFoxFullParser fullParser,
    ProviderRecordValidator validator,
    IIocBatchWriter batchWriter,
    ILogger<ThreatFoxFetchExecutor>? logger = null,
    IProviderCredentialResolver? credentialResolver = null) : IProviderFetchExecutor
{
    private readonly ILogger<ThreatFoxFetchExecutor> _logger =
        logger ?? NullLogger<ThreatFoxFetchExecutor>.Instance;

    public async Task<FetchExecutionResult> ExecuteAsync(FetchJob job, CancellationToken cancellationToken)
    {
        if (job.ProviderId != ThreatFoxRecordMapper.ThreatFoxProviderId)
        {
            throw new TerminalFetchException(
                $"ThreatFox executor only supports provider {ThreatFoxRecordMapper.ThreatFoxProviderId}, got {job.ProviderId}.");
        }

        _logger.LogInformation(
            "ThreatFox fetch execution starting JobId={JobId} ProviderId={ProviderId} Mode={Mode}",
            job.JobId,
            job.ProviderId,
            job.Mode);

        var credential = credentialResolver is null
            ? null
            : await credentialResolver.ResolveAsync(job.ProviderId, cancellationToken).ConfigureAwait(false);

        var records = job.Mode switch
        {
            FetchMode.Recent => await FetchRecentAsync(credential?.Value, credentialResolver is not null, cancellationToken).ConfigureAwait(false),
            FetchMode.Full => await FetchFullAsync(credential?.Value, credentialResolver is not null, cancellationToken).ConfigureAwait(false),
            _ => throw new TerminalFetchException($"ThreatFox executor does not support mode {job.Mode}.")
        };

        _logger.LogInformation(
            "ThreatFox parsed and validated {RecordCount} record(s) JobId={JobId} Mode={Mode}; applying batch",
            records.Count,
            job.JobId,
            job.Mode);

        var result = await batchWriter.ApplyAsync(records, job.ProviderId, cancellationToken).ConfigureAwait(false);

        _logger.LogInformation(
            "ThreatFox fetch execution completed JobId={JobId} Mode={Mode} RecordsAdded={RecordsAdded} RecordsUpdated={RecordsUpdated}",
            job.JobId,
            job.Mode,
            result.Added,
            result.Updated);

        return new FetchExecutionResult(result.Added, result.Updated);
    }

    private async Task<List<NormalizedProviderRecord>> FetchRecentAsync(string? apiKey, bool dynamicCredential, CancellationToken ct)
    {
        _logger.LogInformation("Fetching ThreatFox recent export");

        ThreatFoxExportStream stream;
        try
        {
            stream = dynamicCredential
                ? await client.FetchRecentAsync(apiKey, ct).ConfigureAwait(false)
                : await client.FetchRecentAsync(ct).ConfigureAwait(false);
        }
        catch (ProviderFetchHttpException ex)
        {
            _logger.LogError(
                ex,
                "ThreatFox recent export request failed StatusCode={StatusCode}",
                (int)ex.StatusCode);
            throw new TerminalFetchException("ThreatFox recent export request failed.", ex);
        }

        var records = new List<NormalizedProviderRecord>();
        try
        {
            await ParseAndValidateAsync(recentParser.ParseAsync(stream.Content, ct), records, "Recent", ct)
                .ConfigureAwait(false);
        }
        finally
        {
            await stream.Content.DisposeAsync().ConfigureAwait(false);
        }

        return records;
    }

    private async Task<List<NormalizedProviderRecord>> FetchFullAsync(string? apiKey, bool dynamicCredential, CancellationToken ct)
    {
        ThreatFoxExportStream stream;
        try
        {
            stream = dynamicCredential
                ? await client.FetchFullAsync(apiKey, ct).ConfigureAwait(false)
                : await client.FetchFullAsync(ct).ConfigureAwait(false);
        }
        catch (ProviderFetchHttpException ex)
        {
            _logger.LogError(
                ex,
                "ThreatFox full export request failed StatusCode={StatusCode}",
                (int)ex.StatusCode);
            throw new TerminalFetchException("ThreatFox full export request failed.", ex);
        }

        var records = new List<NormalizedProviderRecord>();
        try
        {
            await ParseAndValidateAsync(fullParser.ParseAsync(stream.Content, ct), records, "Full", ct)
                .ConfigureAwait(false);
        }
        finally
        {
            await stream.Content.DisposeAsync().ConfigureAwait(false);
        }

        return records;
    }

    private async Task ParseAndValidateAsync(
        IAsyncEnumerable<ProviderRecordInput> source,
        List<NormalizedProviderRecord> records,
        string sourceLabel,
        CancellationToken ct)
    {
        var recordIndex = 0;
        var accepted = 0;
        var rejected = 0;
        try
        {
            await foreach (var recordInput in source.ConfigureAwait(false))
            {
                ct.ThrowIfCancellationRequested();
                recordIndex++;

                var validation = validator.Validate(recordInput, recordIndex);
                if (!validation.IsValid)
                {
                    var failure = validation.Failure!;
                    _logger.LogWarning(
                        "ThreatFox record skipped Source={Source} RecordIndex={RecordIndex} ProviderRecordId={ProviderRecordId} Field={Field} Code={Code} Message={Message}",
                        sourceLabel,
                        failure.RecordIndex,
                        recordInput.ProviderRecordId,
                        failure.Field,
                        failure.Code,
                        failure.Message);
                    rejected++;
                    continue;
                }

                records.Add(validation.Normalized!);
                accepted++;
            }
        }
        catch (ThreatFoxRecordParseException ex)
        {
            _logger.LogError(
                ex,
                "ThreatFox feed record parse failure Source={Source} RecordIndex={RecordIndex} Field={Field} Reason={Reason}",
                sourceLabel,
                ex.RecordIndex,
                ex.Field,
                ex.Reason);
            throw new TerminalFetchException(
                $"ThreatFox feed record parse failure at index {ex.RecordIndex}: {ex.Message}", ex);
        }
        catch (ThreatFoxFeedFormatException ex)
        {
            _logger.LogError(
                ex,
                "ThreatFox feed format failure Source={Source} PayloadPrefix={PayloadPrefix}",
                sourceLabel,
                ex.PayloadPrefix);
            throw new TerminalFetchException($"ThreatFox feed format failure: {ex.Message}", ex);
        }
        catch (ThreatFoxArchiveException ex)
        {
            _logger.LogError(ex, "ThreatFox archive failure Source={Source}", sourceLabel);
            throw new TerminalFetchException($"ThreatFox archive failure: {ex.Message}", ex);
        }

        _logger.LogInformation(
            "ThreatFox source processed Source={Source} RecordsParsed={RecordsParsed} RecordsAccepted={RecordsAccepted} RecordsRejected={RecordsRejected}",
            sourceLabel,
            recordIndex,
            accepted,
            rejected);
    }
}

        Assert.NotNull(group);
        Assert.Equal(seed.Id, group!.Id);
        Assert.Equal("url", group.IocType);
        Assert.Equal("evil.example", group.UrlHost);
        Assert.Equal("evil.example", group.ParentDomain);

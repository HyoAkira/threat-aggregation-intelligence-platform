import { useEffect, useState } from 'react'
import { useQuery, useQueryClient } from '@tanstack/react-query'
import type { IocChatSettings } from '../lib/adminSchemas'
import {
  ApiError,
  getIocChatSettings,
  putAdminCredential,
  putIocChatSettings,
} from '../lib/apiClient'
import { adminIocChatSettingsKey } from '../lib/queryKeys'
import { focusRingClass } from './AppShell'
import { ErrorState, LoadingState } from './uiStates'

const chatKeyIdentity = 'IocChat.OpenAICompatible.ServerApiKey'

type Draft = { baseUrl: string; modelId: string; enabled: boolean }

type CredentialFeedback = {
  kind: 'success' | 'error'
  message: string
}

function toDraft(settings: IocChatSettings): Draft {
  return {
    baseUrl: settings.baseUrl ?? '',
    modelId: settings.modelId ?? '',
    enabled: settings.enabled,
  }
}

function validate(draft: Draft): { baseUrl?: string; modelId?: string } {
  const errors: { baseUrl?: string; modelId?: string } = {}
  if (draft.enabled && !draft.baseUrl.trim())
    errors.baseUrl = 'A Base URL is required while IOC chat is enabled.'
  if (draft.enabled && !draft.modelId.trim())
    errors.modelId = 'A model ID is required while IOC chat is enabled.'
  if (draft.baseUrl.trim().length > 2048)
    errors.baseUrl = 'The Base URL must be at most 2048 characters.'
  if (draft.modelId.trim().length > 200)
    errors.modelId = 'The model ID must be at most 200 characters.'
  if (draft.baseUrl.trim()) {
    try {
      const url = new URL(draft.baseUrl.trim())
      if (url.protocol !== 'http:' && url.protocol !== 'https:')
        throw new Error()
    } catch {
      errors.baseUrl = 'The Base URL must be an absolute HTTP or HTTPS URL.'
    }
  }
  return errors
}

export function AdminIocChatSettings() {
  const queryClient = useQueryClient()
  const settingsQuery = useQuery({
    queryKey: adminIocChatSettingsKey(),
    queryFn: ({ signal }) => getIocChatSettings(signal),
  })
  const [draft, setDraft] = useState<Draft | null>(null)
  const [errors, setErrors] = useState<{ baseUrl?: string; modelId?: string }>(
    {},
  )
  const [key, setKey] = useState('')
  const [feedback, setFeedback] = useState<CredentialFeedback | null>(null)
  const [saving, setSaving] = useState(false)

  useEffect(() => {
    if (settingsQuery.data && !draft) setDraft(toDraft(settingsQuery.data))
  }, [settingsQuery.data, draft])

  if (settingsQuery.isPending)
    return <LoadingState label="Loading IOC chat settings…" />
  if (settingsQuery.isError || !draft) {
    return (
      <ErrorState
        title="Failed to load IOC chat settings"
        message={
          settingsQuery.error instanceof ApiError
            ? settingsQuery.error.message
            : undefined
        }
        onRetry={() => void settingsQuery.refetch()}
      />
    )
  }

  const saveSettings = async () => {
    const nextErrors = validate(draft)
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length) return
    setSaving(true)
    setFeedback(null)
    try {
      const saved = await putIocChatSettings({
        baseUrl: draft.baseUrl.trim() || null,
        modelId: draft.modelId.trim() || null,
        enabled: draft.enabled,
      })
      setDraft(toDraft(saved))
      setFeedback({
        kind: 'success',
        message: 'IOC chat connection settings saved.',
      })
      await queryClient.invalidateQueries({
        queryKey: adminIocChatSettingsKey(),
      })
    } catch (error) {
      setFeedback({
        kind: 'error',
        message:
          error instanceof ApiError
            ? error.message
            : 'Save failed. Your draft was retained.',
      })
    } finally {
      setSaving(false)
    }
  }

  const saveKey = async () => {
    if (!key.trim()) {
      setFeedback({ kind: 'error', message: 'Enter an API key before saving.' })
      return
    }
    setSaving(true)
    setFeedback(null)
    try {
      await putAdminCredential(chatKeyIdentity, key)
      setKey('')
      setFeedback({ kind: 'success', message: 'IOC chat API key configured.' })
      await queryClient.invalidateQueries({
        queryKey: adminIocChatSettingsKey(),
      })
    } catch (error) {
      setFeedback({
        kind: 'error',
        message:
          error instanceof ApiError
            ? error.message
            : 'Could not save the IOC chat API key.',
      })
    } finally {
      setSaving(false)
    }
  }

  return (
    <section
      aria-labelledby="ioc-chat-settings-heading"
      className="mt-4 rounded border border-outline-variant bg-surface-container-lowest p-4"
    >
      <h3
        id="ioc-chat-settings-heading"
        className="font-semibold text-on-surface"
      >
        IOC chat model
      </h3>
      <p className="mt-1 text-sm text-on-surface-variant">
        Requires an OpenAI-compatible model endpoint that supports tool calls.
        This configuration and credential are independent from AI analysis.
      </p>
      <div className="mt-4 grid gap-4">
        <label className="grid gap-1 text-sm">
          Base URL
          <input
            value={draft.baseUrl}
            onChange={(event) =>
              setDraft({ ...draft, baseUrl: event.target.value })
            }
            aria-invalid={Boolean(errors.baseUrl)}
            className="rounded border border-outline-variant bg-surface-container-low px-3 py-2"
          />
          {errors.baseUrl ? (
            <span role="alert" className="text-error">
              {errors.baseUrl}
            </span>
          ) : null}
        </label>
        <label className="grid gap-1 text-sm">
          Model ID
          <input
            value={draft.modelId}
            onChange={(event) =>
              setDraft({ ...draft, modelId: event.target.value })
            }
            aria-invalid={Boolean(errors.modelId)}
            className="rounded border border-outline-variant bg-surface-container-low px-3 py-2"
          />
          {errors.modelId ? (
            <span role="alert" className="text-error">
              {errors.modelId}
            </span>
          ) : null}
        </label>
        <label className="flex items-center gap-2 text-sm">
          <input
            type="checkbox"
            checked={draft.enabled}
            onChange={(event) =>
              setDraft({ ...draft, enabled: event.target.checked })
            }
          />
          Enable anonymous IOC chat
        </label>
      </div>
      <button
        type="button"
        disabled={saving}
        onClick={() => void saveSettings()}
        className={`mt-4 rounded bg-primary px-3 py-2 text-sm font-semibold text-on-primary disabled:opacity-50 ${focusRingClass}`}
      >
        {saving ? 'Saving…' : 'Save chat settings'}
      </button>
      <div className="mt-5 border-t border-outline-variant pt-4">
        <p className="text-sm">
          API key status:{' '}
          <strong>
            {settingsQuery.data.apiKeyConfigured
              ? 'Configured'
              : 'Not configured'}
          </strong>
        </p>
        <label className="mt-2 grid gap-1 text-sm">
          Replace API key
          <input
            type="password"
            autoComplete="new-password"
            value={key}
            onChange={(event) => setKey(event.target.value)}
            className="rounded border border-outline-variant bg-surface-container-low px-3 py-2"
          />
        </label>
        <button
          type="button"
          disabled={saving}
          onClick={() => void saveKey()}
          className={`mt-2 rounded border border-outline-variant px-3 py-2 text-sm font-semibold disabled:opacity-50 ${focusRingClass}`}
        >
          Set API key
        </button>
      </div>
      {feedback ? (
        <div
          role={feedback.kind === 'error' ? 'alert' : 'status'}
          aria-live="polite"
          className={`mt-3 rounded border px-3 py-2 text-sm ${
            feedback.kind === 'error'
              ? 'border-error/40 bg-error-container text-on-error-container'
              : 'border-tertiary/40 bg-tertiary/10 text-tertiary'
          }`}
        >
          {feedback.message}
        </div>
      ) : null}
    </section>
  )
}
</file>

<file path="frontend/src/components/IocAiReport.test.tsx">
/**
 * @jest-environment jsdom
 */
import {
  cleanup,
  fireEvent,
  render,
  screen,
  waitFor,
} from '@testing-library/react'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import { IocAiReport } from './IocAiReport'
import { renderSafeMarkdown } from './safeMarkdown'
import { AiReportProblemError, streamIocAiReport } from '../lib/aiReportClient'
import { useAuthStore } from '../lib/authStore'
import { createSessionStorageStub, makeSession } from '../test/fixtures'

jest.mock('../lib/aiReportClient', () => {
  const actual = jest.requireActual('../lib/aiReportClient')
  return { ...actual, streamIocAiReport: jest.fn() }
})

const streamMock = streamIocAiReport as jest.MockedFunction<
  typeof streamIocAiReport
>

const validReport = [
  '## Yönetici Özeti',
  'Bu bir **doğrulanmış** gözlemdir [S1].',
  '## Teknik Analiz',
  'Analiz.',
].join('\n')

function renderReport() {
  return render(
    <QueryClientProvider client={new QueryClient()}>
      <IocAiReport iocId={7} />
    </QueryClientProvider>,
  )
}

describe('IocAiReport', () => {
  beforeEach(() => {
    ;(globalThis as { sessionStorage?: Storage }).sessionStorage =
      createSessionStorageStub() as Storage
    useAuthStore.setState({ session: null })
    jest.resetAllMocks()
    jest.restoreAllMocks()
  })

  afterEach(cleanup)

  it('allows anonymous visitors to generate a report', async () => {
    streamMock.mockImplementation(async (_iocId, handlers) => {
      handlers.onComplete?.({
        type: 'complete',
        report: validReport,
        modelId: 'public-model',
        policyVersion: 1,
        generatedAtUtc: '2026-09-17T10:00:00Z',
      })
    })

    renderReport()

    fireEvent.click(screen.getByText('Generate report'))
    await screen.findByText('Instruction version: 1')
    expect(screen.queryByText('Model: public-model')).toBeNull()
    expect(streamMock).toHaveBeenCalledWith(
      7,
      expect.anything(),
      expect.anything(),
    )
  })

  it('starts streaming immediately when opened from the AI workspace action', async () => {
    streamMock.mockImplementation(async (_iocId, handlers) => {
      handlers.onDelta?.('Streaming now')
    })

    render(
      <QueryClientProvider client={new QueryClient()}>
        <IocAiReport iocId={7} autoGenerate onClose={jest.fn()} />
      </QueryClientProvider>,
    )

    await screen.findByRole('status')
    expect(screen.queryByText('Streaming now')).toBeNull()
    expect(screen.getByRole('progressbar').getAttribute('aria-valuenow')).toBe(
      '0',
    )
    expect(streamMock).toHaveBeenCalledWith(
      7,
      expect.anything(),
      expect.anything(),
    )
    expect(screen.getByLabelText('Close AI report')).toBeTruthy()
    expect(
      screen.queryByRole('button', { name: 'Cancel report generation' }),
    ).toBeNull()
  })

  it('streams provisional plain text, then renders the validated report with metadata and download', async () => {
    useAuthStore.setState({ session: makeSession({ role: 'User' }) })
    streamMock.mockImplementation(async (_iocId, handlers) => {
      handlers.onMeta?.({
        type: 'meta',
        iocId: 7,
        modelId: 'test-model',
        policyVersion: 3,
        sourceCount: 2,
        omittedSourceCount: 0,
      })
      handlers.onDelta?.('## Yönetici Özeti')
      handlers.onDelta?.('Şu an yarı yazı…')
      handlers.onComplete?.({
        type: 'complete',
        report: validReport,
        modelId: 'test-model',
        policyVersion: 3,
        generatedAtUtc: '2026-09-17T10:00:00Z',
      })
    })

    renderReport()

    fireEvent.click(screen.getByText('Generate report'))

    expect(screen.getByText(/Instruction version: 3/)).toBeTruthy()
    expect(screen.queryByText('Model: test-model')).toBeNull()
    expect(screen.getByText('doğrulanmış')).toBeTruthy()
    expect(screen.getByText('Download Markdown')).toBeTruthy()
    expect(screen.queryByRole('button', { name: 'Generate report' })).toBeNull()
  })

  it('shows an accessible failure state and a retry button after a failed stream', async () => {
    useAuthStore.setState({ session: makeSession() })
    streamMock.mockRejectedValue(
      new AiReportProblemError(
        409,
        'ai_disabled',
        'AI report unavailable',
        'AI report generation is disabled.',
        'cid-9',
      ),
    )

    renderReport()
    fireEvent.click(screen.getByText('Generate report'))

    const alert = await screen.findByRole('alert')
    expect(alert.textContent).toContain('AI report generation is disabled.')
    expect(alert.textContent).toContain('cid-9')
    expect(screen.getByText('Retry report')).toBeTruthy()
  })

  it('keeps partial output out of the UI while streaming and closes to cancel', async () => {
    useAuthStore.setState({ session: makeSession() })
    const onClose = jest.fn()
    streamMock.mockImplementation(async (_iocId, handlers, signal) => {
      handlers.onMeta?.({
        type: 'meta',
        iocId: 7,
        modelId: 'test-model',
        policyVersion: 1,
        sourceCount: 1,
        omittedSourceCount: 0,
      })
      handlers.onDelta?.('<script>alert(1)</script> [x](javascript:alert(1))')
      await new Promise((resolve, reject) => {
        const timer = setTimeout(resolve, 5000)
        signal?.addEventListener('abort', () => {
          clearTimeout(timer)
          reject(new DOMException('The operation was aborted.', 'AbortError'))
        })
      })
      handlers.onDelta?.('more')
      handlers.onComplete?.({
        type: 'complete',
        report: validReport,
        modelId: 'test-model',
        policyVersion: 1,
        generatedAtUtc: '2026-09-17T10:00:00Z',
      })
    })

    render(
      <QueryClientProvider client={new QueryClient()}>
        <IocAiReport iocId={7} onClose={onClose} />
      </QueryClientProvider>,
    )
    fireEvent.click(screen.getByText('Generate report'))

    await screen.findByRole('status')
    expect(screen.queryByText(/alert\(1\)/)).toBeNull()
    // No streamed content is mounted, so no script element can exist in the document.
    expect(document.querySelector('script')).toBeNull()

    fireEvent.click(screen.getByLabelText('Close AI report'))
    expect(onClose).toHaveBeenCalled()
    // Closing aborts the stream; the component returns to idle if the parent keeps it mounted.
    await screen.findByText(/No report has been generated/i)
  })

  it('renders a malicious markdown fixture without an executable link or HTML node', () => {
    const malicious = [
      '## Feragatname <img src=x onerror=alert(1)>',
      '- [click](javascript:alert(1)) <script>alert(1)</script>',
    ].join('\n')

    render(<div>{renderSafeMarkdown(malicious)}</div>)

    expect(document.querySelector('a')).toBeNull()
    expect(document.querySelector('script')).toBeNull()
    expect(document.querySelector('img')).toBeNull()
    // The link text survives as plain text with its target stripped.
    expect(screen.getByText(/click/)).toBeTruthy()
  })

  it('downloads the completed report as a local markdown file', async () => {
    useAuthStore.setState({ session: makeSession() })
    streamMock.mockImplementation(async (_iocId, handlers) => {
      handlers.onComplete?.({
        type: 'complete',
        report: validReport,
        modelId: 'test-model',
        policyVersion: 3,
        generatedAtUtc: '2026-09-17T10:00:00Z',
      })
    })

    const createObjectURL = jest.fn(() => 'blob:download')
    const revokeObjectURL = jest.fn()
    const originalCreateObjectURL = URL.createObjectURL
    const originalRevokeObjectURL = URL.revokeObjectURL
    URL.createObjectURL = createObjectURL
    URL.revokeObjectURL = revokeObjectURL
    const clickedAnchors: { download: string | null }[] = []
    const originalClick = HTMLAnchorElement.prototype.click
    HTMLAnchorElement.prototype.click = function click() {
      clickedAnchors.push(this)
    }

    try {
      renderReport()
      fireEvent.click(screen.getByText('Generate report'))
      fireEvent.click(await screen.findByText('Download Markdown'))

      expect(createObjectURL).toHaveBeenCalled()
      expect(clickedAnchors[0]?.download).toBe('ioc-report-7.md')
      expect(revokeObjectURL).toHaveBeenCalledWith('blob:download')
    } finally {
      URL.createObjectURL = originalCreateObjectURL
      URL.revokeObjectURL = originalRevokeObjectURL
      HTMLAnchorElement.prototype.click = originalClick
    }
  })

  it('converts the completed report to a local PDF file', async () => {
    useAuthStore.setState({ session: makeSession() })
    streamMock.mockImplementation(async (_iocId, handlers) => {
      handlers.onComplete?.({
        type: 'complete',
        report: validReport,
        modelId: 'test-model',
        policyVersion: 3,
        generatedAtUtc: '2026-09-17T10:00:00Z',
      })
    })

    const fetchMock = jest.fn().mockResolvedValue({
      ok: true,
      status: 200,
      blob: async () => new Blob(['%PDF-1.7'], { type: 'application/pdf' }),
    })
    globalThis.fetch = fetchMock
    const createObjectURL = jest.fn(() => 'blob:pdf-download')
    const revokeObjectURL = jest.fn()
    const originalCreateObjectURL = URL.createObjectURL
    const originalRevokeObjectURL = URL.revokeObjectURL
    URL.createObjectURL = createObjectURL
    URL.revokeObjectURL = revokeObjectURL
    const clickedAnchors: { download: string | null }[] = []
    const originalClick = HTMLAnchorElement.prototype.click
    HTMLAnchorElement.prototype.click = function click() {
      clickedAnchors.push(this)
    }

    try {
      renderReport()
      fireEvent.click(screen.getByText('Generate report'))
      fireEvent.click(await screen.findByText('Download PDF'))

      await waitFor(() =>
        expect(fetchMock).toHaveBeenCalledWith(
          '/api/iocs/7/ai/reports/pdf',
          expect.objectContaining({
            method: 'POST',
            body: JSON.stringify({
              report: validReport,
              generatedAtUtc: '2026-09-17T10:00:00Z',
            }),
          }),
        ),
      )
      expect(clickedAnchors.at(-1)?.download).toBe('ioc-report-7.pdf')
      expect(revokeObjectURL).toHaveBeenCalledWith('blob:pdf-download')
    } finally {
      URL.createObjectURL = originalCreateObjectURL
      URL.revokeObjectURL = originalRevokeObjectURL
      HTMLAnchorElement.prototype.click = originalClick
    }
  })

  it('discards the report when the panel remounts (no persisted state)', async () => {
    useAuthStore.setState({ session: makeSession() })
    streamMock.mockImplementation(async (_iocId, handlers) => {
      handlers.onComplete?.({
        type: 'complete',
        report: validReport,
        modelId: 'test-model',
        policyVersion: 3,
        generatedAtUtc: '2026-09-17T10:00:00Z',
      })
    })

    const first = renderReport()
    fireEvent.click(screen.getByText('Generate report'))
    await screen.findByText(/Instruction version: 3/)
    first.unmount()

    const second = render(
      <QueryClientProvider client={new QueryClient()}>
        <IocAiReport iocId={7} />
      </QueryClientProvider>,
    )
    expect(second.container.textContent).toContain(
      'No report has been generated',
    )
    second.unmount()
  })
})

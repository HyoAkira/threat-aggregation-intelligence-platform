<file path="src/ThreatIntelligence.Infrastructure/Fetches/FetchGuard.cs">
using System.Data;
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Domain.Entities;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Fetches;

public sealed class FetchGuard(
    IDbContextFactory<ThreatIntelligenceDbContext> contextFactory,
    TimeProvider timeProvider) : IFetchGuard
{
    public async Task<FetchReservation> ReserveAsync(
        int providerId,
        FetchTrigger trigger,
        FetchMode? mode,
        CancellationToken cancellationToken)
    {
        await using var context = await contextFactory.CreateDbContextAsync(cancellationToken);
        await using var transaction = await context.Database.BeginTransactionAsync(IsolationLevel.Serializable, cancellationToken);
        // Locking the provider row serializes all reservations for that provider, including scheduler ticks.
        var provider = await context.Providers
            .FromSqlInterpolated($"SELECT * FROM providers WITH (UPDLOCK, HOLDLOCK) WHERE id = {providerId}")
            .SingleOrDefaultAsync(cancellationToken);
        if (provider is null)
        {
            return FetchReservation.Reject(FetchReservationRejection.ProviderNotFound);
        }

        var resolvedMode = mode ?? provider.DefaultMode;
        var rejection = await FetchGuardEvaluator.GetRejectionAsync(
            context, provider, null, resolvedMode, timeProvider.GetUtcNow().UtcDateTime, cancellationToken);
        if (rejection is not null)
        {
            return FetchReservation.Reject(rejection.Value);
        }

        var now = timeProvider.GetUtcNow().UtcDateTime;
        var jobId = Guid.NewGuid();
        context.FetchHistory.Add(new FetchHistory(jobId, providerId, trigger, resolvedMode, FetchStatus.Queued, now));
        await context.SaveChangesAsync(cancellationToken);
        await transaction.CommitAsync(cancellationToken);
        return FetchReservation.Allow(jobId, resolvedMode);
    }

    public async Task<bool> CanExecuteAsync(FetchJob job, CancellationToken cancellationToken)
    {
        await using var context = await contextFactory.CreateDbContextAsync(cancellationToken);
        var history = await context.FetchHistory.SingleOrDefaultAsync(h => h.JobId == job.JobId, cancellationToken);
        if (history is null || history.Status is FetchStatus.Success or FetchStatus.Failed)
        {
            return false;
        }

        var provider = await context.Providers.SingleOrDefaultAsync(p => p.Id == job.ProviderId, cancellationToken);
        return await FetchGuardEvaluator.GetRejectionAsync(
            context, provider, job.JobId, job.Mode, timeProvider.GetUtcNow().UtcDateTime, cancellationToken) is null;
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Fetches/FetchGuardEvaluator.cs">
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Domain.Entities;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Fetches;

/// <summary>
/// Shared guard math used by both trigger-time reservation and consume-time rechecks so the two
/// paths cannot diverge. The current job is excluded from the active/cooldown lookups.
/// </summary>
public static class FetchGuardEvaluator
{
    public static async Task<FetchReservationRejection?> GetRejectionAsync(
        ThreatIntelligenceDbContext context,
        Provider? provider,
        Guid? currentJobId,
        FetchMode mode,
        DateTime nowUtc,
        CancellationToken cancellationToken)
    {
        if (provider is null)
        {
            return FetchReservationRejection.ProviderNotFound;
        }

        if (!Supports(provider, mode))
        {
            return FetchReservationRejection.UnsupportedMode;
        }

        if (!provider.IsEnabled)
        {
            return FetchReservationRejection.Disabled;
        }

        if (await context.FetchHistory.AnyAsync(
                h => h.ProviderId == provider.Id && h.JobId != currentJobId &&
                    (h.Status == FetchStatus.Queued || h.Status == FetchStatus.Running), cancellationToken))
        {
            return FetchReservationRejection.ActiveFetch;
        }

        var cooldown = Cooldown(provider, mode);
        if (cooldown is null)
        {
            return null;
        }

        var latest = await context.FetchHistory
            .Where(h => h.ProviderId == provider.Id && h.Mode == mode && h.JobId != currentJobId)
            .OrderByDescending(h => h.StartedAt)
            .Select(h => (DateTime?)h.StartedAt)
            .FirstOrDefaultAsync(cancellationToken);
        return latest.HasValue && nowUtc - latest.Value < cooldown.Value
            ? FetchReservationRejection.Cooldown
            : null;
    }

    public static bool Supports(Provider provider, FetchMode mode) => provider.HasMode(mode);

    private static TimeSpan? Cooldown(Provider provider, FetchMode mode) => provider.CooldownFor(mode);
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Fetches/FetchJobConsumer.cs">
using MassTransit;
using Microsoft.Extensions.Logging;
using ThreatIntelligence.Application.Fetches;

namespace ThreatIntelligence.Infrastructure.Fetches;

public sealed class FetchJobConsumer(
    IFetchLifecycle fetchLifecycle,
    IProviderFetchExecutor executor,
    ILogger<FetchJobConsumer> logger) : IConsumer<FetchJob>
{
    public async Task Consume(ConsumeContext<FetchJob> context)
    {
        var job = context.Message;
        if (!await fetchLifecycle.TryStartAsync(job, context.GetRetryAttempt() > 0, context.CancellationToken))
        {
            logger.LogInformation("Skipping obsolete fetch job {JobId} for provider {ProviderId}", job.JobId, job.ProviderId);
            return;
        }

        try
        {
            var result = await executor.ExecuteAsync(job, context.CancellationToken);
            await fetchLifecycle.SucceedAsync(job, result.RecordsAdded, result.RecordsUpdated, context.CancellationToken);
        }
        catch (Exception exception)
        {
            var attempt = context.GetRetryAttempt();
            var classified = FetchErrorClassifier.Classify(exception);
            if (classified is TerminalFetchException)
            {
                logger.LogError(
                    exception,
                    "Fetch job {JobId} for provider {ProviderId} mode {Mode} hit a terminal failure on attempt {Attempt}",
                    job.JobId,
                    job.ProviderId,
                    job.Mode,
                    attempt + 1);
                await fetchLifecycle.FailAsync(job, classified.Message, context.CancellationToken);
                return;
            }

            if (attempt >= 3)
            {
                logger.LogError(
                    exception,
                    "Fetch job {JobId} for provider {ProviderId} mode {Mode} exhausted retries at attempt {Attempt}",
                    job.JobId,
                    job.ProviderId,
                    job.Mode,
                    attempt);
                await fetchLifecycle.FailAsync(job, classified.Message, context.CancellationToken);
            }
            else
            {
                logger.LogWarning(
                    exception,
                    "Fetch job {JobId} for provider {ProviderId} mode {Mode} hit a transient failure on attempt {Attempt}; will retry",
                    job.JobId,
                    job.ProviderId,
                    job.Mode,
                    attempt);
            }

            throw classified;
        }
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Fetches/FetchLifecycle.cs">
using System.Data;
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Admin;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Fetches;

public sealed class FetchLifecycle(
    IDbContextFactory<ThreatIntelligenceDbContext> contextFactory,
    TimeProvider timeProvider,
    IFetchLifecycleEventSink? eventSink = null) : IFetchLifecycle
{
    private readonly IFetchLifecycleEventSink _eventSink = eventSink ?? NullFetchLifecycleEventSink.Instance;

    public async Task<bool> TryStartAsync(FetchJob job, bool isRetry, CancellationToken cancellationToken)
    {
        await using var context = await contextFactory.CreateDbContextAsync(cancellationToken);
        await using var transaction = await context.Database.BeginTransactionAsync(IsolationLevel.Serializable, cancellationToken);
        var history = await context.FetchHistory.SingleOrDefaultAsync(h => h.JobId == job.JobId, cancellationToken);
        if (history is null || history.Status is FetchStatus.Success or FetchStatus.Failed)
        {
            Emit(FetchLifecycleEventNames.GuardRejection, job, reason: "obsolete");
            return false;
        }

        // A message must match the reservation it claims, including on retries/redelivery.
        if (history.ProviderId != job.ProviderId || history.Trigger != job.Trigger || history.Mode != job.Mode)
        {
            Emit(FetchLifecycleEventNames.GuardRejection, job, reason: "reservation_mismatch");
            return false;
        }

        var provider = await context.Providers.SingleOrDefaultAsync(p => p.Id == job.ProviderId, cancellationToken);
        var rejection = await FetchGuardEvaluator.GetRejectionAsync(
            context, provider, job.JobId, job.Mode, timeProvider.GetUtcNow().UtcDateTime, cancellationToken);
        if (rejection is not null)
        {
            Emit(FetchLifecycleEventNames.GuardRejection, job, reason: rejection.Value.ToString());
            return false;
        }

        if (isRetry)
        {
            Emit(FetchLifecycleEventNames.Retry, job, reason: $"attempt {job.Attempt}");
        }

        // A retry or a crash-resume reuses the already-claimed Running row, but only after
        // the current provider guards have passed.
        if (history.Status == FetchStatus.Running)
        {
            return true;
        }

        history.Start();
        provider!.MarkFetchRunning();
        await context.SaveChangesAsync(cancellationToken);
        await transaction.CommitAsync(cancellationToken);
        Emit(FetchLifecycleEventNames.ExecutionStart, job);
        return true;
    }

    public Task SucceedAsync(FetchJob job, int recordsAdded, int recordsUpdated, CancellationToken cancellationToken) =>
        CompleteAsync(
            job,
            history => history.Succeed(recordsAdded, recordsUpdated, timeProvider.GetUtcNow().UtcDateTime),
            success: true,
            recordsAdded,
            recordsUpdated,
            cancellationToken);

    public Task FailAsync(FetchJob job, string errorDetail, CancellationToken cancellationToken) =>
        CompleteAsync(
            job,
            history => history.Fail(errorDetail, timeProvider.GetUtcNow().UtcDateTime),
            success: false,
            0,
            0,
            cancellationToken,
            LogRedactor.Redact(errorDetail));

    private async Task CompleteAsync(
        FetchJob job,
        Action<ThreatIntelligence.Domain.Entities.FetchHistory> transition,
        bool success,
        int recordsAdded,
        int recordsUpdated,
        CancellationToken cancellationToken,
        string? reason = null)
    {
        await using var context = await contextFactory.CreateDbContextAsync(cancellationToken);
        var history = await context.FetchHistory.SingleOrDefaultAsync(h => h.JobId == job.JobId, cancellationToken);
        if (history is null || history.Status is FetchStatus.Success or FetchStatus.Failed)
        {
            return;
        }

        var provider = await context.Providers.SingleAsync(p => p.Id == history.ProviderId, cancellationToken);
        var startedAt = history.StartedAt;
        transition(history);
        if (success)
        {
            provider.MarkFetchSucceeded(
                timeProvider.GetUtcNow().UtcDateTime,
                updateNextFetchTime: history.Trigger != FetchTrigger.Scheduled);
        }
        else
        {
            provider.MarkFetchFailed();
        }

        await context.SaveChangesAsync(cancellationToken);
        var durationMs = (long)(timeProvider.GetUtcNow().UtcDateTime - startedAt).TotalMilliseconds;
        Emit(
            success ? FetchLifecycleEventNames.Success : FetchLifecycleEventNames.TerminalFailure,
            job,
            durationMs,
            recordsAdded,
            recordsUpdated,
            reason);
    }

    private void Emit(
        string eventName,
        FetchJob job,
        long? durationMs = null,
        int? recordsAdded = null,
        int? recordsUpdated = null,
        string? reason = null) =>
        _eventSink.Emit(new FetchLifecycleEvent(
            eventName,
            job.JobId,
            job.ProviderId,
            FetchTokens.Mode(job.Mode),
            FetchTokens.Trigger(job.Trigger),
            job.CorrelationId,
            durationMs,
            recordsAdded,
            recordsUpdated,
            reason));
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/Persistence/Seeding/AdminSeeder.cs">
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.Abstractions.Authentication;
using ThreatIntelligence.Domain.Entities;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Configuration;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.Infrastructure.Persistence.Seeding;

/// <summary>
/// Seeds the first administrator from configuration. Consumes an <see cref="IPasswordHasher"/>
/// abstraction (production KDF is provided by E04) and never logs or persists the plaintext
/// password. Idempotent, non-destructive, and converges under concurrent startup via the
/// unique username index.
/// </summary>
public sealed class AdminSeeder(
    ThreatIntelligenceDbContext dbContext,
    AdminSeedOptions options,
    TimeProvider timeProvider,
    IPasswordHasher hasher)
{
    public async Task SeedAsync(CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(options.Username) || string.IsNullOrWhiteSpace(options.Password))
        {
            throw new InvalidOperationException(
                "First-admin seeding requires non-empty ADMIN__USERNAME and ADMIN__PASSWORD.");
        }

        if (options.Username.Length > 50)
        {
            throw new InvalidOperationException("ADMIN__USERNAME must not exceed 50 characters.");
        }

        var existing = await dbContext.Users
            .SingleOrDefaultAsync(u => u.Username == options.Username, cancellationToken);

        if (existing is not null)
        {
            if (existing.Role == UserRole.Admin)
            {
                return;
            }

            throw new InvalidOperationException(
                $"Configuration conflict: username '{options.Username}' already exists and is not an Admin.");
        }

        var passwordHash = hasher.HashPassword(options.Password);
        dbContext.Users.Add(new User(
            options.Username,
            passwordHash,
            UserRole.Admin,
            timeProvider.GetUtcNow().UtcDateTime));

        try
        {
            await dbContext.SaveChangesAsync(cancellationToken);
        }
        catch (DbUpdateException)
        {
            var winner = await dbContext.Users
                .AsNoTracking()
                .SingleOrDefaultAsync(u => u.Username == options.Username, cancellationToken);

            if (winner is not null && winner.Role == UserRole.Admin)
            {
                return;
            }

            throw;
        }
    }
}
</file>


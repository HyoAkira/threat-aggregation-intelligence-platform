@import 'tailwindcss';

/*
 * Design tokens for the Threat Intelligence console: the approved Material-style
 * tonal palette and the Geist / JetBrains Mono type pairing from the approved
 * Stitch cyber-intelligence design system. Pages opt into these
 * utilities; they are additive so existing utilities keep working unchanged.
 */
@theme {
  --color-primary: #003ec7;
  --color-on-primary: #ffffff;
  --color-primary-container: #0052ff;
  --color-on-primary-container: #dfe3ff;
  --color-primary-fixed: #dde1ff;
  --color-primary-fixed-dim: #b7c4ff;
  --color-on-primary-fixed: #001452;
  --color-on-primary-fixed-variant: #0038b6;
  --color-inverse-primary: #b7c4ff;

  --color-secondary: #5b5e67;
  --color-on-secondary: #ffffff;
  --color-secondary-container: #dfe2ed;
  --color-on-secondary-container: #61646d;
  --color-secondary-fixed: #dfe2ed;
  --color-secondary-fixed-dim: #c3c6d0;
  --color-on-secondary-fixed: #181c23;

  --color-tertiary: #005b33;
  --color-on-tertiary: #ffffff;
  --color-tertiary-container: #007644;
  --color-on-tertiary-container: #77ffaf;
  --color-tertiary-fixed: #72fcac;
  --color-tertiary-fixed-dim: #53df92;
  --color-on-tertiary-fixed: #00210f;

  --color-error: #ba1a1a;
  --color-on-error: #ffffff;
  --color-error-container: #ffdad6;
  --color-on-error-container: #93000a;

  --color-warning: #b45309;
  --color-warning-container: #fef3c7;
  --color-on-warning-container: #78350f;

  --color-background: #f8f9ff;
  --color-on-background: #0b1c30;
  --color-surface: #f8f9ff;
  --color-surface-dim: #cbdbf5;
  --color-surface-bright: #f8f9ff;
  --color-surface-tint: #004ced;
  --color-surface-variant: #d3e4fe;
  --color-surface-container-lowest: #ffffff;
  --color-surface-container-low: #eff4ff;
  --color-surface-container: #e5eeff;
  --color-surface-container-high: #dce9ff;
  --color-surface-container-highest: #d3e4fe;
  --color-on-surface: #0b1c30;
  --color-on-surface-variant: #434656;
  --color-outline: #737688;
  --color-outline-variant: #c3c5d9;
  --color-inverse-surface: #213145;
  --color-inverse-on-surface: #eaf1ff;

  --font-sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
}

/* Google Material Symbols icon font (loaded per-route where icons are used).
 * Layered below utilities so size/color utilities can override it. */
@layer components {
  .material-symbols-outlined {
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
    -webkit-font-smoothing: antialiased;
    user-select: none;
  }
}

* {
  box-sizing: border-box;
}

html,
body,
#app {
  min-height: 100%;
}

body {
  margin: 0;
  background-color: var(--color-surface);
  color: var(--color-on-surface);
}

/* Data-view scroll containers stay flush with the dense instrument aesthetic. */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-thumb {
  background: var(--color-outline-variant);
  border-radius: 9999px;
}

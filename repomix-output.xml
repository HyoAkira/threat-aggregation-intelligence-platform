<file path="frontend/src/components/TagAutocompleteInput.tsx">
import { useQuery } from '@tanstack/react-query'
import { getIocTagCatalog } from '../lib/apiClient'
import { iocTagCatalogKey } from '../lib/queryKeys'

type TagAutocompleteInputProps = {
  id: string
  value: string
  onChange: (value: string) => void
  className: string
  multiple?: boolean
}

/**
 * Native datalist autocomplete keeps tag entry accessible and dependency-free.
 * A failed catalog request intentionally leaves the ordinary text input usable.
 */
export function TagAutocompleteInput({
  id,
  value,
  onChange,
  className,
  multiple = false,
}: TagAutocompleteInputProps) {
  const rawTokens = value.split(',').map((token) => token.trim())
  const hasTrailingSeparator = value.trimEnd().endsWith(',')
  const committedTags = rawTokens
    .filter(Boolean)
    .slice(0, hasTrailingSeparator ? undefined : -1)
  const draft = hasTrailingSeparator ? '' : (rawTokens.at(-1) ?? '')
  const query = multiple ? draft : value.trim()
  const suggestions = useQuery({
    queryKey: iocTagCatalogKey(query),
    queryFn: ({ signal }) => getIocTagCatalog({ q: query, limit: 8 }, signal),
    enabled: query.length > 0,
    staleTime: 30_000,
  })

  return (
    <div className="mt-1 space-y-1.5">
      {multiple && committedTags.length > 0 ? (
        <div className="flex flex-wrap gap-1" aria-label="Selected tags">
          {committedTags.map((tag) => (
            <span
              key={tag}
              className="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2 py-1 font-mono text-[10px] text-primary"
            >
              {tag}
              <button
                type="button"
                aria-label={`Remove ${tag}`}
                className="rounded-full px-0.5 font-semibold hover:bg-primary/15"
                onClick={() =>
                  onChange(
                    [...committedTags.filter((item) => item !== tag), draft]
                      .filter(Boolean)
                      .join(', '),
                  )
                }
              >
                ×
              </button>
            </span>
          ))}
        </div>
      ) : null}
      <input
        id={id}
        type="text"
        value={multiple ? draft : value}
        list={`${id}-options`}
        onChange={(event) => {
          if (!multiple) {
            onChange(event.target.value)
            return
          }
          const next = event.target.value
          const nextTokens = next.split(',').map((token) => token.trim())
          const nextValue = [...committedTags, ...nextTokens]
            .filter(Boolean)
            .join(', ')
          const selectedSuggestion = suggestions.data?.some(
            (tag) => tag.name.toLowerCase() === next.trim().toLowerCase(),
          )
          onChange(
            next.endsWith(',') || selectedSuggestion
              ? `${nextValue}, `
              : nextValue,
          )
        }}
        className={className}
      />
      <datalist id={`${id}-options`}>
        {(suggestions.data ?? []).map((tag) => (
          <option
            key={tag.name}
            value={tag.name}
            label={`${tag.usageCount} uses`}
          />
        ))}
      </datalist>
    </div>
  )
}
</file>

<file path="frontend/src/components/uiStates.tsx">
import type { ReactNode } from 'react'

const stateBoxClass =
  'my-6 rounded border border-outline-variant bg-surface-container-low px-4 py-3 text-on-surface'

/** Explicit loading state, announced politely to assistive technology. */
export function LoadingState({ label = 'Loading…' }: { label?: string }) {
  return (
    <div role="status" aria-live="polite" className={stateBoxClass}>
      <p className="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-on-surface-variant">
        <span
          aria-hidden="true"
          className="h-3 w-3 animate-spin rounded-full border-2 border-outline-variant border-t-primary"
        />
        {label}
      </p>
    </div>
  )
}

/** Explicit empty state for valid responses that contain no data. */
export function EmptyState({
  title,
  message,
  action,
}: {
  title: string
  message?: string
  action?: ReactNode
}) {
  return (
    <div role="status" className={stateBoxClass}>
      <p className="font-semibold text-on-surface">{title}</p>
      {message ? (
        <p className="mt-1 text-sm text-on-surface-variant">{message}</p>
      ) : null}
      {action ? <div className="mt-3">{action}</div> : null}
    </div>
  )
}

/**
 * Error state for request failures. Distinguishes forbidden access (403, which is
 * never retried) from unexpected failures, which are retryable and show the
 * request's correlation ID for support and log correlation.
 */
export function ErrorState({
  title,
  message,
  correlationId,
  onRetry,
  retryLabel = 'Retry',
}: {
  title: string
  message?: string
  correlationId?: string
  onRetry?: () => void
  retryLabel?: string
}) {
  return (
    <div
      role="alert"
      className="my-6 rounded border border-error/40 bg-error-container px-4 py-3 text-on-error-container"
    >
      <p className="font-semibold">{title}</p>
      {message ? <p className="mt-1 text-sm">{message}</p> : null}
      {correlationId ? (
        <p className="mt-1 font-mono text-xs uppercase tracking-wider">
          Reference: {correlationId}
        </p>
      ) : null}
      {onRetry ? (
        <button
          type="button"
          onClick={onRetry}
          className="mt-3 rounded bg-error px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-on-error focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {retryLabel}
        </button>
      ) : null}
    </div>
  )
}

/** Forbidden state shown for 403 responses; never retried automatically. */
export function ForbiddenState({ message }: { message?: string }) {
  return (
    <ErrorState
      title="Access denied"
      message={message ?? 'You do not have permission to view this content.'}
    />
  )
}
</file>


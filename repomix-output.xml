  modelId: 'ioc-model',
  enabled: false,
  apiKeyConfigured: false,
}

function renderSettings() {
  return render(
    <QueryClientProvider
      client={
        new QueryClient({ defaultOptions: { queries: { retry: false } } })
      }
    >
      <AdminIocChatSettings />
    </QueryClientProvider>,
  )
}

describe('AdminIocChatSettings', () => {
  beforeEach(() => {
    jest.resetAllMocks()
    getMock.mockResolvedValue(fixture)
  })

  afterEach(cleanup)

  it('validates enabled settings accessibly without sending invalid data', async () => {
    renderSettings()
    const enabled = await screen.findByRole('checkbox', {
      name: /Enable anonymous IOC chat/i,
    })
    fireEvent.click(enabled)
    fireEvent.change(screen.getByLabelText('Base URL'), {
      target: { value: 'not-a-url' },
    })
    fireEvent.click(screen.getByRole('button', { name: 'Save chat settings' }))

    expect(await screen.findByRole('alert')).toBeTruthy()
    expect(putSettingsMock).not.toHaveBeenCalled()
  })

  it('retains the draft after save failure and clears plaintext key after success', async () => {
    putSettingsMock.mockRejectedValue(
      new ApiError(503, 'failure', 'Save failed'),
    )
    renderSettings()
    const baseUrl = await screen.findByLabelText('Base URL')
    fireEvent.change(baseUrl, { target: { value: 'http://changed:11434' } })
    fireEvent.click(screen.getByRole('button', { name: 'Save chat settings' }))
    await screen.findByText('Save failed')
    expect(screen.getByDisplayValue('http://changed:11434')).toBeTruthy()

    putKeyMock.mockResolvedValue({
      identity: 'IocChat.OpenAICompatible.ServerApiKey',
      configured: true,
      keyVersion: 1,
      updatedAt: '2026-09-18T00:00:00Z',
    })
    const key = screen.getByLabelText('Replace API key')
    fireEvent.change(key, { target: { value: 'secret-value' } })
    fireEvent.click(screen.getByRole('button', { name: 'Set API key' }))
    await waitFor(() =>
      expect(screen.queryByDisplayValue('secret-value')).toBeNull(),
    )
    expect(screen.queryByText('secret-value')).toBeNull()
    expect(screen.getByRole('status').textContent).toContain(
      'IOC chat API key configured.',
    )
  })

  it('shows an accessible error feedback when the API key save fails', async () => {
    putKeyMock.mockRejectedValue(
      new ApiError(503, 'failure', 'Could not save key'),
    )
    renderSettings()
    const key = await screen.findByLabelText('Replace API key')
    fireEvent.change(key, { target: { value: 'secret-value' } })
    fireEvent.click(screen.getByRole('button', { name: 'Set API key' }))

    expect((await screen.findByRole('alert')).textContent).toContain(
      'Could not save key',
    )
    expect(screen.getByDisplayValue('secret-value')).toBeTruthy()
  })
})

<file path="src/ThreatIntelligence.Application/Normalization/Ipv4Normalizer.cs">
using ThreatIntelligence.Domain.Enums;

namespace ThreatIntelligence.Application.Normalization;

public interface IIpv4Normalizer
{
    NormalizationOutput Normalize(string input);
}

public class Ipv4Normalizer : IIpv4Normalizer
{
    public NormalizationOutput Normalize(string input)
    {
        var trimmed = input.Trim();
        if (trimmed.Length == 0)
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.InvalidInput,
                ErrorMessages.InvalidInput);
        }

        var (addressPart, portText) = SplitPort(trimmed);

        if (!Ipv4Parser.TryCanonicalize(addressPart, out var canonical))
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.InvalidInput,
                ErrorMessages.InvalidInput);
        }

        if (portText is null)
        {
            return NormalizationOutput.Success(
                new NormalizationResult(IocType.Ipv4, canonical, null, null, null));
        }

        if (!PortParser.TryParse(portText, out var port))
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.InvalidIpv4Port,
                ErrorMessages.InvalidIpv4Port);
        }

        return NormalizationOutput.Success(
            new NormalizationResult(IocType.Ipv4, canonical, port, null, null));
    }

    private static (string address, string? port) SplitPort(string input)
    {
        var lastColon = input.LastIndexOf(':');
        if (lastColon < 0)
        {
            return (input, null);
        }

        return (input[..lastColon], input[(lastColon + 1)..]);
    }
}
</file>

<file path="src/ThreatIntelligence.Application/Normalization/Ipv4Parser.cs">
using System.Net;
using System.Net.Sockets;

namespace ThreatIntelligence.Application.Normalization;

internal static class Ipv4Parser
{
    public static bool TryCanonicalize(string address, out string canonical)
    {
        canonical = string.Empty;

        if (!ValidateOctets(address))
        {
            return false;
        }

        if (!IPAddress.TryParse(address, out var parsed) ||
            parsed.AddressFamily != AddressFamily.InterNetwork)
        {
            return false;
        }

        canonical = parsed.ToString();
        return true;
    }

    public static bool IsIpv4Shaped(string host)
    {
        if (host.Length == 0 || !host.Contains('.'))
        {
            return false;
        }

        foreach (var c in host)
        {
            if (!char.IsAsciiDigit(c) && c != '.')
            {
                return false;
            }
        }

        return true;
    }

    private static bool ValidateOctets(string address)
    {
        var span = address.AsSpan();
        var dotCount = 0;
        var segmentStart = 0;

        for (var i = 0; i <= span.Length; i++)
        {
            if (i == span.Length || span[i] == '.')
            {
                if (dotCount >= 3 && i < span.Length)
                {
                    return false;
                }

                var segment = span[segmentStart..i];
                if (segment.Length == 0 || segment.Length > 3)
                {
                    return false;
                }

                if (segment.Length > 1 && segment[0] == '0')
                {
                    return false;
                }

                for (var j = 0; j < segment.Length; j++)
                {
                    if (!char.IsAsciiDigit(segment[j]))
                    {
                        return false;
                    }
                }

                if (!int.TryParse(segment, out var value) || value > 255)
                {
                    return false;
                }

                segmentStart = i + 1;
                dotCount++;
            }
        }

        return dotCount == 4;
    }
}
</file>

<file path="src/ThreatIntelligence.Application/Normalization/Ipv6Normalizer.cs">
using ThreatIntelligence.Domain.Enums;

namespace ThreatIntelligence.Application.Normalization;

public interface IIpv6Normalizer
{
    NormalizationOutput Normalize(string input);
}

public class Ipv6Normalizer : IIpv6Normalizer
{
    public NormalizationOutput Normalize(string input)
    {
        var trimmed = input.Trim();
        if (trimmed.Length == 0)
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.InvalidInput,
                ErrorMessages.InvalidInput);
        }

        if (trimmed.StartsWith('['))
        {
            return NormalizeBracketed(trimmed);
        }

        if (trimmed.Contains('[') || trimmed.Contains(']'))
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.UnmatchedBrackets,
                ErrorMessages.UnmatchedBrackets);
        }

        return NormalizeBare(trimmed);
    }

    private NormalizationOutput NormalizeBracketed(string input)
    {
        var closeIndex = input.IndexOf(']');
        if (closeIndex < 0)
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.UnmatchedBrackets,
                ErrorMessages.UnmatchedBrackets);
        }

        var addressText = input[1..closeIndex];
        var rest = input[(closeIndex + 1)..];

        string? portText = null;
        if (rest.Length > 0)
        {
            if (!rest.StartsWith(':'))
            {
                return NormalizationOutput.Failure(
                    NormalizationErrorCode.UnmatchedBrackets,
                    ErrorMessages.UnmatchedBrackets);
            }

            portText = rest[1..];
        }

        if (!TryParseAddress(addressText, out var canonical))
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.InvalidIpv6,
                ErrorMessages.InvalidIpv6);
        }

        if (portText is null)
        {
            return NormalizationOutput.Success(
                new NormalizationResult(IocType.Ipv6, canonical, null, null, null));
        }

        if (!PortParser.TryParse(portText, out var port))
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.InvalidIpv6Port,
                ErrorMessages.InvalidIpv6Port);
        }

        return NormalizationOutput.Success(
            new NormalizationResult(IocType.Ipv6, canonical, port, null, null));
    }

    private NormalizationOutput NormalizeBare(string input)
    {
        if (!TryParseAddress(input, out var canonical))
        {
            return NormalizationOutput.Failure(
                NormalizationErrorCode.InvalidIpv6,
                ErrorMessages.InvalidIpv6);
        }

        return NormalizationOutput.Success(
            new NormalizationResult(IocType.Ipv6, canonical, null, null, null));
    }

    private static bool TryParseAddress(string text, out string canonical)
        => Ipv6Parser.TryCanonicalize(text, out canonical);
}
</file>


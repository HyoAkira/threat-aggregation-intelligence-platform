const getMock = getIocChatSettings as jest.MockedFunction<
  typeof getIocChatSettings
>
const putSettingsMock = putIocChatSettings as jest.MockedFunction<
  typeof putIocChatSettings
>
const putKeyMock = putAdminCredential as jest.MockedFunction<
  typeof putAdminCredential
>

const fixture = {

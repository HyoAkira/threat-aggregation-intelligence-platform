import { createFileRoute, redirect, useNavigate } from '@tanstack/react-router'
import { useState } from 'react'
import { z } from 'zod'
import { focusRingClass } from '../components/AppShell'
import { ErrorState } from '../components/uiStates'
import { ApiError, login } from '../lib/apiClient'
import { currentSession, startSession } from '../lib/authStore'
import { resolveLoginRedirect } from '../lib/loginRedirect'

const loginSearchSchema = z.object({
  redirect: z.coerce.string().optional(),
})

export const Route = createFileRoute('/login')({
  validateSearch: loginSearchSchema,
  beforeLoad: ({ search }) => {
    const session = currentSession()
    if (session)
      throw redirect({
        to: resolveLoginRedirect(
          search.redirect,
          session.role === 'Admin' ? '/admin' : '/search',
        ),
      })
  },
  component: LoginPage,
})

const inputClass = `w-full rounded-md border border-slate-400 px-3 py-2 text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-700`

function LoginPage() {
  const navigate = useNavigate()
  const redirectParam = Route.useSearch().redirect
  const [username, setUsername] = useState('')
  const [password, setPassword] = useState('')
  const [pending, setPending] = useState(false)
  const [error, setError] = useState<{
    message: string
    correlationId?: string
  } | null>(null)

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    if (pending) return
    if (username.trim() === '' || password === '') {
      setError({ message: 'Enter both a username and a password.' })
      return
    }
    setPending(true)
    setError(null)
    try {
      const response = await login(username.trim(), password)
      startSession(response)
      await navigate({
        to: resolveLoginRedirect(
          redirectParam,
          response.role === 'Admin' ? '/admin/providers' : '/search',
        ) as '/',
      })
    } catch (cause) {
      if (cause instanceof ApiError && cause.status === 401) {
        setError({ message: 'Invalid username or password.' })
      } else if (cause instanceof ApiError) {
        setError({
          message: cause.message,
          correlationId: cause.correlationId,
        })
      } else {
        setError({ message: 'Sign-in failed unexpectedly. Please try again.' })
      }
    } finally {
      setPending(false)
    }
  }

  return (
    <section aria-labelledby="login-heading" className="mx-auto max-w-md">
      <h1 id="login-heading" className="text-2xl font-bold text-slate-900">
        Sign in
      </h1>
      <p className="mt-2 text-sm text-slate-700">
        Sign in to reach your protected workflows. Searching and browsing
        indicators stays open without an account.
      </p>
      <form onSubmit={handleSubmit} className="mt-6 space-y-4" noValidate>
        <div>
          <label
            htmlFor="login-username"
            className="block text-sm font-medium text-slate-800"
          >
            Username
          </label>
          <input
            id="login-username"
            name="username"
            type="text"
            autoComplete="username"
            required
            value={username}
            onChange={(event) => setUsername(event.target.value)}
            className={`mt-1 ${inputClass}`}
          />
        </div>
        <div>
          <label
            htmlFor="login-password"
            className="block text-sm font-medium text-slate-800"
          >
            Password
          </label>
          <input
            id="login-password"
            name="password"
            type="password"
            autoComplete="current-password"
            required
            value={password}
            onChange={(event) => setPassword(event.target.value)}
            className={`mt-1 ${inputClass}`}
          />
        </div>
        {error ? (
          <ErrorState
            title="Sign-in failed"
            message={error.message}
            correlationId={error.correlationId}
          />
        ) : null}
        <button
          type="submit"
          disabled={pending}
          aria-busy={pending}
          className={`rounded-md bg-sky-800 px-4 py-2 font-medium text-white enabled:hover:bg-sky-900 disabled:cursor-wait disabled:opacity-60 ${focusRingClass}`}
        >
          {pending ? 'Signing in…' : 'Sign in'}
        </button>
      </form>
    </section>
  )
}
</file>

<file path="frontend/src/test/renderApp.tsx">
import { renderToString } from 'react-dom/server'
import {
  Outlet,
  RouterProvider,
  createMemoryHistory,
  createRootRoute,
  createRoute,
  createRouter,
} from '@tanstack/react-router'
import { routeTree } from '../routeTree.gen'
import { queryClient } from '../lib/queryClient'

/** What a load of one URL produced: a render, or a redirect to follow. */
export type RouteLoadResult =
  | { type: 'render'; router: ReturnType<typeof createRouter> }
  | { type: 'redirect'; to?: string; search?: unknown; href?: string }

/** Memory-history router over the real route tree. */
export function createAppRouter(path = '/'): ReturnType<typeof createRouter> {
  return createRouter({
    routeTree,
    history: createMemoryHistory({ initialEntries: [path] }),
  })
}

type LoadResult = {
  type?: string
  redirect?: { options?: { to?: string; search?: unknown; href?: string } }
}

/**
 * Loads one URL through the real router: `beforeLoad` guards run and any
 * redirect they throw is reported instead of being silently committed.
 */
export async function loadAppRoute(path: string): Promise<RouteLoadResult> {
  const router = createAppRouter(path)
  await router.load()
  const result = (router as unknown as { _serverResult?: LoadResult })
    ._serverResult
  if (result?.type === 'redirect') {
    return {
      type: 'redirect',
      to: result.redirect?.options?.to,
      search: result.redirect?.options?.search,
      href: result.redirect?.options?.href,
    }
  }
  return { type: 'render', router }
}

/**
 * Renders one URL of the real application route tree (the SPA root route with
 * its providers and shell, plus the matched route) to static markup, following
 * up to three redirects the way a browser follows a 3xx. Query results must be
 * seeded into the shared query cache beforehand; no network calls happen in the
 * Node test environment.
 */
export async function renderAppRoute(
  path: string,
  maxRedirects = 3,
): Promise<string> {
  let current = path
  for (let hop = 0; hop <= maxRedirects; hop++) {
    const result = await loadAppRoute(current)
    if (result.type === 'redirect') {
      if (!result.href)
        throw new Error(`Redirect from ${current} has no resolvable href.`)
      current = result.href
      continue
    }
    return renderToString(<RouterProvider router={result.router as never} />)
  }
  throw new Error(`Too many redirects while rendering ${path}.`)
}

/**
 * Renders an arbitrary element that needs router context (Link, useRouter)
 * inside a minimal throwaway router with memory history.
 */
export async function renderWithRouterContext(
  element: React.ReactElement,
): Promise<string> {
  const rootRoute = createRootRoute({
    component: () => (
      <div id="test-harness">
        {element}
        <Outlet />
      </div>
    ),
  })
  const indexRoute = createRoute({
    getParentRoute: () => rootRoute,
    path: '/',
    component: () => null,
  })
  const router = createRouter({
    routeTree: rootRoute.addChildren([indexRoute]),
    history: createMemoryHistory({ initialEntries: ['/'] }),
  })
  await router.load()
  return renderToString(<RouterProvider router={router as never} />)
}

/** Resets shared module state (query cache) between tests. */
export function resetClientState(): void {
  queryClient.clear()
}

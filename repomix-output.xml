import { expect, test } from '@playwright/test'
import type { Page } from '@playwright/test'

const urlGroup = {
  id: 7,
  iocValue: 'https://evil.example/x',
  iocType: 'url',
  urlHost: 'evil.example',
  parentDomain: 'evil.example',
  firstSeenUtc: '2026-01-01T08:00:00Z',

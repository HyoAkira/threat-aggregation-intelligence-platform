const focusRing =
  'rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'

const RECENT_PAGE_SIZE = 10
const SEARCH_PAGE_SIZE = 20

const QUICK_QUERIES = [
  '185.220.101.5',

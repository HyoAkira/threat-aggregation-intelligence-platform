<file path="src/ThreatIntelligence.Application/Admin/TimelineCalendar.cs">
namespace ThreatIntelligence.Application.Admin;

/// <summary>
/// Pure calendar arithmetic for the Admin timeline. Persisted instants stay UTC; only the
/// local-calendar projection and bucket starts cross into the requested timezone. DST correctness
/// comes from <see cref="TimeZoneInfo"/> conversion rather than fixed 24-hour offsets.
/// </summary>
public static class TimelineCalendar
{
    /// <summary>Maximum number of local calendar days a single timeline request may cover.</summary>
    public const int MaxLocalDays = 31;

    /// <summary>
    /// Local calendar dates touched by the half-open UTC interval <c>[fromUtc,toUtc)</c>. Because the
    /// interval is half-open, a <c>toUtc</c> that lands exactly on local midnight does not include
    /// that final date. Results are chronologically ascending and never empty for a valid range.
    /// </summary>
    public static IReadOnlyList<DateOnly> EnumerateLocalDates(
        DateTime fromUtc,
        DateTime toUtc,
        TimeZoneInfo timeZone)
    {
        var startDate = ToLocalDate(fromUtc, timeZone);
        var endInstantLocal = TimeZoneInfo.ConvertTimeFromUtc(toUtc, timeZone);
        var endDate = DateOnly.FromDateTime(endInstantLocal);
        if (endInstantLocal.TimeOfDay == TimeSpan.Zero)
        {
            endDate = endDate.AddDays(-1);
        }

        var dates = new List<DateOnly>();
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            dates.Add(date);
        }

        return dates;
    }

    /// <summary>Canonical UTC instant of local midnight for <paramref name="localDate"/>.</summary>
    public static DateTime LocalMidnightUtc(DateOnly localDate, TimeZoneInfo timeZone)
    {
        var local = DateTime.SpecifyKind(localDate.ToDateTime(TimeOnly.MinValue), DateTimeKind.Unspecified);
        return TimeZoneInfo.ConvertTimeToUtc(local, timeZone);
    }

    /// <summary>Local calendar date of a UTC instant in the requested timezone.</summary>
    public static DateOnly ToLocalDate(DateTime utcInstant, TimeZoneInfo timeZone)
    {
        var utc = utcInstant.Kind == DateTimeKind.Utc
            ? utcInstant
            : DateTime.SpecifyKind(utcInstant, DateTimeKind.Utc);
        return DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(utc, timeZone));
    }
}
</file>

<file path="src/ThreatIntelligence.Application/Admin/TimelineRequestValidator.cs">
using System.Globalization;
using ThreatIntelligence.Application.Abstractions.Time;

namespace ThreatIntelligence.Application.Admin;

/// <summary>Outcome of validating an Admin timeline request. When <see cref="IsValid"/> is false
/// the error fields carry the safe ProblemDetails code/detail the controller should return.</summary>
public sealed record TimelineRequestValidation(
    bool IsValid,
    DateTime FromUtc,
    DateTime ToUtc,
    TimeZoneInfo? TimeZone,
    string? ErrorCode,
    string? ErrorDetail);

/// <summary>
/// Validates the bounded UTC range and IANA timezone supplied to the Admin timeline endpoint
/// before any history query runs. The range is half-open <c>[from,to)</c> and capped at
/// <see cref="TimelineCalendar.MaxLocalDays"/> local calendar days in the requested timezone.
/// </summary>
public static class TimelineRequestValidator
{
    public const string InvalidRangeCode = "invalid_timeline_range";
    public const string InvalidTimeZoneCode = "invalid_timeline_timezone";
    public const string RangeTooLargeCode = "timeline_range_too_large";

    public static TimelineRequestValidation Validate(
        string? from,
        string? to,
        string? timeZoneId,
        ITimeZoneResolver timeZoneResolver)
    {
        if (!TryParseUtcInstant(from, out var fromUtc) || !TryParseUtcInstant(to, out var toUtc))
        {
            return Invalid(
                InvalidRangeCode,
                "The from and to values must be ISO-8601 UTC instants, for example 2026-09-14T00:00:00Z.");
        }

        if (!timeZoneResolver.TryResolve(timeZoneId, out var timeZone))
        {
            return Invalid(
                InvalidTimeZoneCode,
                "The timeZone value is not a recognized IANA timezone identifier.");
        }

        if (fromUtc >= toUtc)
        {
            return Invalid(
                InvalidRangeCode,
                "The from instant must be earlier than the to instant.");
        }

        if (TimelineCalendar.EnumerateLocalDates(fromUtc, toUtc, timeZone).Count > TimelineCalendar.MaxLocalDays)
        {
            return Invalid(
                RangeTooLargeCode,
                $"The requested range must not exceed {TimelineCalendar.MaxLocalDays} local calendar days.");
        }

        return new TimelineRequestValidation(true, fromUtc, toUtc, timeZone, null, null);
    }

    /// <summary>
    /// Parses an explicit UTC ISO-8601 instant. Offset-less values are rejected so a local-time
    /// string is never silently interpreted as UTC.
    /// </summary>
    private static bool TryParseUtcInstant(string? value, out DateTime result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmed = value.Trim();
        var hasUtcDesignator =
            trimmed.EndsWith("Z", StringComparison.OrdinalIgnoreCase)
            || trimmed.EndsWith("+00:00", StringComparison.Ordinal)
            || trimmed.EndsWith("+0000", StringComparison.Ordinal);

        if (!hasUtcDesignator
            || !DateTimeOffset.TryParse(
                trimmed,
                CultureInfo.InvariantCulture,
                DateTimeStyles.RoundtripKind,
                out var parsed)
            || parsed.Offset != TimeSpan.Zero)
        {
            return false;
        }

        result = parsed.UtcDateTime;
        return true;
    }

    private static TimelineRequestValidation Invalid(string code, string detail) =>
        new(false, default, default, null, code, detail);
}
</file>


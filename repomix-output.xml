<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/PrefixCapturingStream.cs">
namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Buffers up to the configured maximum bytes from the wrapped stream, exposes them as
/// <see cref="Prefix"/>, then replays them before continuing with the wrapped stream. Lets a feed
/// body be inspected for diagnostics without buffering the whole payload or requiring a seekable
/// stream. Not thread-safe; each parse attempt should get its own instance.
/// </summary>
internal sealed class PrefixCapturingStream(Stream inner, int maxPrefixBytes) : Stream
{
    private readonly MemoryStream _prefix = new();
    private bool _prefixComplete;

    /// <summary>The bytes read so far; valid after <see cref="CaptureAsync"/>.</summary>
    public ReadOnlyMemory<byte> Prefix => _prefix.GetBuffer().AsMemory(0, (int)_prefix.Length);

    /// <summary>Reads the prefix once. Safe to call repeatedly.</summary>
    public async ValueTask CaptureAsync(CancellationToken cancellationToken)
    {
        if (_prefixComplete)
        {
            return;
        }

        var buffer = new byte[Math.Min(4096, Math.Max(1, maxPrefixBytes))];
        while (_prefix.Length < maxPrefixBytes)
        {
            var remaining = maxPrefixBytes - (int)_prefix.Length;
            var read = await inner
                .ReadAsync(buffer.AsMemory(0, Math.Min(buffer.Length, remaining)), cancellationToken)
                .ConfigureAwait(false);
            if (read == 0)
            {
                break;
            }

            await _prefix.WriteAsync(buffer.AsMemory(0, read), cancellationToken).ConfigureAwait(false);
        }

        _prefixComplete = true;
        _prefix.Position = 0;
    }

    public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
    {
        await CaptureAsync(cancellationToken).ConfigureAwait(false);

        if (_prefix.Position < _prefix.Length)
        {
            var read = await _prefix.ReadAsync(buffer, cancellationToken).ConfigureAwait(false);
            if (read > 0)
            {
                return read;
            }
        }

        return await inner.ReadAsync(buffer, cancellationToken).ConfigureAwait(false);
    }

    public override int Read(byte[] buffer, int offset, int count)
    {
        CaptureAsync(CancellationToken.None).AsTask().GetAwaiter().GetResult();

        if (_prefix.Position < _prefix.Length)
        {
            var read = _prefix.Read(buffer, offset, count);
            if (read > 0)
            {
                return read;
            }
        }

        return inner.Read(buffer, offset, count);
    }

    public override bool CanRead => true;

    public override bool CanSeek => false;

    public override bool CanWrite => false;

    public override long Length => throw new NotSupportedException();

    public override long Position
    {
        get => throw new NotSupportedException();
        set => throw new NotSupportedException();
    }

    public override void Flush()
    {
    }

    public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();

    public override void SetLength(long value) => throw new NotSupportedException();

    public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _prefix.Dispose();
        }

        base.Dispose(disposing);
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/ThreatFoxFullParser.cs">
using System.IO.Compression;
using System.Runtime.CompilerServices;
using ThreatIntelligence.Application.ProviderRecords;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Streams the ThreatFox full <c>full.json.zip</c> export: locates the expected JSON entry by name,
/// enforces archive-bomb guards on entry count and declared uncompressed size, and parses the
/// contained JSON array without buffering the whole archive in memory.
/// </summary>
public sealed class ThreatFoxFullParser(ThreatFoxRecentParser recentParser)
{
    public const string EntryFileName = "full.json";
    public const int DefaultMaxEntries = 4;
    public const long DefaultMaxUncompressedBytes = 4L * 1024 * 1024 * 1024;

    private readonly int _maxEntries = DefaultMaxEntries;
    private readonly long _maxUncompressedBytes = DefaultMaxUncompressedBytes;

    public ThreatFoxFullParser(ThreatFoxRecentParser recentParser, int maxEntries, long maxUncompressedBytes)
        : this(recentParser)
    {
        if (maxEntries < 1)
        {
            throw new ArgumentOutOfRangeException(nameof(maxEntries), "maxEntries must be positive.");
        }

        if (maxUncompressedBytes < 1)
        {
            throw new ArgumentOutOfRangeException(nameof(maxUncompressedBytes), "maxUncompressedBytes must be positive.");
        }

        _maxEntries = maxEntries;
        _maxUncompressedBytes = maxUncompressedBytes;
    }

    public async IAsyncEnumerable<ProviderRecordInput> ParseAsync(
        Stream zipStream,
        [EnumeratorCancellation] CancellationToken cancellationToken)
    {
        using var archive = OpenArchive(zipStream);
        var entry = SelectEntry(archive);

        await using var entryStream = entry.Open();

        await foreach (var record in recentParser.ParseAsync(entryStream, cancellationToken))
        {
            yield return record;
        }
    }

    /// <summary>Opens the archive, mapping corrupt/truncated central-directory reads to a structured error.</summary>
    private static ZipArchive OpenArchive(Stream zipStream)
    {
        try
        {
            return new ZipArchive(zipStream, ZipArchiveMode.Read, leaveOpen: true);
        }
        catch (InvalidDataException ex)
        {
            throw new ThreatFoxArchiveException("Archive could not be read; it is corrupt or truncated.", ex);
        }
    }

    private ZipArchiveEntry SelectEntry(ZipArchive archive)
    {
        if (archive.Entries.Count == 0)
        {
            throw new ThreatFoxArchiveException("Archive does not contain any entries.");
        }

        if (archive.Entries.Count > _maxEntries)
        {
            throw new ThreatFoxArchiveException($"Archive contains {archive.Entries.Count} entries, exceeding the guard of {_maxEntries}.");
        }

        var entry = archive.Entries.FirstOrDefault(e =>
            string.Equals(e.Name, EntryFileName, StringComparison.OrdinalIgnoreCase));
        if (entry is null)
        {
            throw new ThreatFoxArchiveException($"Archive does not contain the expected '{EntryFileName}' entry.");
        }

        if (entry.Length > _maxUncompressedBytes)
        {
            throw new ThreatFoxArchiveException($"Archive entry declares {entry.Length} uncompressed bytes, exceeding the guard of {_maxUncompressedBytes}.");
        }

        return entry;
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/ThreatFoxProviderValidator.cs">
using ThreatIntelligence.Application.ProviderRecords;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// ThreatFox-specific provider validator on the E03 extension point. Fails closed when the record
/// is not a ThreatFox record and enforces ThreatFox payload rules (confidence 0-100) after E03
/// common validation succeeds.
/// </summary>
public sealed class ThreatFoxProviderValidator : IProviderValidator
{
    public const int ThreatFoxProviderId = 1;

    public int ProviderId => ThreatFoxProviderId;

    public ProviderRejection? Validate(ProviderRecordInput input)
    {
        if (input.ProviderId != ThreatFoxProviderId)
        {
            return new ProviderRejection(
                "provider",
                "ThreatFox validator only accepts records from the ThreatFox provider.");
        }

        if (input.Metadata is not null
            && input.Metadata.TryGetValue(ThreatFoxRecordMapper.ConfidenceLevelKey, out var confidenceValue)
            && confidenceValue is not null
            && confidenceValue is int confidenceLevel
            && confidenceLevel is < 0 or > 100)
        {
            return new ProviderRejection(
                ThreatFoxRecordMapper.ConfidenceLevelKey,
                "ThreatFox confidence level must be between 0 and 100.");
        }

        return null;
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/ThreatFoxUpsertFieldsMapper.cs">
using ThreatIntelligence.Application.Abstractions.Hashing;
using ThreatIntelligence.Application.BatchWriter;
using ThreatIntelligence.Application.ProviderRecords;
using ThreatIntelligence.Domain.Entities;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Maps a validated ThreatFox record into <see cref="IocUpsertFields"/> for the shared batch writer.
/// </summary>
public sealed class ThreatFoxUpsertFieldsMapper(IValueHasher hasher, TimeProvider timeProvider) : IIocUpsertFieldsMapper
{
    public IocUpsertFields Map(NormalizedProviderRecord record)
    {
        var metadata = record.Metadata;

        return new IocUpsertFields(
            ProviderRecordId: record.ProviderRecordId,
            IocValue: record.IocIdentity.IocValue,
            IocValueHash: hasher.Hash(record.IocIdentity.IocValue),
            IocType: record.IocIdentity.Type,
            Port: record.IocIdentity.Port,
            ProviderDetailsLink: record.ProviderDetailsLink,
            UpdatedAtUtc: timeProvider.GetUtcNow().UtcDateTime,
            FirstSeenUtc: record.FirstSeenUtc.UtcDateTime,
            LastSeenUtc: record.LastSeenUtc?.UtcDateTime,
            Tags: record.Tags,
            ThreatType: GetMetadataString(metadata, ThreatFoxRecordMapper.ThreatTypeKey),
            Malware: GetMetadataString(metadata, ThreatFoxRecordMapper.MalwareKey),
            MalwareAlias: GetMetadataString(metadata, ThreatFoxRecordMapper.MalwareAliasKey),
            MalwarePrintable: GetMetadataString(metadata, ThreatFoxRecordMapper.MalwarePrintableKey),
            IsCompromised: GetMetadataBool(metadata, ThreatFoxRecordMapper.IsCompromisedKey),
            Reporter: GetMetadataString(metadata, ThreatFoxRecordMapper.ReporterKey),
            Anonymous: null,
            IsVerified: null,
            Target: null,
            PhishTankDetails: null,
            PhishTankOnline: null,
            UrlHost: record.IocIdentity.UrlHost,
            ParentDomain: record.IocIdentity.ParentDomain,
            ThreatFoxConfidenceLevel: GetMetadataByte(metadata, ThreatFoxRecordMapper.ConfidenceLevelKey));
    }

    private static string? GetMetadataString(IReadOnlyDictionary<string, object?>? metadata, string key)
        => metadata is not null && metadata.TryGetValue(key, out var value) ? value as string : null;

    private static bool? GetMetadataBool(IReadOnlyDictionary<string, object?>? metadata, string key)
        => metadata is not null && metadata.TryGetValue(key, out var value) ? value as bool? : null;

    private static byte? GetMetadataByte(IReadOnlyDictionary<string, object?>? metadata, string key)
    {
        if (metadata is not null && metadata.TryGetValue(key, out var value) && value is int intValue)
        {
            return (byte)intValue;
        }

        return null;
    }
}

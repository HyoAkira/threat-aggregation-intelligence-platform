<file path="src/ThreatIntelligence.Application/Abstractions/Persistence/IIocQueryReader.cs">
using ThreatIntelligence.Application.Features.Iocs.Queries;
using ThreatIntelligence.Application.Normalization;

namespace ThreatIntelligence.Application.Abstractions.Persistence;

/// <summary>
/// Reads fully assembled, source-attributed IOC groups for the query handlers. The Application
/// layer classifies and normalizes input into a canonical <see cref="NormalizationResult"/>; the
/// reader consumes canonical keys only and never re-implements classification. Infrastructure
/// supplies the EF Core implementation.
/// </summary>
public interface IIocQueryReader
{
    /// <summary>Returns the public provider-name catalog used by browse filters.</summary>
    Task<IReadOnlyList<string>> GetProviderNamesAsync(CancellationToken cancellationToken) =>
        Task.FromResult<IReadOnlyList<string>>(Array.Empty<string>());

    /// <summary>Returns a bounded, usage-ordered catalog of normalized IOC tags.</summary>
    Task<IReadOnlyList<IocTagCatalogItem>> GetTagCatalogAsync(
        string? query,
        int limit,
        CancellationToken cancellationToken) =>
        Task.FromResult<IReadOnlyList<IocTagCatalogItem>>(Array.Empty<IocTagCatalogItem>());

    /// <summary>
    /// Resolves groups for a normalized indicator and narrows their sources by the optional filter.
    /// IP and URL inputs match their exact normalized identity. Domain inputs additionally match
    /// rows whose URL host or parent domain equals the normalized domain.
    /// </summary>
    Task<PagedResult<IocGroupResult>> SearchGroupsAsync(
        NormalizationResult identity,
        IocSourceFilter filter,
        int page,
        int pageSize,
        CancellationToken cancellationToken);

    /// <summary>
    /// Resolves groups for several normalized indicators in one bounded candidate query, reusing the
    /// same identity semantics as <see cref="SearchGroupsAsync"/> (exact IP/URL and domain relations,
    /// explicit-port behavior, provider/tag narrowing, deterministic ordering, and shared paging).
    /// The result maps every requested identity to its page; a requested identity with no filtered
    /// groups maps to an empty page and is the caller's not-found signal.
    /// </summary>
    Task<IReadOnlyDictionary<NormalizationResult, PagedResult<IocGroupResult>>> SearchBatchAsync(
        IReadOnlyList<NormalizationResult> identities,
        IocSourceFilter filter,
        int page,
        int pageSize,
        CancellationToken cancellationToken);

    /// <summary>
    /// Returns a bounded, deterministically ordered catalog of unique normalized IOC values whose
    /// value begins with the case-insensitive prefix. Provider-row duplicates collapse to one entry.
    /// </summary>
    Task<IReadOnlyList<IocSuggestionItem>> GetIocSuggestionsAsync(
        string prefix,
        int limit,
        CancellationToken cancellationToken);

    /// <summary>
    /// Resolves one row id to its full group across providers and ports. Returns null for an unknown id.
    /// </summary>
    Task<IocGroupResult?> GetDetailGroupAsync(int id, CancellationToken cancellationToken);

    /// <summary>
    /// Returns one deterministic page of filtered groups plus the distinct total.
    /// </summary>
    Task<PagedResult<IocGroupResult>> BrowseAsync(
        IocBrowseCriteria criteria,
        CancellationToken cancellationToken);

    /// <summary>
    /// Returns one deterministic page of groups related by the stored host columns or by the
    /// malware/target metadata. Returns null when the id does not resolve; throws
    /// <see cref="IocRelationNotSupportedException"/> for host relations on IP groups.
    /// </summary>
    Task<PagedResult<IocGroupResult>?> GetRelatedAsync(
        int id,
        IocRelationKind relation,
        int page,
        int pageSize,
        CancellationToken cancellationToken);
}
</file>

<file path="src/ThreatIntelligence.Domain/Entities/Provider.cs">
using ThreatIntelligence.Domain.Common;
using ThreatIntelligence.Domain.Enums;

namespace ThreatIntelligence.Domain.Entities;

public class Provider
{
    private Provider()
    {
    }

    public Provider(
        string name,
        string baseUrl,
        int intervalMinutes,
        bool isEnabled = true,
        FetchStatus? lastFetchStatus = null,
        DateTime? lastFetchAt = null,
        DateTime? nextFetchTime = null,
        FetchMode defaultMode = FetchMode.Recent,
        ProviderFetchModes supportedModes = ProviderFetchModes.Recent | ProviderFetchModes.Full,
        int? recentCooldownMinutes = null,
        int? fullCooldownMinutes = null,
        int? minimumIntervalMinutes = null,
        bool requiresApiKey = false)
    {
        Name = Guard.Required(name, 255, nameof(name));
        BaseUrl = Guard.Required(baseUrl, 255, nameof(baseUrl));
        if (intervalMinutes < 1)
        {
            throw new ArgumentOutOfRangeException(
                nameof(intervalMinutes), intervalMinutes, "Interval must be at least one minute.");
        }

        IntervalMinutes = intervalMinutes;
        IsEnabled = isEnabled;
        LastFetchStatus = lastFetchStatus is { } status
            ? Guard.Defined(status, nameof(lastFetchStatus))
            : null;
        LastFetchAt = Guard.UtcOrNull(lastFetchAt, nameof(lastFetchAt));
        NextFetchTime = Guard.UtcOrNull(nextFetchTime, nameof(nextFetchTime));
        RequiresApiKey = requiresApiKey;
        Configure(
            defaultMode,
            supportedModes,
            recentCooldownMinutes,
            fullCooldownMinutes,
            minimumIntervalMinutes ?? intervalMinutes);
    }

    public int Id { get; private set; }
    public string Name { get; private set; } = string.Empty;
    public string BaseUrl { get; private set; } = string.Empty;
    public bool IsEnabled { get; private set; }
    public int IntervalMinutes { get; private set; }
    public FetchStatus? LastFetchStatus { get; private set; }
    public DateTime? LastFetchAt { get; private set; }
    public DateTime? NextFetchTime { get; private set; }
    public FetchMode DefaultMode { get; private set; }
    public ProviderFetchModes SupportedModes { get; private set; }
    public int? RecentCooldownMinutes { get; private set; }
    public int? FullCooldownMinutes { get; private set; }
    public int MinimumIntervalMinutes { get; private set; }
    public bool RequiresApiKey { get; private set; }

    public bool HasMode(FetchMode mode) => (SupportedModes & mode.ToProviderMode()) != ProviderFetchModes.None;

    public TimeSpan? CooldownFor(FetchMode mode) => mode switch
    {
        FetchMode.Recent => RecentCooldownMinutes is { } minutes ? TimeSpan.FromMinutes(minutes) : null,
        FetchMode.Full => FullCooldownMinutes is { } minutes ? TimeSpan.FromMinutes(minutes) : null,
        _ => null
    };

    public void Configure(
        FetchMode defaultMode,
        ProviderFetchModes supportedModes,
        int? recentCooldownMinutes,
        int? fullCooldownMinutes,
        int minimumIntervalMinutes)
    {
        if (supportedModes == ProviderFetchModes.None)
        {
            throw new ArgumentException("At least one fetch mode must be supported.", nameof(supportedModes));
        }

        if ((supportedModes & ~(ProviderFetchModes.Recent | ProviderFetchModes.Full)) != ProviderFetchModes.None)
        {
            throw new ArgumentException("supportedModes contains an undefined mode.", nameof(supportedModes));
        }

        Guard.Defined(defaultMode, nameof(defaultMode));
        if ((supportedModes & defaultMode.ToProviderMode()) == ProviderFetchModes.None)
        {
            throw new ArgumentException("The default mode must be one of the supported modes.", nameof(defaultMode));
        }

        if (recentCooldownMinutes is <= 0)
        {
            throw new ArgumentException("recentCooldownMinutes must be positive when set.", nameof(recentCooldownMinutes));
        }

        if (fullCooldownMinutes is <= 0)
        {
            throw new ArgumentException("fullCooldownMinutes must be positive when set.", nameof(fullCooldownMinutes));
        }

        if (minimumIntervalMinutes <= 0)
        {
            throw new ArgumentException("minimumIntervalMinutes must be positive.", nameof(minimumIntervalMinutes));
        }

        DefaultMode = defaultMode;
        SupportedModes = supportedModes;
        RecentCooldownMinutes = recentCooldownMinutes;
        FullCooldownMinutes = fullCooldownMinutes;
        MinimumIntervalMinutes = minimumIntervalMinutes;
    }

    public void SetEnabled(bool isEnabled) => IsEnabled = isEnabled;

    public void SetRequiresApiKey(bool requiresApiKey) => RequiresApiKey = requiresApiKey;

    public void SetIntervalMinutes(int intervalMinutes)
    {
        if (intervalMinutes < 1)
        {
            throw new ArgumentOutOfRangeException(
                nameof(intervalMinutes), intervalMinutes, "Interval must be at least one minute.");
        }

        IntervalMinutes = intervalMinutes;
        if (LastFetchAt.HasValue)
        {
            NextFetchTime = LastFetchAt.Value.AddMinutes(intervalMinutes);
        }
    }

    public void MarkFetchRunning() => LastFetchStatus = FetchStatus.Running;

    public void MarkFetchSucceeded(DateTime completedAtUtc, bool updateNextFetchTime = true)
    {
        LastFetchStatus = FetchStatus.Success;
        LastFetchAt = Guard.Utc(completedAtUtc, nameof(completedAtUtc));
        if (updateNextFetchTime)
        {
            NextFetchTime = LastFetchAt.Value.AddMinutes(IntervalMinutes);
        }
    }

    public void MarkFetchFailed() => LastFetchStatus = FetchStatus.Failed;

    public void SetNextFetchTime(DateTime nextFetchTimeUtc) =>
        NextFetchTime = Guard.Utc(nextFetchTimeUtc, nameof(nextFetchTimeUtc));
}
</file>


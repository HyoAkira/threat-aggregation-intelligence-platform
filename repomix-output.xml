        Assert.False(_evaluator.IsFalsePositive(exactlyAtBoundary));
    }

    [Fact]
    public void Future_timestamp_is_not_false_positive()
    {
        Assert.False(_evaluator.IsFalsePositive(NowUtc.AddDays(1)));
    }
}

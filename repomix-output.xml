<file path="src/ThreatIntelligence.Infrastructure/PhishTank/PhishTankClient.cs">
using System.Diagnostics;
using System.Net;
using System.Text;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Infrastructure.Configuration;

namespace ThreatIntelligence.Infrastructure.PhishTank;

public sealed class PhishTankClient : IPhishTankClient
{
    public const string DefaultBaseUrl = "https://data.phishtank.com";
    private const string FeedPathPrefix = "data";
    private const string FeedFileName = "online-valid.json.gz";

    private readonly HttpClient _httpClient;
    private readonly string? _legacyAppKey;
    private readonly string _baseUrl;
    private readonly ILogger<PhishTankClient> _logger;

    public PhishTankClient(
        HttpClient httpClient,
        PhishTankOptions options,
        string baseUrl = DefaultBaseUrl,
        ILogger<PhishTankClient>? logger = null)
    {
        _httpClient = httpClient;
        _legacyAppKey = options.AppKey;
        _baseUrl = baseUrl;
        _logger = logger ?? NullLogger<PhishTankClient>.Instance;
        if (_httpClient.DefaultRequestHeaders.UserAgent.Count > 0) return;
        _httpClient.DefaultRequestHeaders.UserAgent.ParseAdd("ThreatIntelligence.Worker/1.0");
    }

    public async Task<PhishTankFeedStream> FetchFeedAsync(CancellationToken cancellationToken)
        => await FetchFeedAsync(_legacyAppKey, cancellationToken).ConfigureAwait(false);

    public async Task<PhishTankFeedStream> FetchFeedAsync(string? appKey, CancellationToken cancellationToken)
    {
        using var request = new HttpRequestMessage(HttpMethod.Get, BuildFeedUri(appKey));

        _logger.LogInformation("PhishTank feed request starting FileName={FileName}", FeedFileName);

        var stopwatch = Stopwatch.StartNew();
        var response = await _httpClient.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, cancellationToken).ConfigureAwait(false);
        stopwatch.Stop();

        if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            _logger.LogError("PhishTank feed rate limit exceeded (HTTP 429).");
            throw new PhishTankQuotaException("PhishTank rate limit exceeded (HTTP 429).");
        }

        if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
        {
            _logger.LogError(
                "PhishTank feed authentication failed StatusCode={StatusCode} ElapsedMs={ElapsedMs}",
                (int)response.StatusCode,
                stopwatch.ElapsedMilliseconds);
            throw new PhishTankAuthenticationException(
                $"PhishTank authentication failed (HTTP {(int)response.StatusCode}).");
        }

        if (!response.IsSuccessStatusCode)
        {
            var payloadPrefix = await ReadDiagnosticPrefixAsync(response, cancellationToken).ConfigureAwait(false);
            _logger.LogError(
                "PhishTank feed request failed StatusCode={StatusCode} ElapsedMs={ElapsedMs} Location={Location} PayloadPrefix={PayloadPrefix}",
                (int)response.StatusCode,
                stopwatch.ElapsedMilliseconds,
                response.Headers.Location is null ? "<none>" : "<present>",
                payloadPrefix);

            if ((int)response.StatusCode is >= 300 and < 400)
            {
                throw new ProviderFetchHttpException(
                    response.StatusCode,
                    $"PhishTank feed request was redirected (HTTP {(int)response.StatusCode}); the feed URL may have moved.");
            }

            throw response.StatusCode >= HttpStatusCode.InternalServerError
                ? new ProviderFetchHttpException(response.StatusCode, "PhishTank feed request failed.")
                : new ProviderFetchHttpException(response.StatusCode, "PhishTank feed request was rejected.");
        }

        _logger.LogInformation(
            "PhishTank feed response received FileName={FileName} StatusCode={StatusCode} ContentType={ContentType} ContentLength={ContentLength} ElapsedMs={ElapsedMs}",
            FeedFileName,
            (int)response.StatusCode,
            response.Content.Headers.ContentType?.ToString(),
            response.Content.Headers.ContentLength,
            stopwatch.ElapsedMilliseconds);

        var content = await response.Content.ReadAsStreamAsync(cancellationToken).ConfigureAwait(false);
        return new PhishTankFeedStream(FeedFileName, content);
    }

    internal Uri BuildFeedUri(string? appKey = null)
    {
        var baseUri = new Uri(_baseUrl.TrimEnd('/'));
        var path = string.IsNullOrEmpty(appKey)
            ? $"{FeedPathPrefix}/{FeedFileName}"
            : $"{FeedPathPrefix}/{appKey}/{FeedFileName}";
        return new Uri(baseUri, path);
    }

    private static async Task<string> ReadDiagnosticPrefixAsync(
        HttpResponseMessage response,
        CancellationToken cancellationToken)
    {
        try
        {
            await using var body = await response.Content
                .ReadAsStreamAsync(cancellationToken)
                .ConfigureAwait(false);

            var buffer = new byte[512];
            var read = await body.ReadAsync(buffer, cancellationToken).ConfigureAwait(false);
            if (read == 0)
            {
                return "<empty body>";
            }

            var text = Encoding.UTF8.GetString(buffer, 0, read).Replace('\r', ' ').Replace('\n', ' ').Trim();
            return text.Length > 0 ? text : "<non-text body>";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return "<unreadable body>";
        }
    }
}

public interface IPhishTankClient
{
    Task<PhishTankFeedStream> FetchFeedAsync(CancellationToken cancellationToken);

    Task<PhishTankFeedStream> FetchFeedAsync(string? appKey, CancellationToken cancellationToken) =>
        FetchFeedAsync(cancellationToken);
}

public sealed record PhishTankFeedStream(string Name, Stream Content);
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/ThreatFoxRecentParser.cs">
using System.Runtime.CompilerServices;
using System.Text;
using System.Text.Json;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;
using ThreatIntelligence.Application.ProviderRecords;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Streams a ThreatFox JSON export and yields one canonical provider record per accepted record.
/// Two root shapes are supported:
/// <list type="bullet">
/// <item>a top-level JSON array of records (community-style), and</item>
/// <item>a top-level JSON object keyed by ThreatFox id whose values are arrays of records
/// (the exports: <c>recent.json</c>, <c>full.json</c>).</item>
/// </list>
/// A malformed record raises a <see cref="ThreatFoxRecordParseException"/> naming the
/// record index; it is never silently dropped. A record whose IOC type the platform does not
/// ingest (for example a file hash) is skipped, and skipped records are counted by IOC type in
/// one warning summary per parsed source. A body that is neither shape raises a
/// <see cref="ThreatFoxFeedFormatException"/> carrying a capped prefix of what the endpoint returned.
/// </summary>
public sealed class ThreatFoxRecentParser
{
    public const int MaxDiagnosticPrefixBytes = 512;
    public const long MaxBufferedObjectBytes = 256L * 1024 * 1024;

    private static readonly JsonSerializerOptions SerializerOptions = new(JsonSerializerDefaults.Web)
    {
        // The export has been observed emitting a trailing comma before the closing object brace.
        AllowTrailingCommas = true
    };

    private static readonly JsonDocumentOptions DocumentOptions = new()
    {
        AllowTrailingCommas = true
    };

    private readonly ThreatFoxRecordMapper _mapper;
    private readonly ILogger<ThreatFoxRecentParser> _logger;

    public ThreatFoxRecentParser(
        ThreatFoxRecordMapper mapper,
        ILogger<ThreatFoxRecentParser>? logger = null)
    {
        _mapper = mapper;
        _logger = logger ?? NullLogger<ThreatFoxRecentParser>.Instance;
    }

    public async IAsyncEnumerable<ProviderRecordInput> ParseAsync(
        Stream stream,
        [EnumeratorCancellation] CancellationToken cancellationToken)
    {
        var captured = new PrefixCapturingStream(stream, MaxDiagnosticPrefixBytes);
        await captured.CaptureAsync(cancellationToken).ConfigureAwait(false);

        var payloadPrefix = DescribePrefix(captured.Prefix.Span);
        var firstToken = FirstNonWhitespaceByte(captured.Prefix.Span);

        var records = firstToken switch
        {
            (byte)'[' => ParseArrayAsync(captured, payloadPrefix, cancellationToken),
            (byte)'{' => ParseKeyedObjectAsync(captured, payloadPrefix, cancellationToken),
            _ => throw BuildShapeFailure(firstToken, payloadPrefix)
        };

        var recordIndex = 0;
        var skippedByIocType = new Dictionary<string, int>();
        await foreach (var record in records.ConfigureAwait(false))
        {
            cancellationToken.ThrowIfCancellationRequested();
            recordIndex++;
            if (record is null)
            {
                throw new ThreatFoxRecordParseException(recordIndex, "record", "Empty record in feed.");
            }

            var mapped = _mapper.Map(record, recordIndex);
            if (mapped is null)
            {
                var skippedType = (record.IocType ?? string.Empty).Trim().ToLowerInvariant();
                if (skippedType.Length == 0)
                {
                    skippedType = "<blank>";
                }

                skippedByIocType[skippedType] = skippedByIocType.GetValueOrDefault(skippedType) + 1;
                continue;
            }

            yield return mapped;
        }

        if (skippedByIocType.Count > 0)
        {
            var totalSkipped = skippedByIocType.Values.Sum();
            var breakdown = string.Join(", ", skippedByIocType.Select(pair => $"{pair.Key}={pair.Value}"));
            _logger.LogWarning(
                "ThreatFox export contained {SkippedCount} record(s) with unsupported IOC types; skipped: {SkippedByIocType}",
                totalSkipped,
                breakdown);
        }
    }

    private async IAsyncEnumerable<ThreatFoxJsonRecord> ParseArrayAsync(
        PrefixCapturingStream stream,
        string payloadPrefix,
        [EnumeratorCancellation] CancellationToken cancellationToken)
    {
        var recordIndex = 0;
        await using var enumerator = JsonSerializer
            .DeserializeAsyncEnumerable<ThreatFoxJsonRecord>(stream, SerializerOptions, cancellationToken)
            .GetAsyncEnumerator(cancellationToken);

        while (true)
        {
            ThreatFoxJsonRecord? record;
            try
            {
                if (!await enumerator.MoveNextAsync().ConfigureAwait(false))
                {
                    break;
                }

                record = enumerator.Current;
            }
            catch (JsonException ex)
            {
                _logger.LogError(
                    ex,
                    "ThreatFox feed JSON parse failure at record {RecordIndex}. PayloadPrefix={PayloadPrefix}",
                    recordIndex + 1,
                    payloadPrefix);
                throw new ThreatFoxFeedFormatException(
                    $"ThreatFox feed JSON parse failure at record {recordIndex + 1}: {ex.Message}. Payload prefix: {payloadPrefix}",
                    payloadPrefix,
                    ex);
            }

            recordIndex++;
            yield return record!;
        }
    }

    private async IAsyncEnumerable<ThreatFoxJsonRecord> ParseKeyedObjectAsync(
        PrefixCapturingStream stream,
        string payloadPrefix,
        [EnumeratorCancellation] CancellationToken cancellationToken)
    {
        // System.Text.Json cannot stream a root-level JSON object property-by-property, so the
        // keyed export is buffered. The bound prevents an unexpectedly large/abusive body from
        // exhausting memory; the recent exports are small, and oversized bodies fail closed.
        var body = await ReadAllBoundedAsync(stream, MaxBufferedObjectBytes, payloadPrefix, cancellationToken)
            .ConfigureAwait(false);

        JsonDocument document;
        try
        {
            document = JsonDocument.Parse(body, DocumentOptions);
        }
        catch (JsonException ex)
        {
            _logger.LogError(
                ex,
                "ThreatFox keyed-object export is not valid JSON. PayloadPrefix={PayloadPrefix}",
                payloadPrefix);
            throw new ThreatFoxFeedFormatException(
                $"ThreatFox keyed-object export is not valid JSON: {ex.Message}. Payload prefix: {payloadPrefix}",
                payloadPrefix,
                ex);
        }

        using (document)
        {
            var entryIndex = 0;
            foreach (var property in document.RootElement.EnumerateObject())
            {
                entryIndex++;
                var id = property.Name;
                if (property.Value.ValueKind != JsonValueKind.Array)
                {
                    _logger.LogError(
                        "ThreatFox export entry Id={Id} is not an array. PayloadPrefix={PayloadPrefix}",
                        id,
                        payloadPrefix);
                    throw new ThreatFoxFeedFormatException(
                        $"ThreatFox export entry '{id}' is not an array. Payload prefix: {payloadPrefix}",
                        payloadPrefix);
                }

                List<ThreatFoxJsonRecord> entryRecords;
                try
                {
                    entryRecords = property.Value.Deserialize<List<ThreatFoxJsonRecord>>(SerializerOptions)
                        ?? new List<ThreatFoxJsonRecord>();
                }
                catch (JsonException ex)
                {
                    _logger.LogError(
                        ex,
                        "ThreatFox export entry Id={Id} could not be mapped. PayloadPrefix={PayloadPrefix}",
                        id,
                        payloadPrefix);
                    throw new ThreatFoxFeedFormatException(
                        $"ThreatFox export entry '{id}' could not be mapped: {ex.Message}. Payload prefix: {payloadPrefix}",
                        payloadPrefix,
                        ex);
                }

                if (entryRecords.Count > 1)
                {
                    _logger.LogWarning(
                        "ThreatFox export entry Id={Id} contained {RecordCount} records; mapping all (identity collapses to Id)",
                        id,
                        entryRecords.Count);
                }

                foreach (var record in entryRecords)
                {
                    if (record is null)
                    {
                        throw new ThreatFoxRecordParseException(entryIndex, "record", $"Export entry '{id}' contains an empty record.");
                    }

                    yield return string.IsNullOrWhiteSpace(record.Id) ? record with { Id = id } : record;
                }
            }
        }
    }

    private static async Task<byte[]> ReadAllBoundedAsync(
        Stream stream,
        long maxBytes,
        string payloadPrefix,
        CancellationToken cancellationToken)
    {
        using var buffer = new MemoryStream();
        var chunk = new byte[81920];
        int read;
        while ((read = await stream.ReadAsync(chunk, cancellationToken).ConfigureAwait(false)) > 0)
        {
            if (buffer.Length + read > maxBytes)
            {
                throw new ThreatFoxFeedFormatException(
                    $"ThreatFox keyed-object export exceeds the {maxBytes} byte buffering guard. Payload prefix: {payloadPrefix}",
                    payloadPrefix);
            }

            buffer.Write(chunk, 0, read);
        }

        return buffer.ToArray();
    }

    private ThreatFoxFeedFormatException BuildShapeFailure(byte? firstToken, string payloadPrefix)
    {
        var firstTokenText = firstToken is null ? "<empty>" : ((char)firstToken.Value).ToString();
        _logger.LogError(
            "ThreatFox feed has an unsupported root token. FirstToken={FirstToken} PayloadPrefix={PayloadPrefix}",
            firstTokenText,
            payloadPrefix);
        return new ThreatFoxFeedFormatException(
            $"ThreatFox feed is neither a JSON array nor a JSON object (first token '{firstTokenText}'). Payload prefix: {payloadPrefix}",
            payloadPrefix);
    }

    private static byte? FirstNonWhitespaceByte(ReadOnlySpan<byte> bytes)
    {
        var span = bytes;
        if (span.StartsWith(new byte[] { 0xEF, 0xBB, 0xBF }))
        {
            span = span[3..];
        }

        foreach (var value in span)
        {
            if (value is (byte)' ' or (byte)'\t' or (byte)'\r' or (byte)'\n')
            {
                continue;
            }

            return value;
        }

        return null;
    }

    private static string DescribePrefix(ReadOnlySpan<byte> bytes)
    {
        if (bytes.IsEmpty)
        {
            return "<empty body>";
        }

        var text = Encoding.UTF8.GetString(bytes).Replace('\r', ' ').Replace('\n', ' ').Trim();
        return text.Length > 0 ? text : "<non-text body>";
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/ThreatFoxRecordMapper.cs">
using System.Globalization;
using ThreatIntelligence.Application.ProviderRecords;
using ThreatIntelligence.Domain.Enums;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Maps a parsed ThreatFox JSON record into the canonical E03 <see cref="ProviderRecordInput"/>,
/// preserving valid <c>false</c>, <c>0</c>, and empty values while leaving absent values null.
/// Returns null when the record's IOC type is not one the platform ingests (for example a file
/// hash), so the caller can skip the record; genuinely malformed records throw
/// <see cref="ThreatFoxRecordParseException"/>.
/// </summary>
public sealed class ThreatFoxRecordMapper
{
    public const int ThreatFoxProviderId = 1;

    public const string ThreatTypeKey = "threat_type";
    public const string ThreatTypeDescKey = "threat_type_desc";
    public const string IocTypeDescKey = "ioc_type_desc";
    public const string MalwareKey = "malware";
    public const string MalwarePrintableKey = "malware_printable";
    public const string MalwareAliasKey = "malware_alias";
    public const string MalwareMalpediaKey = "malware_malpedia";
    public const string ConfidenceLevelKey = "confidence_level";
    public const string IsCompromisedKey = "is_compromised";
    public const string ReporterKey = "reporter";
    public const string ReferenceKey = "reference";
    public const string IocTypeKey = "ioc_type";
    public const string MalwareSamplesKey = "malware_samples";

    public ProviderRecordInput? Map(ThreatFoxJsonRecord record, int recordIndex)
    {
        if (record is null)
        {
            throw new ThreatFoxRecordParseException(recordIndex, "record", "Empty record in feed.");
        }

        if (!TryMapIocType(record.IocType, out var type))
        {
            return null;
        }

        var id = Require(record.Id, "id", recordIndex);
        var ioc = Require(record.Ioc ?? record.IocValue, "ioc", recordIndex);
        var firstSeen = ParseTimestamp(record.FirstSeen ?? record.FirstSeenUtc, "first_seen", recordIndex);
        var lastSeen = ParseOptionalTimestamp(record.LastSeen ?? record.LastSeenUtc, "last_seen", recordIndex);

        return new ProviderRecordInput(
            ProviderId: ThreatFoxProviderId,
            ProviderRecordId: id,
            RawIoc: ioc,
            DeclaredType: type,
            FirstSeenAt: firstSeen,
            LastSeenAt: lastSeen,
            ProviderDetailsLink: BuildDetailsLink(id),
            Tags: NormalizeTags(record.Tags),
            Metadata: BuildMetadata(record),
            Payload: null);
    }

    /// <summary>
    /// Maps the ThreatFox <c>ioc_type</c> string to an <see cref="IocType"/>, returning false for
    /// IOC types the platform does not ingest so the caller can skip the record.
    /// <c>ip:port</c> maps to a null type so the classifier decides between IPv4 and IPv6.
    /// </summary>
    private static bool TryMapIocType(string? iocType, out IocType? type)
    {
        switch ((iocType ?? string.Empty).Trim().ToLowerInvariant())
        {
            case "domain":
                type = IocType.Domain;
                return true;
            case "url":
                type = IocType.Url;
                return true;
            case "ip:port":
                type = null;
                return true;
            default:
                type = null;
                return false;
        }
    }

    private static string Require(string? value, string field, int recordIndex)
        => string.IsNullOrWhiteSpace(value)
            ? throw new ThreatFoxRecordParseException(recordIndex, field, "Value is blank.")
            : value.Trim();

    private static DateTime ParseTimestamp(string? value, string field, int recordIndex)
        => TryParseThreatFoxTimestamp(value, out var utc)
            ? utc
            : throw new ThreatFoxRecordParseException(recordIndex, field, $"Timestamp '{value}' is not a valid UTC value.");

    private static DateTime? ParseOptionalTimestamp(string? value, string field, int recordIndex)
        => string.IsNullOrWhiteSpace(value)
            ? null
            : ParseTimestamp(value, field, recordIndex);

    private static bool TryParseThreatFoxTimestamp(string? value, out DateTime utc)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            utc = default;
            return false;
        }

        var normalized = value.Trim();
        if (normalized.EndsWith("UTC", StringComparison.OrdinalIgnoreCase))
        {
            normalized = normalized[..^3].Trim();
        }
        else if (normalized.EndsWith('Z'))
        {
            normalized = normalized[..^1].Trim();
        }
        else if (normalized.EndsWith('z'))
        {
            normalized = normalized[..^1].Trim();
        }

        return DateTime.TryParse(
            normalized,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out utc);
    }

    private static string BuildDetailsLink(string id)
        => $"https://threatfox.abuse.ch/ioc/{id}";

    private static IReadOnlyCollection<string?>? NormalizeTags(IReadOnlyList<string>? tags)
    {
        if (tags is null || tags.Count == 0)
        {
            return null;
        }

        var seen = new HashSet<string>(StringComparer.Ordinal);
        var normalized = new List<string?>(tags.Count);
        foreach (var tag in tags)
        {
            if (string.IsNullOrWhiteSpace(tag))
            {
                continue;
            }

            var value = tag.Trim().ToLowerInvariant();
            if (seen.Add(value))
            {
                normalized.Add(value);
            }
        }

        return normalized.Count > 0 ? normalized : null;
    }

    private static IReadOnlyDictionary<string, object?> BuildMetadata(ThreatFoxJsonRecord record)
    {
        var metadata = new Dictionary<string, object?>
        {
            [IocTypeKey] = record.IocType
        };

        AddIfNotNull(metadata, ThreatTypeKey, record.ThreatType);
        AddIfNotNull(metadata, ThreatTypeDescKey, record.ThreatTypeDesc);
        AddIfNotNull(metadata, IocTypeDescKey, record.IocTypeDesc);
        AddIfNotNull(metadata, MalwareKey, record.Malware);
        AddIfNotNull(metadata, MalwarePrintableKey, record.MalwarePrintable);
        AddIfNotNull(metadata, MalwareAliasKey, record.MalwareAlias);
        AddIfNotNull(metadata, MalwareMalpediaKey, record.MalwareMalpedia);
        AddIfNotNull(metadata, ConfidenceLevelKey, record.ConfidenceLevel);
        AddIfNotNull(metadata, IsCompromisedKey, record.IsCompromised);
        AddIfNotNull(metadata, ReporterKey, record.Reporter);
        AddIfNotNull(metadata, ReferenceKey, record.Reference);
        AddIfNotNull(metadata, MalwareSamplesKey, record.MalwareSamples);

        return metadata;
    }

    private static void AddIfNotNull(Dictionary<string, object?> metadata, string key, object? value)
    {
        if (value is not null)
        {
            metadata[key] = value;
        }
    }
}

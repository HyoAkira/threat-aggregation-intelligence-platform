<file path="src/ThreatIntelligence.Infrastructure/PublicSuffix/PublicSuffixParentDomainResolver.cs">
using System.Net;
using System.Net.Sockets;
using Nager.PublicSuffix;
using Nager.PublicSuffix.RuleProviders;
using ThreatIntelligence.Application.Normalization;

namespace ThreatIntelligence.Infrastructure.PublicSuffix;

public class PublicSuffixParentDomainResolver : IParentDomainResolver
{
    private readonly DomainParser _parser;

    public PublicSuffixParentDomainResolver()
    {
        var dataPath = Path.Combine(AppContext.BaseDirectory, "Data", "public_suffix_list.dat");
        var ruleProvider = new LocalFileRuleProvider(dataPath);
        ruleProvider.BuildAsync().GetAwaiter().GetResult();
        _parser = new DomainParser(ruleProvider);
    }

    public string? Resolve(string host)
    {
        if (string.IsNullOrWhiteSpace(host))
        {
            return null;
        }

        var trimmed = host.Trim().TrimEnd('.');
        if (IsIpAddress(trimmed) || IsSingleLabel(trimmed))
        {
            return trimmed;
        }

        if (_parser.TryParse(trimmed, out var info))
        {
            return info.RegistrableDomain is { Length: > 0 } registrable
                ? registrable
                : null;
        }

        if (trimmed.Length <= 64)
        {
            var probeLabel = "r." + trimmed;
            if (_parser.TryParse(probeLabel, out var subInfo) &&
                subInfo.RegistrableDomain is { Length: > 0 })
            {
                return null;
            }
        }

        string[] labels = trimmed.Split('.');
        if (labels.Length < 2)
        {
            return null;
        }

        return labels[^2] + "." + labels[^1];
    }

    private static bool IsIpAddress(string host)
        => IPAddress.TryParse(host, out var parsed) &&
           parsed.AddressFamily is AddressFamily.InterNetwork or AddressFamily.InterNetworkV6;

    private static bool IsSingleLabel(string host)
        => !host.Contains('.');
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/FlexibleStringListConverter.cs">
using System.Text.Json;
using System.Text.Json.Serialization;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Reads a ThreatFox tag field that may be serialized either as a comma-separated JSON string
/// (the export files) or as a JSON array of strings (the community API shape). Null, blank, or
/// empty values yield <c>null</c> so downstream normalization keeps treating "no tags" as absent.
/// </summary>
internal sealed class FlexibleStringListConverter : JsonConverter<IReadOnlyList<string>?>
{
    public override IReadOnlyList<string>? Read(
        ref Utf8JsonReader reader,
        Type typeToConvert,
        JsonSerializerOptions options)
    {
        switch (reader.TokenType)
        {
            case JsonTokenType.Null:
                return null;

            case JsonTokenType.String:
                var raw = reader.GetString();
                if (string.IsNullOrWhiteSpace(raw))
                {
                    return null;
                }

                var split = raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                return split.Length > 0 ? split : null;

            case JsonTokenType.StartArray:
                var values = new List<string>();
                while (reader.Read() && reader.TokenType != JsonTokenType.EndArray)
                {
                    if (reader.TokenType != JsonTokenType.String)
                    {
                        throw new JsonException($"Unexpected token {reader.TokenType} inside a tags array.");
                    }

                    var value = reader.GetString();
                    if (!string.IsNullOrWhiteSpace(value))
                    {
                        values.Add(value);
                    }
                }

                return values.Count > 0 ? values : null;

            default:
                throw new JsonException($"Unexpected token {reader.TokenType} for tags.");
        }
    }

    public override void Write(
        Utf8JsonWriter writer,
        IReadOnlyList<string>? value,
        JsonSerializerOptions options)
    {
        if (value is null)
        {
            writer.WriteNullValue();
            return;
        }

        writer.WriteStartArray();
        foreach (var item in value)
        {
            writer.WriteStringValue(item);
        }

        writer.WriteEndArray();
    }
}
</file>

<file path="src/ThreatIntelligence.Infrastructure/ThreatFox/PersistingThreatFoxExportClient.cs">
using ThreatIntelligence.Application.Fetches;

namespace ThreatIntelligence.Infrastructure.ThreatFox;

/// <summary>
/// Wraps <see cref="IThreatFoxExportClient"/> so every received export is first persisted to disk
/// via <see cref="IRawFeedStore"/>; the returned stream then reads from the saved file. This keeps
/// the executor contract (an incremental stream) unchanged while guaranteeing the original payload
/// is retained even if parsing later fails.
/// </summary>
public sealed class PersistingThreatFoxExportClient(
    IThreatFoxExportClient inner,
    IRawFeedStore rawFeedStore) : IThreatFoxExportClient
{
    internal const string ProviderSlug = "threatfox";

    public Task<ThreatFoxExportStream> FetchRecentAsync(CancellationToken cancellationToken)
        => FetchAndPersistAsync(RawFeedCategory.Recent, ct => inner.FetchRecentAsync(ct), cancellationToken);

    public Task<ThreatFoxExportStream> FetchFullAsync(CancellationToken cancellationToken)
        => FetchAndPersistAsync(RawFeedCategory.Full, inner.FetchFullAsync, cancellationToken);

    public Task<ThreatFoxExportStream> FetchRecentAsync(string? apiKey, CancellationToken cancellationToken)
        => FetchAndPersistAsync(RawFeedCategory.Recent, ct => inner.FetchRecentAsync(apiKey, ct), cancellationToken);

    public Task<ThreatFoxExportStream> FetchFullAsync(string? apiKey, CancellationToken cancellationToken)
        => FetchAndPersistAsync(RawFeedCategory.Full, ct => inner.FetchFullAsync(apiKey, ct), cancellationToken);

    private async Task<ThreatFoxExportStream> FetchAndPersistAsync(
        RawFeedCategory category,
        Func<CancellationToken, Task<ThreatFoxExportStream>> fetch,
        CancellationToken cancellationToken)
    {
        var stream = await fetch(cancellationToken).ConfigureAwait(false);

        await using (stream.Content)
        {
            var saved = await rawFeedStore
                .SaveAsync(ProviderSlug, category, stream.Name, stream.Content, cancellationToken)
                .ConfigureAwait(false);

            return new ThreatFoxExportStream(stream.Name, rawFeedStore.OpenRead(saved));
        }
    }
}

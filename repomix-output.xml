<file path="src/ThreatIntelligence.Application/Features/Iocs/Queries/IocGroupResult.cs">
using ThreatIntelligence.Domain.Enums;

namespace ThreatIntelligence.Application.Features.Iocs.Queries;

/// <summary>
/// Wire token for <see cref="IocType"/> used by the query response contract and the browse
/// <c>type</c> filter. The spec fixes the lowercase tokens <c>ipv4</c>, <c>ipv6</c>, <c>domain</c>,
/// and <c>url</c>; they are independent of the persisted ordinal values.
/// </summary>
public static class IocTypeToken
{
    public const string Ipv4 = "ipv4";
    public const string Ipv6 = "ipv6";
    public const string Domain = "domain";
    public const string Url = "url";

    public static string ToToken(IocType type) => type switch
    {
        IocType.Ipv4 => Ipv4,
        IocType.Ipv6 => Ipv6,
        IocType.Domain => Domain,
        IocType.Url => Url,
        _ => throw new ArgumentOutOfRangeException(nameof(type), type, "Unknown IOC type.")
    };

    public static bool TryParse(string? token, out IocType type)
    {
        switch (token?.Trim().ToLowerInvariant())
        {
            case Ipv4:
                type = IocType.Ipv4;
                return true;
            case Ipv6:
                type = IocType.Ipv6;
                return true;
            case Domain:
                type = IocType.Domain;
                return true;
            case Url:
                type = IocType.Url;
                return true;
            default:
                type = default;
                return false;
        }
    }
}

/// <summary>
/// One normalized IOC group as projected onto the wire by every query endpoint. The group exposes
/// the id of one of its stored rows so callers can link to detail and relations, the normalized
/// value, its lowercase type token, the nullable relations, the aggregate first/last seen across
/// its returned sources, and one source entry per matching provider row.
/// </summary>
public sealed record IocGroupResult(
    int Id,
    string IocValue,
    string IocType,
    string? UrlHost,
    string? ParentDomain,
    DateTime FirstSeenUtc,
    DateTime? LastSeenUtc,
    IReadOnlyList<IocSourceResult> Sources);
</file>

<file path="src/ThreatIntelligence.Application/Fetches/FetchExceptions.cs">
using System.Data.Common;
using System.Net;
using System.Net.Sockets;
using ThreatIntelligence.Application.Abstractions.Secrets;

namespace ThreatIntelligence.Application.Fetches;

public sealed class TerminalFetchException(string message, Exception? innerException = null)
    : Exception(message, innerException);

public sealed class TransientFetchException(string message, Exception? innerException = null)
    : Exception(message, innerException);

public sealed class ProviderFetchHttpException(HttpStatusCode statusCode, string message)
    : Exception(message)
{
    public HttpStatusCode StatusCode { get; } = statusCode;
}

public static class FetchErrorClassifier
{
    public static bool IsTransient(Exception exception) => exception switch
    {
        TransientFetchException => true,
        HttpRequestException => true,
        SocketException => true,
        TimeoutException => true,
        DbException => true,
        ProviderFetchHttpException { StatusCode: >= HttpStatusCode.InternalServerError } => true,
        ProviderCredentialMissingException => false,
        _ => false
    };

    public static Exception Classify(Exception exception) =>
        exception is TerminalFetchException or TransientFetchException
            ? exception
            : IsTransient(exception)
                ? new TransientFetchException(exception.Message, exception)
                : new TerminalFetchException(exception.Message, exception);
}
</file>

<file path="src/ThreatIntelligence.Application/Fetches/FetchJob.cs">
using ThreatIntelligence.Domain.Enums;
using System.Text.Json.Serialization;

namespace ThreatIntelligence.Application.Fetches;

/// <summary>
/// Version 1 of the durable message that represents one persisted fetch-history row.
/// </summary>
public sealed record FetchJob
{
    public FetchJob(
        Guid jobId,
        int providerId,
        FetchTrigger trigger,
        FetchMode mode,
        int attempt,
        string? correlationId = null)
    {
        if (jobId == Guid.Empty)
        {
            throw new ArgumentException("JobId must not be empty.", nameof(jobId));
        }

        if (providerId < 1)
        {
            throw new ArgumentOutOfRangeException(nameof(providerId), "ProviderId must be positive.");
        }

        if (!Enum.IsDefined(trigger))
        {
            throw new ArgumentOutOfRangeException(nameof(trigger), "Trigger must be defined.");
        }

        if (!Enum.IsDefined(mode))
        {
            throw new ArgumentOutOfRangeException(nameof(mode), "Mode must be defined.");
        }

        if (attempt < 1)
        {
            throw new ArgumentOutOfRangeException(nameof(attempt), "Attempt must be positive.");
        }

        JobId = jobId;
        ProviderId = providerId;
        Trigger = trigger;
        Mode = mode;
        Attempt = attempt;
        CorrelationId = string.IsNullOrWhiteSpace(correlationId) ? jobId.ToString("N") : correlationId;
    }

    public Guid JobId { get; }
    public int ProviderId { get; }
    [JsonConverter(typeof(JsonStringEnumConverter<FetchTrigger>))]
    public FetchTrigger Trigger { get; }

    [JsonConverter(typeof(JsonStringEnumConverter<FetchMode>))]
    public FetchMode Mode { get; }
    public int Attempt { get; }

    /// <summary>
    /// Correlation id threaded from the triggering API request (or generated for scheduled jobs) so
    /// API, broker, and Worker lifecycle events for one job share a trace. Defaults to the job id.
    /// </summary>
    public string CorrelationId { get; }
}

# Copy this file to .env and replace each placeholder. Never commit .env.

# Compose database bootstrap (SQL Server requires a strong password).
SA_PASSWORD=CHANGE_ME_STRONG_SA_PASSWORD
TEST_SQLSERVER_PASSWORD=CHANGE_ME_STRONG_TEST_PASSWORD
DATABASE__CONNECTIONSTRING=Server=localhost,1433;Database=ThreatIntelligence;User Id=sa;Password=CHANGE_ME_STRONG_SA_PASSWORD;TrustServerCertificate=True;Encrypt=False

# RabbitMQ
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USER=threatintel
RABBITMQ__PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ__EXCHANGE=tieto.fetches

# Provider legacy import (temporary; remove after encrypted-store verification)
# THREATFOX__APIKEY=CHANGE_ME_THREATFOX_API_KEY
# PHISHTANK__APPKEY=CHANGE_ME_PHISHTANK_APP_KEY

# Encrypted provider credential store. Root key is base64 for exactly 32 random bytes.
# Prefer a Docker/host secret file; do not commit the file or put its value in SQL Server.
ENCRYPTION__KEYVERSION=1
ENCRYPTION__ROOTKEYFILE=secrets/encryption-root-key

# Raw feed archive (original payloads written per provider/mode)
RAWSTORAGE__BASEPATH=data/providers

# Authentication (RSA private key is stored in a local PEM file)
JWT__PRIVATEKEYFILE=secrets/jwt-private-key.pem
JWT__ISSUER=ThreatIntelligence.Api
JWT__AUDIENCE=ThreatIntelligence.Client
JWT__EXPIRYMINUTES=480
AUTH__PASSWORDWORKFACTOR=12

# Initial administrator
ADMIN__USERNAME=admin
ADMIN__PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Structured logging
LOGGING__MINIMUMLEVEL=Information

# AI report generation (OpenAI-compatible). The Base URL, model ID, and enabled
# flag are administered at runtime via PUT /api/admin/ai/settings; the optional
# server API key is stored encrypted via PUT /api/admin/credentials/OpenAICompatible.ServerApiKey.
# The deployment option below is a non-secret compatibility read used to surface
# an initial draft in the Admin UI; the database-backed Admin values take
# precedence once saved.
# OPENAICOMPATIBLE__BASEURL=http://127.0.0.1:3002

# Nginx frontend host port (Compose only)
FRONTEND_PORT=3000

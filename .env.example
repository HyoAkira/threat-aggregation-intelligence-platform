# Copy this file to .env and replace each placeholder. Never commit .env.

# Compose database bootstrap (SQL Server requires a strong password).
SA_PASSWORD=CHANGE_ME_STRONG_SA_PASSWORD
TEST_SQLSERVER_PASSWORD=CHANGE_ME_STRONG_TEST_PASSWORD


# RabbitMQ
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USER=threatintel
RABBITMQ__PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ__EXCHANGE=tieto.fetches

# Providers
THREATFOX__APIKEY=CHANGE_ME_THREATFOX_API_KEY

# Authentication (at least 32 characters)
JWT__SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT__ISSUER=ThreatIntelligence.Api
JWT__AUDIENCE=ThreatIntelligence.Client
JWT__EXPIRYMINUTES=480
AUTH__PASSWORDWORKFACTOR=12

# Initial administrator
ADMIN__USERNAME=admin
ADMIN__PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Structured logging
LOGGING__MINIMUMLEVEL=Information

<file path="tests/ThreatIntelligence.IntegrationTests/FetchSchedulerTests.cs">
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using ThreatIntelligence.Application.Fetches;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Fetches;
using ThreatIntelligence.Infrastructure.Persistence;

namespace ThreatIntelligence.IntegrationTests;

[Collection("sqlserver")]
public sealed class FetchSchedulerTests(SqlServerFixture fixture) : IAsyncLifetime
{
    private readonly MutableTimeProvider _clock = new();

    public async Task InitializeAsync()
    {
        await fixture.ResetDataAsync();
        await using var context = fixture.CreateContext();
        await context.Database.ExecuteSqlRawAsync(
            "UPDATE providers SET nextFetchTime = NULL, lastFetchAt = NULL, lastFetchStatus = NULL, isEnabled = 1, intervalMinutes = CASE WHEN id = 1 THEN 5 ELSE 480 END;");
    }

    public Task DisposeAsync() => Task.CompletedTask;

    [Fact]
    public async Task Never_run_provider_is_not_scheduled()
    {
        var (scheduler, publisher) = CreateScheduler();

        Assert.Equal(0, await scheduler.TickAsync(CancellationToken.None));
        Assert.Empty(publisher.Jobs);
    }

    [Fact]
    public async Task Due_provider_is_published_and_next_fetch_time_advances()
    {
        var now = _clock.UtcNow;
        await SetProviderAsync(1, nextFetchTime: now.AddMinutes(-1));
        var (scheduler, publisher) = CreateScheduler();

        Assert.Equal(1, await scheduler.TickAsync(CancellationToken.None));
        Assert.Single(publisher.Jobs);
        Assert.Equal(FetchTrigger.Scheduled, publisher.Jobs[0].Trigger);
        Assert.Equal(FetchMode.Recent, publisher.Jobs[0].Mode);

        await using var context = fixture.CreateContext();
        var provider = await context.Providers.SingleAsync(item => item.Id == 1);
        Assert.Equal(now.AddMinutes(5), provider.NextFetchTime);
    }

    [Fact]
    public async Task Disabled_provider_is_not_scheduled()
    {
        var now = _clock.UtcNow;
        await SetProviderAsync(1, nextFetchTime: now.AddMinutes(-1), isEnabled: false);
        var (scheduler, publisher) = CreateScheduler();

        Assert.Equal(0, await scheduler.TickAsync(CancellationToken.None));
        Assert.Empty(publisher.Jobs);
    }

    [Fact]
    public async Task Duplicate_tick_does_not_double_publish()
    {
        var now = _clock.UtcNow;
        await SetProviderAsync(1, nextFetchTime: now.AddMinutes(-1));
        var (scheduler, publisher) = CreateScheduler();

        Assert.Equal(1, await scheduler.TickAsync(CancellationToken.None));
        Assert.Equal(0, await scheduler.TickAsync(CancellationToken.None));
        Assert.Single(publisher.Jobs);
    }

    [Fact]
    public async Task Publish_failure_marks_history_failed_and_still_advances_schedule()
    {
        var now = _clock.UtcNow;
        await SetProviderAsync(1, nextFetchTime: now.AddMinutes(-1));
        var (scheduler, _) = CreateScheduler(failPublish: true);

        Assert.Equal(0, await scheduler.TickAsync(CancellationToken.None));

        await using var context = fixture.CreateContext();
        var provider = await context.Providers.SingleAsync(item => item.Id == 1);
        Assert.Equal(now.AddMinutes(5), provider.NextFetchTime);
        Assert.Equal(FetchStatus.Failed, await context.FetchHistory.Select(history => history.Status).SingleAsync());
    }

    [Fact]
    public async Task Failed_fetch_does_not_reschedule_before_the_interval()
    {
        var now = _clock.UtcNow;
        await SetProviderAsync(1, nextFetchTime: now.AddMinutes(-1));
        var (scheduler, publisher) = CreateScheduler();

        Assert.Equal(1, await scheduler.TickAsync(CancellationToken.None));

        var lifecycle = new FetchLifecycle(fixture.CreateContextFactory(), _clock);
        await lifecycle.FailAsync(publisher.Jobs[0], "upstream failure", CancellationToken.None);

        Assert.Equal(0, await scheduler.TickAsync(CancellationToken.None));
        Assert.Single(publisher.Jobs);
    }

    private (FetchSchedulerService Scheduler, RecordingPublisher Publisher) CreateScheduler(bool failPublish = false)
    {
        var publisher = new RecordingPublisher(failPublish);
        var services = new ServiceCollection();
        services.AddSingleton<IDbContextFactory<ThreatIntelligenceDbContext>>(fixture.CreateContextFactory());
        services.AddSingleton<TimeProvider>(_clock);
        services.AddScoped<IFetchGuard, FetchGuard>();
        services.AddScoped<IFetchLifecycle, FetchLifecycle>();
        services.AddSingleton<IFetchJobPublisher>(publisher);
        var provider = services.BuildServiceProvider();
        var scheduler = new FetchSchedulerService(
            fixture.CreateContextFactory(), provider.GetRequiredService<IServiceScopeFactory>(), _clock);
        return (scheduler, publisher);
    }

    private async Task SetProviderAsync(int providerId, DateTime nextFetchTime, bool isEnabled = true)
    {
        await using var context = fixture.CreateContext();
        var provider = await context.Providers.SingleAsync(item => item.Id == providerId);
        provider.SetEnabled(isEnabled);
        provider.SetNextFetchTime(nextFetchTime);
        await context.SaveChangesAsync();
    }

    private sealed class MutableTimeProvider : TimeProvider
    {
        public DateTime UtcNow { get; } = new(2026, 9, 10, 12, 0, 0, DateTimeKind.Utc);

        public override DateTimeOffset GetUtcNow() => new(UtcNow, TimeSpan.Zero);
    }

    private sealed class RecordingPublisher(bool fail) : IFetchJobPublisher
    {
        public List<FetchJob> Jobs { get; } = [];

        public Task PublishAsync(FetchJob job, CancellationToken cancellationToken)
        {
            if (fail)
            {
                throw new InvalidOperationException("broker unavailable");
            }

            Jobs.Add(job);
            return Task.CompletedTask;
        }
    }
}
</file>

<file path="tests/ThreatIntelligence.IntegrationTests/IocBatchWriterTests.cs">
using Microsoft.EntityFrameworkCore;
using ThreatIntelligence.Application.BatchWriter;
using ThreatIntelligence.Application.Normalization;
using ThreatIntelligence.Application.ProviderRecords;
using ThreatIntelligence.Domain.Entities;
using ThreatIntelligence.Domain.Enums;
using ThreatIntelligence.Infrastructure.Hashing;
using ThreatIntelligence.Infrastructure.PhishTank;
using ThreatIntelligence.Infrastructure.Pipeline;
using ThreatIntelligence.Infrastructure.Persistence;
using ThreatIntelligence.Infrastructure.Persistence.Repositories;
using ThreatIntelligence.Infrastructure.PublicSuffix;

namespace ThreatIntelligence.IntegrationTests;

[Collection("sqlserver")]
public sealed class IocBatchWriterTests(SqlServerFixture fixture) : IAsyncLifetime
{
    private static readonly DateTime FirstSeen = new(2026, 1, 1, 0, 0, 0, DateTimeKind.Utc);
    private static readonly DateTime LastSeen = new(2026, 1, 2, 0, 0, 0, DateTimeKind.Utc);
    private static readonly Sha256ValueHasher Hasher = new();

    private readonly ProviderRecordValidator _validator = CreateValidator();

    public Task InitializeAsync() => fixture.ResetDataAsync();
    public Task DisposeAsync() => Task.CompletedTask;

    private IocBatchWriter CreateWriter()
    {
        var mapper = new PhishTankUpsertFieldsMapper(Hasher, TimeProvider.System);
        var mappers = new Dictionary<int, IIocUpsertFieldsMapper>
        {
            [PhishTankProviderValidator.PhishTankProviderId] = mapper
        };
        return new IocBatchWriter(fixture.CreateContext(), mappers);
    }

    private NormalizedProviderRecord Rec(
        string recordId,
        string value,
        DateTime? firstSeenUtc = null,
        DateTime? lastSeenUtc = null,
        bool? verified = null,
        string? target = null,
        IReadOnlyCollection<string?>? tags = null)
    {
        var input = new ProviderRecordInput(
            ProviderId: PhishTankProviderValidator.PhishTankProviderId,
            ProviderRecordId: recordId,
            RawIoc: value,
            DeclaredType: null,
            FirstSeenAt: firstSeenUtc ?? FirstSeen,
            LastSeenAt: lastSeenUtc ?? LastSeen,
            ProviderDetailsLink: null,
            Tags: tags,
            Metadata: verified is null && target is null
                ? null
                : new Dictionary<string, object?>
                {
                    [PhishTankRecordMapper.VerifiedKey] = verified,
                    [PhishTankRecordMapper.TargetKey] = target
                },
            Payload: null);

        var result = _validator.Validate(input, recordIndex: 1);
        Assert.True(result.IsValid, $"Record {recordId} should validate: {result.Failure?.Message}");
        return result.Normalized!;
    }

    private static ProviderRecordValidator CreateValidator()
    {
        var resolver = new PublicSuffixParentDomainResolver();
        var classifier = new IocClassifier(
            new Ipv4Normalizer(),
            new Ipv6Normalizer(),
            new UrlNormalizer(resolver),
            new DomainNormalizer(resolver));
        return new ProviderRecordValidator(
            classifier,
            new Dictionary<int, IProviderValidator>
            {
                [PhishTankProviderValidator.PhishTankProviderId] = new PhishTankProviderValidator()
            });
    }

    // --- TI-080 Identity resolution ------------------------------------------------

    [Fact]
    public async Task New_endpoint_identity_inserts_and_counts_added()
    {
        var writer = CreateWriter();
        var result = await writer.ApplyAsync(
            new[] { Rec("r1", "1.2.3.4"), Rec("r2", "10.0.0.2") },
            PhishTankProviderValidator.PhishTankProviderId,
            CancellationToken.None);

        Assert.Equal(2, result.Added);
        Assert.Equal(0, result.Updated);

        await using var context = fixture.CreateContext();
        Assert.Equal(2, await context.Iocs.CountAsync(i => i.ProviderId == 2));
    }

    [Fact]
    public async Task Existing_endpoint_identity_updates_stored_row_without_duplicating()
    {
        var writer = CreateWriter();
        var first = await writer.ApplyAsync(
            new[] { Rec("r1", "1.2.3.4") },
            PhishTankProviderValidator.PhishTankProviderId,
            CancellationToken.None);
        var second = await writer.ApplyAsync(
            new[] { Rec("r1", "1.2.3.4") },
            PhishTankProviderValidator.PhishTankProviderId,
            CancellationToken.None);

        Assert.Equal((1, 0), (first.Added, first.Updated));
        Assert.Equal((0, 1), (second.Added, second.Updated));

        await using var context = fixture.CreateContext();
        Assert.Equal(1, await context.Iocs.CountAsync(i => i.ProviderId == 2));
    }

    [Fact]
    public async Task Provider_record_id_is_authoritative_when_value_changes()
    {
        var writer = CreateWriter();
        await writer.ApplyAsync(
            new[] { Rec("r1", "1.2.3.4") },

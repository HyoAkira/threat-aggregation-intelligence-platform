<file path="src/ThreatIntelligence.Application/Features/Iocs/Queries/BulkSearchIocs/BulkSearchIocsHandler.cs">
using MediatR;
using ThreatIntelligence.Application.Abstractions.Persistence;
using ThreatIntelligence.Application.Normalization;

namespace ThreatIntelligence.Application.Features.Iocs.Queries.BulkSearchIocs;

/// <summary>
/// Evaluates a bounded list of IOC values as one request. Blank entries are removed, the remaining
/// values are trimmed, classified, and deduplicated for shared reader work, and the original order
/// is preserved in the response. A per-value invalid or absent outcome never fails the whole request.
/// </summary>
public sealed class BulkSearchIocsHandler(
    IIocClassifier classifier,
    IIocQueryReader reader) : IRequestHandler<BulkSearchIocsQuery, BulkSearchIocsResult>
{
    public async Task<BulkSearchIocsResult> Handle(
        BulkSearchIocsQuery request,
        CancellationToken cancellationToken)
    {
        var inputs = NormalizeInputs(request.Queries);
        var (page, pageSize) = IocSearchEvaluator.ResolvePageBounds(request.Page, request.PageSize);
        var provider = IocSearchEvaluator.NormalizeProvider(request.Provider);

        var identities = new List<NormalizationResult?>(inputs.Count);
        var errors = new List<BulkSearchProblem?>(inputs.Count);
        foreach (var input in inputs)
        {
            if (IocSearchEvaluator.TryClassify(classifier, input, out var identity, out var detail))
            {
                identities.Add(identity);
                errors.Add(null);
            }
            else
            {
                identities.Add(null);
                errors.Add(new BulkSearchProblem(IocErrorCodes.InvalidInput, detail));
            }
        }

        var distinct = identities
            .Where(identity => identity is not null)
            .Select(identity => identity!)
            .Distinct()
            .ToList();

        var resolved = distinct.Count == 0
            ? new Dictionary<NormalizationResult, PagedResult<IocGroupResult>>()
            : await reader.SearchBatchAsync(
                distinct,
                new IocSourceFilter(request.Tag, provider),
                page,
                pageSize,
                cancellationToken);

        var items = new List<BulkSearchIocItem>(inputs.Count);
        var matched = 0;
        var notFound = 0;
        var invalid = 0;
        for (var index = 0; index < inputs.Count; index++)
        {
            var identity = identities[index];
            if (identity is null)
            {
                invalid++;
                items.Add(new BulkSearchIocItem(
                    inputs[index],
                    BulkSearchStatus.Invalid,
                    [],
                    page,
                    pageSize,
                    0,
                    errors[index]));
                continue;
            }

            var paged = resolved.TryGetValue(identity, out var match)
                ? match
                : PagedResult<IocGroupResult>.Empty(page, pageSize);
            if (paged.TotalCount == 0)
            {
                notFound++;
                items.Add(new BulkSearchIocItem(
                    inputs[index],
                    BulkSearchStatus.NotFound,
                    [],
                    page,
                    pageSize,
                    0,
                    new BulkSearchProblem(
                        IocErrorCodes.NotFound,
                        $"No {IocTypeToken.ToToken(identity.Type)} IOC matches '{identity.IocValue}'.")));
                continue;
            }

            matched++;
            items.Add(new BulkSearchIocItem(
                inputs[index],
                BulkSearchStatus.Matched,
                paged.Items,
                paged.Page,
                paged.PageSize,
                paged.TotalCount,
                null));
        }

        return new BulkSearchIocsResult(items, inputs.Count, matched, notFound, invalid);
    }

    private static IReadOnlyList<string> NormalizeInputs(IReadOnlyList<string>? queries)
    {
        if (queries is null)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                "The queries field is required.");
        }

        var inputs = new List<string>(queries.Count);
        foreach (var raw in queries)
        {
            if (string.IsNullOrWhiteSpace(raw))
            {
                continue;
            }

            var trimmed = raw.Trim();
            if (trimmed.Length > BulkSearchLimits.MaxQueryLength)
            {
                throw new IocQueryValidationException(
                    IocErrorCodes.InvalidInput,
                    $"Each IOC value must be no longer than {BulkSearchLimits.MaxQueryLength} characters.");
            }

            inputs.Add(trimmed);
        }

        if (inputs.Count == 0)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                "At least one non-empty IOC value is required.");
        }

        if (inputs.Count > BulkSearchLimits.MaxQueries)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                $"A bulk search may contain at most {BulkSearchLimits.MaxQueries} non-empty IOC values.");
        }

        return inputs;
    }
}
</file>

<file path="src/ThreatIntelligence.Application/Features/Iocs/Queries/IocSearchEvaluator.cs">
using ThreatIntelligence.Application.Normalization;

namespace ThreatIntelligence.Application.Features.Iocs.Queries;

/// <summary>
/// Single source of truth for the IOC search request evaluation shared by the exact-search and
/// bulk-search handlers: page-bound validation, provider-filter normalization, and
/// classification/normalization of an input value. Keeping these rules here prevents the single and
/// bulk paths from drifting.
/// </summary>
public static class IocSearchEvaluator
{
    public const int DefaultPageSize = 20;
    public const int MaxPageSize = 100;

    /// <summary>Stored malware column capacity; filters longer than this are rejected.</summary>
    public const int MaxMalwareFilterLength = 200;

    /// <summary>Stored target column capacity; filters longer than this are rejected.</summary>
    public const int MaxTargetFilterLength = 500;

    /// <summary>Classifies a query, throwing the shared invalid-input validation failure.</summary>
    public static NormalizationResult RequireClassification(IIocClassifier classifier, string? query)
    {
        var classification = classifier.Classify(query ?? string.Empty);
        if (!classification.IsSuccess)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                classification.Error!.Message);
        }

        return classification.OrThrow();
    }

    /// <summary>
    /// Non-throwing classification used by bulk search: an unclassifiable value becomes a per-item
    /// invalid outcome instead of aborting the whole request.
    /// </summary>
    public static bool TryClassify(
        IIocClassifier classifier,
        string query,
        out NormalizationResult identity,
        out string errorDetail)
    {
        var classification = classifier.Classify(query);
        if (classification.IsSuccess)
        {
            identity = classification.Result!;
            errorDetail = string.Empty;
            return true;
        }

        identity = null!;
        errorDetail = classification.Error?.Message ?? ErrorMessages.InvalidInput;
        return false;
    }

    /// <summary>Applies the shared page defaults and inclusive bounds.</summary>
    public static (int Page, int PageSize) ResolvePageBounds(int? page, int? pageSize)
    {
        var resolvedPage = page ?? 1;
        var resolvedPageSize = pageSize ?? DefaultPageSize;
        if (resolvedPage < 1)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                "The page must be at least 1.");
        }

        if (resolvedPageSize is < 1 or > MaxPageSize)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                $"The pageSize must be between 1 and {MaxPageSize}.");
        }

        return (resolvedPage, resolvedPageSize);
    }

    /// <summary>Trims the optional provider filter and rejects an overlong value.</summary>
    public static string? NormalizeProvider(string? provider)
    {
        if (string.IsNullOrWhiteSpace(provider))
        {
            return null;
        }

        var trimmed = provider.Trim();
        if (trimmed.Length > 255)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                "The provider filter is too long.");
        }

        return trimmed;
    }

    /// <summary>
    /// Trims the optional malware filter, treats blank as absent, and rejects values beyond the
    /// stored column capacity. Comparison itself is case-insensitive and handled by the reader.
    /// </summary>
    public static string? NormalizeMalware(string? malware) =>
        NormalizeMetadataFilter(malware, MaxMalwareFilterLength, "malware");

    /// <summary>
    /// Trims the optional target filter, treats blank as absent, and rejects values beyond the
    /// stored column capacity. Comparison itself is case-insensitive and handled by the reader.
    /// </summary>
    public static string? NormalizeTarget(string? target) =>
        NormalizeMetadataFilter(target, MaxTargetFilterLength, "target");

    private static string? NormalizeMetadataFilter(string? value, int maxLength, string name)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var trimmed = value.Trim();
        if (trimmed.Length > maxLength)
        {
            throw new IocQueryValidationException(
                IocErrorCodes.InvalidInput,
                $"The {name} filter must be no longer than {maxLength} characters.");
        }

        return trimmed;
    }

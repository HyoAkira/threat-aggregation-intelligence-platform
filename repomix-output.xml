<file path="src/ThreatIntelligence.API/Mcp/McpMiddleware.cs">
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;
using System.Text.Json;

namespace ThreatIntelligence.API.Mcp;

/// <summary>
/// Middleware that applies rate limiting and validation to MCP requests.
/// </summary>
public sealed class McpMiddleware(
    RequestDelegate next,
    IOptions<McpConfiguration> configuration,
    ILogger<McpMiddleware> logger)
{
    private const int MaxRequestSize = 1_000_000;

    public async Task InvokeAsync(HttpContext context, McpRateLimiter rateLimiter)
    {
        // Only apply to /mcp path
        if (!context.Request.Path.StartsWithSegments("/mcp"))
        {
            await next(context);
            return;
        }

        var config = configuration.Value;
        if (!config.Enabled)
        {
            context.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        if (config.AcceptedHosts.Count > 0 &&
            !config.AcceptedHosts.Contains(context.Request.Host.Host, StringComparer.OrdinalIgnoreCase))
        {
            context.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        var origin = context.Request.Headers.Origin.ToString();
        if (!string.IsNullOrWhiteSpace(origin) &&
            (config.AllowedOrigins.Count == 0 || !config.AllowedOrigins.Contains(origin, StringComparer.OrdinalIgnoreCase)))
        {
            context.Response.StatusCode = StatusCodes.Status403Forbidden;
            return;
        }

        // Extract client ID for rate limiting.
        var clientId = McpRateLimiter.ExtractClientId(context.Request, config.TrustedProxyIps);

        // Apply rate limiting
        var (scope, retryAfter) = await rateLimiter.TryAcquireAsync(clientId, context.RequestAborted);
        if (scope is null)
        {
            logger.LogWarning("MCP rate limit exceeded for client {ClientId}", clientId);
            context.Response.StatusCode = StatusCodes.Status429TooManyRequests;
            context.Response.Headers["Retry-After"] = Math.Max(1, (int)retryAfter).ToString();
            context.Response.ContentType = "application/json";
            await context.Response.WriteAsJsonAsync(new
            {
                error = "rate_limit_exceeded",
                message = "Too many MCP requests. Please try again later.",
                retryAfterSeconds = retryAfter
            }, context.RequestAborted);
            return;
        }

        using (scope)
        {
            // Check request size limit
            if (context.Request.ContentLength > MaxRequestSize)
            {
                logger.LogWarning("MCP request too large from client {ClientId}: {Size} bytes", clientId, context.Request.ContentLength);
                context.Response.StatusCode = StatusCodes.Status413PayloadTooLarge;
                context.Response.ContentType = "application/json";
                await context.Response.WriteAsJsonAsync(new
                {
                    error = "payload_too_large",
                    message = $"The request body exceeds the maximum size of {MaxRequestSize} bytes."
                }, context.RequestAborted);
                return;
            }

            // Set timeout for MCP requests
            using var timeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            using var requestCts = CancellationTokenSource.CreateLinkedTokenSource(
                context.RequestAborted,
                timeoutCts.Token);
            var originalRequestAborted = context.RequestAborted;
            context.RequestAborted = requestCts.Token;
            try
            {
                logger.LogDebug("MCP request from client {ClientId}", clientId);
                await next(context);
            }
            catch (OperationCanceledException) when (timeoutCts.IsCancellationRequested)
            {
                logger.LogWarning("MCP request timed out for client {ClientId}", clientId);
                if (!context.Response.HasStarted)
                {
                    context.Response.StatusCode = StatusCodes.Status504GatewayTimeout;
                    context.Response.ContentType = "application/json";
                    await context.Response.WriteAsJsonAsync(new
                    {
                        error = "request_timeout",
                        message = "The MCP request timed out after 30 seconds."
                    }, CancellationToken.None);
                }
            }
            catch (JsonException ex)
            {
                logger.LogWarning(ex, "Invalid JSON in MCP request from client {ClientId}", clientId);
                if (!context.Response.HasStarted)
                {
                    context.Response.StatusCode = StatusCodes.Status400BadRequest;
                    context.Response.ContentType = "application/json";
                    await context.Response.WriteAsJsonAsync(new
                    {
                        error = "invalid_json",
                        message = "The request body contains invalid JSON."
                    }, context.RequestAborted);
                }
            }
            catch (McpToolException ex)
            {
                logger.LogWarning("MCP tool error from client {ClientId}: {Code} - {Message}", clientId, ex.Code, ex.Message);
                if (!context.Response.HasStarted)
                {
                    context.Response.StatusCode = StatusCodes.Status400BadRequest;
                    context.Response.ContentType = "application/json";
                    await context.Response.WriteAsJsonAsync(new
                    {
                        error = ex.Code,
                        message = ex.Message
                    }, context.RequestAborted);
                }
            }
            finally
            {
                context.RequestAborted = originalRequestAborted;
            }
        }
    }
}
</file>

<file path="src/ThreatIntelligence.API/Mcp/McpRateLimiter.cs">
using System.Threading.RateLimiting;

namespace ThreatIntelligence.API.Mcp;

/// <summary>Holds leases for an MCP request; disposing releases concurrency slots.</summary>
public sealed class McpRequestScope : IDisposable
{
    private readonly RateLimitLease? _requestLease;
    private readonly RateLimitLease _clientConcurrencyLease;
    private readonly RateLimitLease _hostConcurrencyLease;
    private readonly RateLimitLease _hostRequestLease;

    internal McpRequestScope(
        RateLimitLease? requestLease,
        RateLimitLease clientConcurrencyLease,
        RateLimitLease hostConcurrencyLease,
        RateLimitLease hostRequestLease)
    {
        _requestLease = requestLease;
        _clientConcurrencyLease = clientConcurrencyLease;
        _hostConcurrencyLease = hostConcurrencyLease;
        _hostRequestLease = hostRequestLease;
    }

    public void Dispose()
    {
        _hostConcurrencyLease.Dispose();
        _clientConcurrencyLease.Dispose();
        _hostRequestLease.Dispose();
        _requestLease?.Dispose();
    }
}

/// <summary>
/// Rate limiter for the public MCP endpoint.
/// Enforces per-client and host-wide request and concurrency limits.
/// Uses trusted proxy handling for client IP extraction.
/// </summary>
public sealed class McpRateLimiter : IDisposable
{
    private readonly McpConfiguration _config;
    private readonly PartitionedRateLimiter<string> _clientRequestLimiter;
    private readonly PartitionedRateLimiter<string> _clientConcurrencyLimiter;
    private readonly ConcurrencyLimiter _hostConcurrencyLimiter;
    private readonly PartitionedRateLimiter<string> _hostRequestLimiter;

    public McpRateLimiter(McpConfiguration config)
    {
        _config = config;

        _clientRequestLimiter = PartitionedRateLimiter.Create<string, string>(clientId =>
            RateLimitPartition.GetSlidingWindowLimiter(
                clientId,
                _ => new SlidingWindowRateLimiterOptions
                {
                    PermitLimit = _config.MaxRequestsPerClientPerWindow,
                    Window = _config.RequestWindow,
                    SegmentsPerWindow = 4,
                    QueueLimit = 0
                }));

        _clientConcurrencyLimiter = PartitionedRateLimiter.Create<string, string>(clientId =>
            RateLimitPartition.GetConcurrencyLimiter(
                clientId,
                _ => new ConcurrencyLimiterOptions
                {
                    PermitLimit = _config.MaxConcurrentRequestsPerClient,
                    QueueLimit = 0
                }));

        _hostConcurrencyLimiter = new ConcurrencyLimiter(new ConcurrencyLimiterOptions
        {
            PermitLimit = _config.MaxConcurrentRequestsHost,
            QueueLimit = 0
        });

        _hostRequestLimiter = PartitionedRateLimiter.Create<string, string>(_ =>
            RateLimitPartition.GetSlidingWindowLimiter(
                "host",
                _ => new SlidingWindowRateLimiterOptions
                {
                    PermitLimit = _config.MaxRequestsHostPerWindow,
                    Window = _config.RequestWindow,
                    SegmentsPerWindow = 4,
                    QueueLimit = 0
                }));
    }

    /// <summary>
    /// Attempts to acquire a rate limit slot for an MCP request.
    /// Returns the scope if successful, or null with retry-after seconds if denied.
    /// </summary>
    public async Task<(McpRequestScope? Scope, double RetryAfterSeconds)> TryAcquireAsync(
        string clientId,
        CancellationToken cancellationToken)
    {
        var requestLease = await _clientRequestLimiter.AcquireAsync(clientId, 1, cancellationToken);
        if (!requestLease.IsAcquired)
        {
            var retry = requestLease.TryGetMetadata(MetadataName.RetryAfter, out var retryValue) && retryValue is TimeSpan span
                ? span.TotalSeconds
                : _config.RequestWindow.TotalSeconds;
            requestLease.Dispose();
            return (null, retry);
        }

        var clientConcurrencyLease = await _clientConcurrencyLimiter.AcquireAsync(clientId, 1, cancellationToken);
        if (!clientConcurrencyLease.IsAcquired)
        {
            clientConcurrencyLease.Dispose();
            requestLease.Dispose();
            return (null, 5.0);
        }

        var hostConcurrencyLease = await _hostConcurrencyLimiter.AcquireAsync(1, cancellationToken);
        if (!hostConcurrencyLease.IsAcquired)
        {
            hostConcurrencyLease.Dispose();
            clientConcurrencyLease.Dispose();
            requestLease.Dispose();
            return (null, 5.0);
        }

        // Also check host request limit
        var hostRequestLease = await _hostRequestLimiter.AcquireAsync("host", 1, cancellationToken);
        if (!hostRequestLease.IsAcquired)
        {
            hostRequestLease.Dispose();
            hostConcurrencyLease.Dispose();
            clientConcurrencyLease.Dispose();
            requestLease.Dispose();
            return (null, 5.0);
        }

        return (new McpRequestScope(requestLease, clientConcurrencyLease, hostConcurrencyLease, hostRequestLease), 0);
    }

    /// <summary>Extracts the client IP from the request, handling trusted proxies.</summary>
    public static string ExtractClientId(HttpRequest request, IReadOnlyList<string> trustedProxyIps)
    {
        // Check if the request came through a trusted proxy
        if (trustedProxyIps.Count > 0)
        {
            var remoteIp = request.HttpContext.Connection.RemoteIpAddress;
            if (remoteIp is not null && trustedProxyIps.Any(proxy =>
                proxy.Equals(remoteIp.ToString(), StringComparison.OrdinalIgnoreCase) ||
                proxy.Equals(remoteIp.MapToIPv6().ToString(), StringComparison.OrdinalIgnoreCase)))
            {
                // Use X-Forwarded-For header, but only the first untrusted IP
                if (request.Headers.TryGetValue("X-Forwarded-For", out var forwardedFor) &&
                    !string.IsNullOrWhiteSpace(forwardedFor))
                {
                    // Parse the chain and find the first client IP
                    var addresses = forwardedFor.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    if (addresses.Length > 0)
                    {
                        // The leftmost IP is the original client
                        return addresses[0];
                    }
                }
            }
        }

        // Fall back to remote IP
        return request.HttpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";
    }

    public void Dispose()
    {
        _clientRequestLimiter.Dispose();
        _clientConcurrencyLimiter.Dispose();
        _hostConcurrencyLimiter.Dispose();
        _hostRequestLimiter.Dispose();
    }
}
</file>

<file path="src/ThreatIntelligence.API/Mcp/PublicIocMcpServer.cs">
using System.ComponentModel;
using System.Threading;
using ModelContextProtocol.Server;
using MediatR;
using Microsoft.Extensions.Logging;
using ThreatIntelligence.Application.Features.Iocs.Queries.BrowseIocs;
using ThreatIntelligence.Application.Features.Iocs.Queries.GetIocRelations;
using ThreatIntelligence.Application.Features.Iocs.Queries.SearchIocs;
using ThreatIntelligence.Application.Features.Iocs.Queries;
using ThreatIntelligence.Application.Abstractions.Persistence;

namespace ThreatIntelligence.API.Mcp;

[Description("Public IOC MCP server - read-only indicator investigation tools")]
[McpServerToolType]
public sealed partial class PublicIocMcpServer(
    ISender mediator,
    IIocQueryReader queryReader,
    ILogger<PublicIocMcpServer> logger)
{
    [McpServerTool(Name = "ioc_list_providers", ReadOnly = true)]
    [Description("Returns the list of all provider names that contribute IOC data.")]
    public async Task<IReadOnlyList<string>> ListProvidersAsync(CancellationToken cancellationToken)
    {
        logger.LogDebug("MCP tool ioc_list_providers invoked");
        var providers = await queryReader.GetProviderNamesAsync(cancellationToken);
        logger.LogDebug("MCP tool ioc_list_providers returned {Count} providers", providers.Count);
        return providers;
    }

    [McpServerTool(Name = "ioc_search_exact", ReadOnly = true)]
    [Description("Searches for IOC groups matching an exact value.")]
    public async Task<PagedIocGroups> SearchExactAsync(
        [Description("The IOC value to search for (IP address, domain, or URL)")] string query,
        [Description("Optional tag filter")] string? tag = null,
        [Description("Optional provider name filter")] string? provider = null,
        [Description("Optional malware filter (at most 200 characters)")] string? malware = null,
        [Description("Optional target filter (at most 500 characters)")] string? target = null,
        [Description("Page number (1-based)")] int page = 1,
        [Description("Number of items per page (1-100)")] int pageSize = 20,
        CancellationToken cancellationToken = default)
    {
        logger.LogDebug("MCP tool ioc_search_exact invoked: query={Query}, page={Page}, pageSize={PageSize}", query, page, pageSize);
        if (string.IsNullOrWhiteSpace(query) || query.Length > 2048)
        {
            throw new McpToolException("invalid_input", "The IOC query must contain at most 2048 characters.");
        }
        ValidatePage(page, pageSize);

        var malwareFilter = NormalizeMetadataFilter(malware, IocSearchEvaluator.MaxMalwareFilterLength, "malware");
        var targetFilter = NormalizeMetadataFilter(target, IocSearchEvaluator.MaxTargetFilterLength, "target");

        var result = await mediator.Send(
            new SearchIocsQuery(query, tag, provider, page, pageSize, malwareFilter, targetFilter),
            cancellationToken);
        logger.LogDebug("MCP tool ioc_search_exact returned {Count} items", result.Items.Count);
        return MapPagedResult(result);
    }

    [McpServerTool(Name = "ioc_get_detail", ReadOnly = true)]
    [Description("Returns full details for an IOC group by its database id.")]
    public async Task<IocGroup> GetDetailAsync(
        [Description("The database id of the IOC group")] int id,
        CancellationToken cancellationToken = default)
    {
        logger.LogDebug("MCP tool ioc_get_detail invoked: id={Id}", id);
        if (id <= 0)
        {
            throw new McpToolException("invalid_input", "The IOC id must be a positive integer.");
        }
        var group = await queryReader.GetDetailGroupAsync(id, cancellationToken);
        if (group is null)
        {
            throw new McpToolException("not_found", $"No IOC row exists with id {id}.");
        }
        logger.LogDebug("MCP tool ioc_get_detail returned group {Id}", id);
        return MapGroup(group);
    }

    [McpServerTool(Name = "ioc_browse", ReadOnly = true)]
    [Description("Browses IOC groups with optional filters and pagination.")]
    public async Task<PagedIocGroups> BrowseAsync(
        [Description("IOC type filter: ipv4, ipv6, domain, or url")] string? type = null,
        [Description("Provider name filter")] string? provider = null,
        [Description("Tag filter")] string? tag = null,
        [Description("Optional malware filter (at most 200 characters)")] string? malware = null,
        [Description("Optional target filter (at most 500 characters)")] string? target = null,
        [Description("Filter first seen from (ISO 8601 UTC)")] string? firstSeenFrom = null,
        [Description("Filter first seen to (ISO 8601 UTC)")] string? firstSeenTo = null,
        [Description("Filter last seen from (ISO 8601 UTC)")] string? lastSeenFrom = null,
        [Description("Filter last seen to (ISO 8601 UTC)")] string? lastSeenTo = null,
        [Description("Sort field")] string? orderBy = null,
        [Description("Sort direction: asc or desc")] string? dir = null,
        [Description("Page number (1-based)")] int page = 1,
        [Description("Number of items per page (1-100)")] int pageSize = 20,
        CancellationToken cancellationToken = default)
    {
        logger.LogDebug("MCP tool ioc_browse invoked: page={Page}, pageSize={PageSize}", page, pageSize);
        ValidatePage(page, pageSize);

        var malwareFilter = NormalizeMetadataFilter(malware, IocSearchEvaluator.MaxMalwareFilterLength, "malware");
        var targetFilter = NormalizeMetadataFilter(target, IocSearchEvaluator.MaxTargetFilterLength, "target");

        var result = await mediator.Send(new BrowseIocsQuery(
            type, provider, tag,
            ParseDateTime(firstSeenFrom), ParseDateTime(firstSeenTo),
            ParseDateTime(lastSeenFrom), ParseDateTime(lastSeenTo),
            orderBy, dir, page, pageSize, malwareFilter, targetFilter), cancellationToken);
        logger.LogDebug("MCP tool ioc_browse returned {Count} items", result.Items.Count);
        return MapPagedResult(result);
    }

    [McpServerTool(Name = "ioc_get_relations", ReadOnly = true)]
    [Description("Returns related IOC groups for a given IOC by host or metadata relationship.")]
    public async Task<PagedIocGroups> GetRelationsAsync(
        [Description("The database id of the IOC group")] int id,
        [Description("Relation type: urlHost, parentDomain, malware, or target")] string relation,
        [Description("Page number (1-based)")] int page = 1,
        [Description("Number of items per page (1-100)")] int pageSize = 20,
        CancellationToken cancellationToken = default)
    {
        logger.LogDebug("MCP tool ioc_get_relations invoked: id={Id}, relation={Relation}", id, relation);
        if (id <= 0)
        {
            throw new McpToolException("invalid_input", "The IOC id must be a positive integer.");
        }
        ValidatePage(page, pageSize);
        var relationKind = ParseRelationKind(relation);
        var result = await mediator.Send(new GetIocRelationsQuery(id, relationKind.ToString(), page, pageSize), cancellationToken);
        if (result is null)
        {
            throw new McpToolException("not_found", $"No IOC row exists with id {id}.");
        }
        logger.LogDebug("MCP tool ioc_get_relations returned {Count} items", result.Items.Count);
        return MapPagedResult(result);
    }

    private static IocRelationKind ParseRelationKind(string relation) =>
        relation.ToLowerInvariant() switch
        {
            "urlhost" => IocRelationKind.UrlHost,
            "parentdomain" => IocRelationKind.ParentDomain,
            "malware" => IocRelationKind.Malware,
            "target" => IocRelationKind.Target,
            _ => throw new McpToolException("invalid_input", "The relation must be urlHost, parentDomain, malware, or target.")
        };

    private static string? NormalizeMetadataFilter(string? value, int maxLength, string name)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var trimmed = value.Trim();
        if (trimmed.Length > maxLength)
        {
            throw new McpToolException(
                "invalid_input",
                $"The {name} filter must be no longer than {maxLength} characters.");
        }

        return trimmed;
    }

    private static DateTime? ParseDateTime(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null :
        DateTime.TryParse(value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed)
            ? parsed
            : throw new McpToolException("invalid_input", "The date value is not a valid ISO 8601 UTC datetime.");

    private static void ValidatePage(int page, int pageSize)
    {
        if (page < 1 || pageSize is < 1 or > 100)
            throw new McpToolException("invalid_input", "Page must be at least 1 and pageSize must be between 1 and 100.");
    }

    private static PagedIocGroups MapPagedResult(PagedResult<IocGroupResult> result) =>
        new(
            result.Items.Select(MapGroup).ToList(),
            result.Page,
            result.PageSize,
            result.TotalCount,
            result.TotalCount > (long)result.Page * result.PageSize,
            Math.Max(0, result.TotalCount - (long)result.Page * result.PageSize));

    private static IocGroup MapGroup(IocGroupResult group) =>
        new(group.Id, group.IocValue, group.IocType.ToString().ToLowerInvariant(),
            group.UrlHost, group.ParentDomain,
            group.FirstSeenUtc.ToString("o"), group.LastSeenUtc?.ToString("o"),
            group.Sources.Select(MapSource).ToList());

    private static IocSource MapSource(IocSourceResult source) =>
        new(source.Provider, source.ProviderRecordId, source.ProviderDetailsLink, source.Port,
            source.FirstSeenUtc.ToString("o"), source.LastSeenUtc?.ToString("o"),
            source.ThreatType, source.Malware, source.MalwareAlias, source.MalwarePrintable,
            source.IsCompromised, source.Reporter, source.Anonymous, source.IsVerified, source.Target,
            source.Tags.ToList(), source.IsFalsePositive);
}

public sealed class McpToolException(string code, string message) : Exception(message)
{
    public string Code { get; } = code;
}

public sealed record PagedIocGroups(
    IReadOnlyList<IocGroup> items,
    int page,
    int pageSize,
    int totalCount,
    bool isTruncated,
    long omittedCount);
public sealed record IocGroup(int id, string iocValue, string iocType, string? urlHost, string? parentDomain,
    string firstSeenUtc, string? lastSeenUtc, IReadOnlyList<IocSource> sources);
public sealed record IocSource(string provider, string providerRecordId, string? providerDetailsLink, int? port,
    string firstSeenUtc, string? lastSeenUtc, string? threatType, string? malware, string? malwareAlias,
    string? malwarePrintable, bool? isCompromised, string? reporter, bool? anonymous, bool? isVerified,
    string? target, IReadOnlyList<string> tags, bool isFalsePositive);
</file>

<file path="src/ThreatIntelligence.API/Serialization/UtcDateTimeJsonConverter.cs">
using System.Globalization;
using System.Text.Json;
using System.Text.Json.Serialization;

namespace ThreatIntelligence.API.Serialization;

/// <summary>
/// Serializes every <see cref="DateTime"/> as an explicit UTC instant. SQL Server <c>datetime2</c>
/// columns do not preserve <see cref="DateTimeKind"/>, so EF Core materializes stored UTC values as
/// <see cref="DateTimeKind.Unspecified"/>. Without this converter System.Text.Json would omit the
/// trailing <c>Z</c> and clients would misread the value as local time. The value is always UTC by
/// contract (<c>Guard.Utc</c> enforces it on write).
/// </summary>
public sealed class UtcDateTimeJsonConverter : JsonConverter<DateTime>
{
    public override DateTime Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
    {
        if (reader.TokenType != JsonTokenType.String)
        {
            throw new JsonException($"Expected a UTC date-time string but found {reader.TokenType}.");
        }

        var value = reader.GetString();
        if (string.IsNullOrWhiteSpace(value))
        {
            throw new JsonException("Expected a UTC date-time string but found an empty value.");
        }

        var parsed = DateTime.Parse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);
        return ToUtc(parsed);
    }

    public override void Write(Utf8JsonWriter writer, DateTime value, JsonSerializerOptions options)
        => writer.WriteStringValue(ToUtc(value));

    /// <summary>
    /// Maps any <see cref="DateTimeKind"/> onto the same instant expressed as UTC. Unspecified values
    /// are treated as UTC without shifting the clock value; local values are converted correctly.
    /// </summary>
    internal static DateTime ToUtc(DateTime value) => value.Kind switch
    {
        DateTimeKind.Utc => value,
        DateTimeKind.Local => value.ToUniversalTime(),
        _ => DateTime.SpecifyKind(value, DateTimeKind.Utc),
    };
}

/// <summary>
/// Nullable companion to <see cref="UtcDateTimeJsonConverter"/>. Nulls remain governed by the shared
/// <c>WhenWritingNull</c> policy configured in <see cref="ApiJson"/>.
/// </summary>
public sealed class NullableUtcDateTimeJsonConverter : JsonConverter<DateTime?>
{
    public override DateTime? Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
    {
        if (reader.TokenType == JsonTokenType.Null)
        {
            return null;
        }

        return new UtcDateTimeJsonConverter().Read(ref reader, typeof(DateTime), options);
    }

    public override void Write(Utf8JsonWriter writer, DateTime? value, JsonSerializerOptions options)
    {
        if (value is null)
        {
            writer.WriteNullValue();
            return;
        }

        writer.WriteStringValue(UtcDateTimeJsonConverter.ToUtc(value.Value));
    }
}
</file>


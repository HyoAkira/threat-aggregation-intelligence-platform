<file path="frontend/src/lib/adminDataTables.ts">
export type AdminDataTablesOrder = {
  column?: number | string
  name?: string | null
  dir?: string
}

export type AdminDataTablesRequest = {
  draw?: number
  start?: number
  length?: number
  order?: AdminDataTablesOrder[]
}

export type AdminDataTablesResponse<T> = {
  draw: number
  data: T[]
  recordsTotal: number
  recordsFiltered: number
}

export function emptyAdminDataTablesResponse<T>(
  draw: number,
): AdminDataTablesResponse<T> {
  return { draw, data: [], recordsTotal: 0, recordsFiltered: 0 }
}

export function dateRangeQuery(
  dateFrom: string,
  dateTo: string,
): { dateFrom: string | null; dateTo: string | null } {
  return {
    dateFrom: localDateBoundary(dateFrom, false),
    dateTo: localDateBoundary(dateTo, true),
  }
}

/**
 * Converts a browser date input into an ISO instant. The end value is
 * exclusive and advances one local calendar day, so DST transitions do not
 * turn a selected local date into the wrong UTC range.
 */
function localDateBoundary(
  value: string,
  endExclusive: boolean,
): string | null {
  const trimmed = value.trim()
  if (!trimmed) return null

  const date = new Date(`${trimmed}T00:00:00`)
  if (Number.isNaN(date.getTime())) return null
  if (endExclusive) date.setDate(date.getDate() + 1)
  return date.toISOString()
}
</file>

<file path="frontend/src/lib/apiErrors.ts">
import { z } from 'zod'

/** RFC 9457 problem detail as produced by the API error contract. */
export const apiProblemSchema = z.object({
  type: z.string().optional(),
  title: z.string().optional(),
  status: z.number().int().optional(),
  detail: z.string().optional(),
  code: z.string(),
  correlationId: z.string().nullable().optional(),
})

export type ApiProblem = z.infer<typeof apiProblemSchema>

/**
 * Error thrown for every non-success API response, response-validation failure, or
 * client-side session failure. Carries the machine-readable `code`, HTTP `status`,
 * and the request `correlationId` so UI states can classify and surface them.
 */
export class ApiError extends Error {
  readonly status: number
  readonly code: string
  readonly correlationId?: string
  readonly problem?: ApiProblem

  constructor(
    status: number,
    code: string,
    message: string,
    correlationId?: string,
    problem?: ApiProblem,
  ) {
    super(message)
    this.name = 'ApiError'
    this.status = status
    this.code = code
    this.correlationId = correlationId
    this.problem = problem
  }
}

/** Only unexpected server/network failures are retried automatically; 4xx never retries. */
export function isRetryableApiError(
  error: unknown,
  failureCount: number,
): boolean {
  if (failureCount >= 2) return false
  if (error instanceof ApiError) return error.status >= 500
  return true
}
</file>


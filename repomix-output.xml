<file path="frontend/src/routes/admin.settings.tsx">
import { useQuery, useQueryClient } from '@tanstack/react-query'
import { createFileRoute, Link, useBlocker } from '@tanstack/react-router'
import { useCallback, useEffect, useRef, useState } from 'react'
import type { ReactNode } from 'react'
import { z } from 'zod'
import { focusRingClass } from '../components/AppShell'
import { AdminAiSettings } from '../components/AdminAiSettings'
import { AdminIocChatSettings } from '../components/AdminIocChatSettings'
import { ErrorState, LoadingState } from '../components/uiStates'
import type {
  ProviderSettingRequest,
  SettingsResponse,
  SupportedLogLevel,
} from '../lib/adminSchemas'
import { supportedLogLevels } from '../lib/adminSchemas'
import {
  ApiError,
  clearAdminCredential,
  getAdminCredential,
  getAdminSettings,
  putAdminCredential,
  putAdminSettings,
} from '../lib/apiClient'
import {
  adminCredentialKey,
  adminProviderListKey,
  adminSettingsKey,
} from '../lib/queryKeys'

export const Route = createFileRoute('/admin/settings')({
  validateSearch: z.object({
    section: z.enum(['runtime', 'ai', 'chat']).optional(),
  }),
  component: AdminSettingsPage,
})

/* -------------------------------------------------------------------------- */
/*  Draft type                                                               */
/* -------------------------------------------------------------------------- */

type ProviderDraft = {
  id: number
  name: string
  isEnabled: boolean
  intervalMinutes: number
  minimumIntervalMinutes: number
  requiresApiKey: boolean
}

type Draft = {
  logLevel: SupportedLogLevel
  providers: ProviderDraft[]
}

const credentialIdentities = [
  ['ThreatFox', 'ThreatFox.ApiKey'],
  ['PhishTank', 'PhishTank.AppKey'],
] as const

type CredentialFeedback = {
  kind: 'success' | 'error'
  message: string
}

function baselineToDraft(baseline: SettingsResponse): Draft {
  return {
    logLevel: baseline.logLevel as SupportedLogLevel,
    providers: baseline.providers.map((p) => ({
      id: p.id,
      name: p.name,
      isEnabled: p.isEnabled,
      intervalMinutes: p.intervalMinutes,
      minimumIntervalMinutes: p.minimumIntervalMinutes,
      requiresApiKey: p.requiresApiKey,
    })),
  }
}

function draftToRequest(draft: Draft): {
  logLevel: string
  providers: ProviderSettingRequest[]
} {
  return {
    logLevel: draft.logLevel,
    providers: draft.providers.map((p) => ({
      id: p.id,
      isEnabled: p.isEnabled,
      intervalMinutes: p.intervalMinutes,
      requiresApiKey: p.requiresApiKey,
    })),
  }
}

function isDirty(baseline: Draft, draft: Draft): boolean {
  if (baseline.logLevel !== draft.logLevel) return true
  if (baseline.providers.length !== draft.providers.length) return true
  for (let i = 0; i < baseline.providers.length; i++) {
    const b = baseline.providers[i]
    const d = draft.providers[i]
    if (
      b.id !== d.id ||
      b.isEnabled !== d.isEnabled ||
      b.intervalMinutes !== d.intervalMinutes ||
      b.requiresApiKey !== d.requiresApiKey
    ) {
      return true
    }
  }
  return false
}

/* -------------------------------------------------------------------------- */
/*  Validation                                                               */
/* -------------------------------------------------------------------------- */

type FieldErrors = {
  logLevel?: string
  providers?: Record<number, { interval?: string }>
}

function validateDraft(draft: Draft): FieldErrors {
  const errors: FieldErrors = {}

  if (!supportedLogLevels.includes(draft.logLevel)) {
    errors.logLevel = `Must be one of: ${supportedLogLevels.join(', ')}`
  }

  const providerErrors: Record<number, { interval?: string }> = {}
  for (const p of draft.providers) {
    if (p.intervalMinutes < p.minimumIntervalMinutes) {
      providerErrors[p.id] = {
        interval: `Minimum interval is ${p.minimumIntervalMinutes} minutes`,
      }
    }
  }
  if (Object.keys(providerErrors).length > 0) {
    errors.providers = providerErrors
  }

  return errors
}

function hasErrors(errors: FieldErrors): boolean {
  if (errors.logLevel) return true
  if (errors.providers) {
    for (const key of Object.keys(errors.providers)) {
      const pe = errors.providers[key as unknown as number]
      if (pe.interval) return true
    }
  }
  return false
}

/* -------------------------------------------------------------------------- */
/*  Page component                                                           */
/* -------------------------------------------------------------------------- */

const settingsTabBaseClass =
  'px-3 py-2 font-mono text-[11px] font-semibold uppercase tracking-wider rounded transition-[background-color,box-shadow,color]'
const settingsTabActiveClass = `${settingsTabBaseClass} bg-primary text-on-primary`
const settingsTabInactiveClass = `${settingsTabBaseClass} text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface hover:shadow-sm`

function AdminSettingsPage() {
  const search = Route.useSearch()

  return (
    <div>
      <div>
        <h2 className="text-lg font-semibold text-on-surface">Settings</h2>
        <p className="mt-0.5 text-sm text-on-surface-variant">
          Manage runtime behavior, AI analysis, and IOC chat configuration.
        </p>
      </div>

      <nav
        aria-label="Settings sections"
        className="mt-4 flex flex-wrap gap-1 border-b border-outline-variant"
      >
        <SettingsSectionLink section="runtime">Runtime</SettingsSectionLink>
        <SettingsSectionLink section="ai">AI analysis</SettingsSectionLink>
        <SettingsSectionLink section="chat">IOC chat</SettingsSectionLink>
      </nav>

      {search.section === 'ai' ? (
        <AdminAiSettings />
      ) : search.section === 'chat' ? (
        <AdminIocChatSettings />
      ) : (
        <RuntimeSettingsPanel />
      )}
    </div>
  )
}

function SettingsSectionLink({
  section,
  children,
}: {
  section: 'runtime' | 'ai' | 'chat'
  children: ReactNode
}) {
  const currentSection = Route.useSearch().section ?? 'runtime'
  const isActive = currentSection === section
  return (
    <Link
      to="/admin/settings"
      search={{ section }}
      className={`${isActive ? settingsTabActiveClass : settingsTabInactiveClass} ${focusRingClass} -mb-px`}
      aria-current={isActive ? 'page' : undefined}
    >
      {children}
    </Link>
  )
}

function RuntimeSettingsPanel() {
  const queryClient = useQueryClient()
  const [draft, setDraft] = useState<Draft | null>(null)
  const [baseline, setBaseline] = useState<Draft | null>(null)
  const [fieldErrors, setFieldErrors] = useState<FieldErrors>({})
  const [saveError, setSaveError] = useState<string | null>(null)
  const [saveSuccess, setSaveSuccess] = useState(false)
  const [isSaving, setIsSaving] = useState(false)
  const [credentialDrafts, setCredentialDrafts] = useState<
    Record<string, string>
  >({})
  const [credentialBusy, setCredentialBusy] = useState<string | null>(null)
  const [credentialFeedback, setCredentialFeedback] =
    useState<CredentialFeedback | null>(null)
  const saveTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null)

  const {
    data: settings,
    isLoading,
    isError,
    error,
  } = useQuery({
    queryKey: adminSettingsKey(),
    queryFn: ({ signal }) => getAdminSettings(signal),
  })

  const threatFoxCredential = useQuery({
    queryKey: adminCredentialKey('ThreatFox.ApiKey'),
    queryFn: ({ signal }) => getAdminCredential('ThreatFox.ApiKey', signal),
  })
  const phishTankCredential = useQuery({
    queryKey: adminCredentialKey('PhishTank.AppKey'),
    queryFn: ({ signal }) => getAdminCredential('PhishTank.AppKey', signal),
  })

  // Initialize draft from fetched settings
  useEffect(() => {
    if (settings && !draft) {
      const d = baselineToDraft(settings)
      setDraft(d)
      setBaseline(d)
    }
  }, [settings, draft])

  // Dirty state
  const dirty = baseline && draft ? isDirty(baseline, draft) : false

  // Warn on navigation/reload when dirty
  useEffect(() => {
    const handler = (e: BeforeUnloadEvent) => {
      if (dirty) {
        e.preventDefault()
      }
    }
    window.addEventListener('beforeunload', handler)
    return () => window.removeEventListener('beforeunload', handler)
  }, [dirty])

  // Block route navigation when dirty
  useBlocker({
    condition: dirty,
    blockerFn: () => {
      const leave = window.confirm(
        'You have unsaved changes. Are you sure you want to leave?',
      )
      return !leave
    },
  })

  // Cleanup timeout on unmount
  useEffect(() => {
    return () => {
      if (saveTimeoutRef.current) clearTimeout(saveTimeoutRef.current)
    }
  }, [])

  const handleReset = useCallback(() => {
    if (baseline) {
      setDraft(baseline)
      setFieldErrors({})
      setSaveError(null)
      setSaveSuccess(false)
    }
  }, [baseline])

  const handleSave = useCallback(async () => {
    if (!draft) return

    const errors = validateDraft(draft)
    setFieldErrors(errors)
    if (hasErrors(errors)) return

    setIsSaving(true)
    setSaveError(null)
    setSaveSuccess(false)

    try {
      const request = draftToRequest(draft)
      await putAdminSettings(request)
      // PUT is an atomic 204 endpoint. The accepted draft is therefore the
      // new baseline; the invalidated GET below refreshes the authoritative
      // snapshot without treating the empty success body as malformed JSON.
      const newBaseline = draft
      setBaseline(newBaseline)
      setDraft(newBaseline)
      setFieldErrors({})
      setSaveSuccess(true)
      void queryClient.invalidateQueries({ queryKey: adminSettingsKey() })
      void queryClient.invalidateQueries({ queryKey: adminProviderListKey() })

      // Auto-clear success message after 30 seconds
      if (saveTimeoutRef.current) clearTimeout(saveTimeoutRef.current)
      saveTimeoutRef.current = setTimeout(() => setSaveSuccess(false), 30000)
    } catch (err) {
      if (err instanceof ApiError) {
        setSaveError(err.message)
      } else {
        setSaveError('An unexpected error occurred while saving.')
      }
    } finally {
      setIsSaving(false)
    }
  }, [draft, queryClient])

  const updateLogLevel = (value: SupportedLogLevel) => {
    if (!draft) return
    setDraft({ ...draft, logLevel: value })
    setSaveSuccess(false)
  }

  const updateProviderInterval = (id: number, value: string) => {
    if (!draft) return
    const parsed = parseInt(value, 10)
    setDraft({
      ...draft,
      providers: draft.providers.map((p) =>
        p.id === id ? { ...p, intervalMinutes: isNaN(parsed) ? 0 : parsed } : p,
      ),
    })
    setSaveSuccess(false)
  }

  const updateProviderEnabled = (id: number, value: boolean) => {
    if (!draft) return
    setDraft({
      ...draft,
      providers: draft.providers.map((p) =>
        p.id === id ? { ...p, isEnabled: value } : p,
      ),
    })
    setSaveSuccess(false)
  }

  const updateProviderRequiresApiKey = (id: number, value: boolean) => {
    if (!draft) return
    setDraft({
      ...draft,
      providers: draft.providers.map((p) =>
        p.id === id ? { ...p, requiresApiKey: value } : p,
      ),
    })
    setSaveSuccess(false)
  }

  const saveCredential = async (identity: string) => {
    const value = credentialDrafts[identity] ?? ''
    if (!value.trim()) {
      setCredentialFeedback({
        kind: 'error',
        message: 'Enter a credential before saving.',
      })
      return
    }
    setCredentialBusy(identity)
    setSaveError(null)
    setCredentialFeedback(null)
    try {
      await putAdminCredential(identity, value)
      setCredentialDrafts((current) => ({ ...current, [identity]: '' }))
      void queryClient.invalidateQueries({
        queryKey: adminCredentialKey(identity),
      })
      void queryClient.invalidateQueries({ queryKey: adminProviderListKey() })
      setCredentialFeedback({
        kind: 'success',
        message: `${identity.split('.')[0]} credential saved successfully.`,
      })
    } catch (err) {
      setCredentialFeedback({
        kind: 'error',
        message:
          err instanceof ApiError ? err.message : 'Credential update failed.',
      })
    } finally {
      setCredentialBusy(null)
    }
  }

  const clearCredential = async (identity: string) => {
    const providerLabel =
      credentialIdentities.find(([, key]) => key === identity)?.[0] ??
      'provider'
    const confirmed = window.confirm(
      `Clear the ${providerLabel} credential? This action cannot be undone.`,
    )
    if (!confirmed) return

    setCredentialBusy(identity)
    setSaveError(null)
    setCredentialFeedback(null)
    try {
      await clearAdminCredential(identity)
      setCredentialDrafts((current) => ({ ...current, [identity]: '' }))
      void queryClient.invalidateQueries({
        queryKey: adminCredentialKey(identity),
      })
      void queryClient.invalidateQueries({ queryKey: adminProviderListKey() })
      setCredentialFeedback({
        kind: 'success',
        message: `${identity.split('.')[0]} credential cleared successfully.`,
      })
    } catch (err) {
      setCredentialFeedback({
        kind: 'error',
        message:
          err instanceof ApiError ? err.message : 'Credential clear failed.',
      })
    } finally {
      setCredentialBusy(null)
    }
  }

  if (isLoading) return <LoadingState label="Loading settings…" />

  if (isError && !settings) {
    return (
      <ErrorState
        title="Failed to load settings"
        message={error instanceof ApiError ? error.message : undefined}
        correlationId={
          error instanceof ApiError ? error.correlationId : undefined
        }
        onRetry={() =>
          void queryClient.invalidateQueries({ queryKey: adminSettingsKey() })
        }
      />
    )
  }

  if (!draft) return null

  return (
    <div>
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-lg font-semibold text-on-surface">
            Runtime Settings
          </h2>
          <p className="mt-0.5 text-sm text-on-surface-variant">
            Non-secret provider and logging configuration. Changes apply within
            30 seconds of saving.
          </p>
        </div>
        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={handleReset}
            disabled={!dirty || isSaving}
            className={`rounded border border-outline-variant bg-surface-container-lowest px-3 py-1.5 font-mono text-[11px] font-semibold text-on-surface transition-colors hover:bg-surface-container-low disabled:cursor-not-allowed disabled:opacity-50 ${focusRingClass}`}
          >
            Reset
          </button>
          <button
            type="button"
            onClick={handleSave}
            disabled={!dirty || isSaving}
            className={`rounded bg-primary px-3 py-1.5 font-mono text-[11px] font-semibold text-on-primary transition-colors hover:bg-primary-container disabled:cursor-not-allowed disabled:opacity-50 ${focusRingClass}`}
          >
            {isSaving ? 'Saving…' : 'Save Settings'}
          </button>
        </div>
      </div>

      {/* Success message */}
      {saveSuccess && (
        <div
          role="status"
          className="mt-4 rounded border border-tertiary/40 bg-tertiary/10 px-4 py-2 text-sm text-tertiary"
        >
          <span className="font-semibold">Settings saved.</span> Runtime
          behavior will reflect changes within 30 seconds.
        </div>
      )}

      {/* Save error */}
      {saveError && (
        <div
          role="alert"
          className="mt-4 rounded border border-error/40 bg-error-container px-4 py-2 text-sm text-on-error-container"
        >
          <span className="font-semibold">Save failed:</span> {saveError}
        </div>
      )}

      {/* Dirty indicator */}
      {dirty && !saveSuccess && (
        <div className="mt-4 rounded border border-warning/40 bg-warning-container px-4 py-2 text-sm text-on-warning-container">
          <span className="font-semibold">Unsaved changes</span> — you have
          modified settings that have not been saved.
        </div>
      )}

      {/* Log level */}
      <div className="mt-6 rounded border border-outline-variant bg-surface-container-lowest p-4">
        <h3 className="font-semibold text-on-surface">Logging</h3>
        <div className="mt-3 flex flex-col gap-1">
          <label
            htmlFor="log-level"
            className="font-mono text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant"
          >
            Log Level
          </label>
          <select
            id="log-level"
            value={draft.logLevel}
            onChange={(e) =>
              updateLogLevel(e.target.value as SupportedLogLevel)
            }
            className={`w-full max-w-xs rounded border bg-surface-container-low px-3 py-2 font-body text-[13px] text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary ${
              fieldErrors.logLevel ? 'border-error' : 'border-outline-variant'
            }`}
          >
            {supportedLogLevels.map((l) => (
              <option key={l} value={l}>
                {l}
              </option>
            ))}
          </select>
          {fieldErrors.logLevel && (
            <span className="font-mono text-[10px] text-error">
              {fieldErrors.logLevel}
            </span>
          )}
        </div>
      </div>

      {/* Provider intervals */}
      <div className="mt-4 rounded border border-outline-variant bg-surface-container-lowest">
        <div className="border-b border-outline-variant px-4 py-3">
          <h3 className="font-semibold text-on-surface">Provider Settings</h3>
        </div>
        <div className="divide-y divide-surface-container-low">
          {draft.providers.map((provider) => {
            const intervalError = fieldErrors.providers?.[provider.id]?.interval
            return (
              <div
                key={provider.id}
                className="flex flex-wrap items-center gap-4 px-4 py-3"
              >
                <div className="min-w-[160px] flex-1">
                  <div className="font-semibold text-on-surface">
                    {provider.name}
                  </div>
                  <div className="font-mono text-[10px] text-on-surface-variant">
                    ID: {provider.id}
                  </div>
                </div>

                {/* Enabled toggle */}
                <div className="flex items-center gap-2">
                  <label
                    htmlFor={`provider-enabled-${provider.id}`}
                    className="font-mono text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant"
                  >
                    Enabled
                  </label>
                  <button
                    id={`provider-enabled-${provider.id}`}
                    type="button"
                    role="switch"
                    aria-checked={provider.isEnabled}
                    onClick={() =>
                      updateProviderEnabled(provider.id, !provider.isEnabled)
                    }
                    className={`relative inline-flex h-5 w-9 cursor-pointer rounded-full transition-colors ${
                      provider.isEnabled
                        ? 'bg-primary'
                        : 'bg-surface-container-high'
                    } ${focusRingClass}`}
                  >
                    <span
                      className={`inline-block h-4 w-4 rounded-full bg-white transition-transform ${
                        provider.isEnabled ? 'translate-x-4' : 'translate-x-0.5'
                      } mt-0.5`}
                    />
                  </button>
                </div>

                <label className="flex items-center gap-2 font-mono text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">
                  <input
                    type="checkbox"
                    checked={provider.requiresApiKey}
                    onChange={(e) =>
                      updateProviderRequiresApiKey(
                        provider.id,
                        e.target.checked,
                      )
                    }
                  />
                  Requires API key
                </label>

                {/* Interval */}
                <div className="flex flex-col gap-1">
                  <label
                    htmlFor={`provider-interval-${provider.id}`}
                    className="font-mono text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant"
                  >
                    Interval (min)
                  </label>
                  <input
                    id={`provider-interval-${provider.id}`}
                    type="number"
                    min={provider.minimumIntervalMinutes}
                    value={provider.intervalMinutes}
                    onChange={(e) =>
                      updateProviderInterval(provider.id, e.target.value)
                    }
                    className={`w-24 rounded border bg-surface-container-low px-3 py-1.5 font-mono text-[13px] text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary ${
                      intervalError ? 'border-error' : 'border-outline-variant'
                    }`}
                  />
                  {intervalError && (
                    <span className="font-mono text-[10px] text-error">
                      {intervalError}
                    </span>
                  )}
                </div>

                <span className="font-mono text-[10px] text-on-surface-variant">
                  min: {provider.minimumIntervalMinutes}m
                </span>
              </div>
            )
          })}
        </div>
      </div>

      <div className="mt-4 rounded border border-outline-variant bg-surface-container-lowest p-4">
        <h3 className="font-semibold text-on-surface">Provider Credentials</h3>
        <p className="mt-1 text-sm text-on-surface-variant">
          Credentials are write-only. They are encrypted before storage and are
          never shown here.
        </p>
        {credentialFeedback && (
          <div
            role={credentialFeedback.kind === 'error' ? 'alert' : 'status'}
            aria-live="polite"
            className={`mt-3 rounded border px-3 py-2 text-sm ${
              credentialFeedback.kind === 'error'
                ? 'border-error/40 bg-error-container text-on-error-container'
                : 'border-tertiary/40 bg-tertiary/10 text-tertiary'
            }`}
          >
            <span className="font-semibold">
              {credentialFeedback.kind === 'error'
                ? 'Credential update failed.'
                : 'Credential updated.'}
            </span>{' '}
            {credentialFeedback.message}
          </div>
        )}
        <div className="mt-4 space-y-4">
          {credentialIdentities.map(([label, identity]) => {
            const provider = draft.providers.find((item) => item.name === label)
            if (!provider?.requiresApiKey) return null

            const status =
              identity === 'ThreatFox.ApiKey'
                ? threatFoxCredential.data
                : phishTankCredential.data
            const busy = credentialBusy === identity
            return (
              <div
                key={identity}
                className="flex flex-wrap items-end gap-3 border-t border-outline-variant pt-3"
              >
                <div className="min-w-[150px] flex-1">
                  <div className="font-semibold text-on-surface">{label}</div>
                  <div className="font-mono text-[10px] text-on-surface-variant">
                    {status?.configured ? 'Configured' : 'Not configured'}
                  </div>
                </div>
                <input
                  aria-label={`${label} credential`}
                  type="text"
                  autoComplete="off"
                  spellCheck={false}
                  data-1p-ignore="true"
                  data-lpignore="true"
                  value={credentialDrafts[identity] ?? ''}
                  onChange={(e) =>
                    setCredentialDrafts((current) => ({
                      ...current,
                      [identity]: e.target.value,
                    }))
                  }
                  placeholder="Enter new credential"
                  className="credential-input min-w-[220px] flex-1 rounded border border-outline-variant bg-surface-container-low px-3 py-1.5 font-mono text-[13px] text-on-surface"
                />
                <button
                  type="button"
                  disabled={busy}
                  onClick={() => void saveCredential(identity)}
                  className={`rounded bg-primary px-3 py-1.5 font-mono text-[11px] font-semibold text-on-primary disabled:opacity-50 ${focusRingClass}`}
                >
                  {busy ? 'Saving…' : 'Set / replace'}
                </button>
                <button
                  type="button"
                  disabled={busy || !status?.configured}
                  onClick={() => void clearCredential(identity)}
                  className={`rounded border border-outline-variant px-3 py-1.5 font-mono text-[11px] font-semibold text-on-surface disabled:opacity-50 ${focusRingClass}`}
                >
                  Clear
                </button>
              </div>
            )
          })}
        </div>
      </div>
    </div>
  )
}
</file>

<file path="frontend/src/routes/admin.tsx">
import {
  createFileRoute,
  Link,
  Outlet,
  useRouterState,
} from '@tanstack/react-router'
import { requireAdmin } from '../lib/routeGuards'
import { focusRingClass } from '../components/AppShell'

export const Route = createFileRoute('/admin')({
  // Admin access is guarded in the browser: the session lives in sessionStorage,
  // which the router restores before the first render, so a direct load with a
  // valid Admin session is permitted while a missing or non-Admin session
  // follows the existing guard redirects. Children inherit this guard.
  beforeLoad: ({ location }) => {
    requireAdmin(location)
  },
  component: AdminLayout,
})

const tabBaseClass =
  'px-3 py-2 font-mono text-[11px] font-semibold uppercase tracking-wider rounded transition-[background-color,box-shadow,color]'
const tabActiveClass = `${tabBaseClass} bg-primary text-on-primary`
const tabInactiveClass = `${tabBaseClass} text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface hover:shadow-sm`

const tabs = [
  { to: '/admin/providers' as const, label: 'Providers' },
  { to: '/admin/summary' as const, label: 'Summary' },
  { to: '/admin/logs' as const, label: 'Logs' },
  { to: '/admin/settings' as const, label: 'Settings' },
] as const

function AdminLayout() {
  const routerState = useRouterState()
  const currentPath = routerState.location.pathname

  return (
    <section aria-labelledby="admin-heading">
      <h1
        id="admin-heading"
        className="text-2xl font-semibold tracking-tight text-on-surface"
      >
        Admin Console
      </h1>
      <p className="mt-1 text-sm text-on-surface-variant">
        Administrative workflows for provider operations, monitoring, and
        runtime configuration.
      </p>

      <nav
        aria-label="Admin sections"
        className="mt-4 flex flex-wrap gap-1 border-b border-outline-variant"
      >
        {tabs.map((tab) => {
          const isActive =
            currentPath === tab.to ||
            (tab.to === '/admin/providers' && currentPath === '/admin')
          return (
            <Link
              key={tab.to}
              to={tab.to}
              className={`${isActive ? tabActiveClass : tabInactiveClass} ${focusRingClass} -mb-px`}
              aria-current={isActive ? 'page' : undefined}
            >
              {tab.label}
            </Link>
          )
        })}
      </nav>

      <div className="py-4">
        <Outlet />
      </div>
    </section>
  )
}
</file>

<file path="frontend/src/routes/browse.tsx">
import { Suspense, lazy, useCallback, useEffect, useRef, useState } from 'react'
import {
  Link,
  ClientOnly,
  createFileRoute,
  useNavigate,
} from '@tanstack/react-router'
import { ApiError } from '../lib/apiClient'
import {
  BROWSE_MALWARE_MAX_LENGTH,
  BROWSE_TARGET_MAX_LENGTH,
  browseDirOptions,
  browseOrderByOptions,
  browsePageSizeOptions,
  browseParamsToSearch,
  hasActiveBrowseFilters,
  observedPeriodFrom,
  observedPeriodPresets,
  parseBrowseParams,
  rawBrowseSearchSchema,
} from '../lib/browseParams'
import type { BrowseParams } from '../lib/browseParams'
import { iocTypeTokens } from '../lib/schemas'
import { iocTypeLabels } from '../lib/iocPresentation'
import { focusRingClass } from '../components/AppShell'
import { TagAutocompleteInput } from '../components/TagAutocompleteInput'
import { ProviderAutocompleteInput } from '../components/ProviderAutocompleteInput'
import {
  EmptyState,
  ErrorState,
  ForbiddenState,
  LoadingState,
} from '../components/uiStates'
import type {
  BrowseTableHandle,
  BrowseTableStatus,
} from '../components/BrowseDataTable'

export const Route = createFileRoute('/browse')({
  validateSearch: rawBrowseSearchSchema,
  component: BrowsePage,
})

const controlClass =
  'mt-1 w-full rounded border border-outline-variant bg-surface-container-lowest px-3 py-2 font-mono text-xs text-on-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
const fieldLabelClass =
  'font-mono text-[10px] font-semibold uppercase tracking-wider text-outline'

// Browser-only: the DataTables module is loaded dynamically beneath ClientOnly.
const LazyBrowseTable = lazy(() => import('../components/BrowseDataTable'))

function providerDraftValue(params: BrowseParams | null): string {
  return params?.provider ?? ''
}

/** Local datetime string for a `datetime-local` input from an ISO instant. */
function toDatetimeLocalValue(iso: string | null): string {
  if (!iso) return ''
  const date = new Date(iso)
  if (Number.isNaN(date.getTime())) return ''
  const offset = date.getTimezoneOffset() * 60_000
  return new Date(date.getTime() - offset).toISOString().slice(0, 16)
}

/** ISO instant from a `datetime-local` input value, or null when empty/invalid. */
function fromDatetimeLocalValue(value: string): string | null {
  if (value.trim() === '') return null
  const date = new Date(value)
  return Number.isNaN(date.getTime()) ? null : date.toISOString()
}

function BrowseTableFallback() {
  return (
    <div
      role="status"
      aria-live="polite"
      className="px-4 py-6 font-mono text-xs uppercase tracking-wider text-on-surface-variant"
    >
      Preparing the indicator table…
    </div>
  )
}

function BrowsePage() {
  const rawSearch = Route.useSearch()
  const navigate = useNavigate()
  const { params, issues } = parseBrowseParams(rawSearch)

  function goTo(next: Partial<BrowseParams>) {
    if (!params) return
    void navigate({
      to: '/browse',
      search: browseParamsToSearch({ ...params, ...next }),
    })
  }

  const [tagDraft, setTagDraft] = useState(params?.tag ?? '')
  const [providerDraft, setProviderDraft] = useState(() =>
    providerDraftValue(params),
  )
  const [malwareDraft, setMalwareDraft] = useState(params?.malware ?? '')
  const [targetDraft, setTargetDraft] = useState(params?.target ?? '')
  const [fromDraft, setFromDraft] = useState(() =>
    toDatetimeLocalValue(params?.lastSeenFrom ?? null),
  )
  const [toDraft, setToDraft] = useState(() =>
    toDatetimeLocalValue(params?.lastSeenTo ?? null),
  )
  // Keep the text drafts in sync when the URL changes (reload, Back, Forward).
  useEffect(() => {
    setTagDraft(params?.tag ?? '')
    setProviderDraft(providerDraftValue(params))
    setMalwareDraft(params?.malware ?? '')
    setTargetDraft(params?.target ?? '')
    setFromDraft(toDatetimeLocalValue(params?.lastSeenFrom ?? null))
    setToDraft(toDatetimeLocalValue(params?.lastSeenTo ?? null))
  }, [
    params?.tag,
    params?.provider,
    params?.malware,
    params?.target,
    params?.lastSeenFrom,
    params?.lastSeenTo,
  ])

  const [tableStatus, setTableStatus] = useState<BrowseTableStatus>({
    kind: 'pending',
  })
  const tableHandleRef = useRef<BrowseTableHandle | null>(null)

  const handleTableParams = useCallback(
    (next: BrowseParams) => {
      void navigate({ to: '/browse', search: browseParamsToSearch(next) })
    },
    [navigate],
  )
  const openDetail = useCallback(
    (id: number) => {
      void navigate({ to: '/iocs/$id', params: { id: String(id) } })
    },
    [navigate],
  )

  const [toast, setToast] = useState<string | null>(null)
  const toastTimer = useRef<ReturnType<typeof setTimeout> | null>(null)
  useEffect(
    () => () => {
      if (toastTimer.current) clearTimeout(toastTimer.current)
    },
    [],
  )
  function showToast(message: string) {
    setToast(message)
    if (toastTimer.current) clearTimeout(toastTimer.current)
    toastTimer.current = setTimeout(() => setToast(null), 2500)
  }
  function copyIndicator(value: string) {
    const clipboard = navigator.clipboard as Clipboard | undefined
    if (!clipboard?.writeText) {
      showToast('Copy is not available in this browser.')
      return
    }
    void clipboard.writeText(value).then(
      () => showToast(`Copied to clipboard: ${value}`),
      () => showToast('Copy failed.'),
    )
  }

  const showTable =
    tableStatus.kind === 'pending' || tableStatus.kind === 'success'

  return (
    <section aria-labelledby="browse-heading">
      <div className="flex flex-wrap items-end justify-between gap-3 border-b border-outline-variant/60 pb-4">
        <div>
          <p className={fieldLabelClass}>Threat Intelligence Explorer</p>
          <div className="mt-1 flex flex-wrap items-baseline gap-3">
            <h1
              id="browse-heading"
              className="text-2xl font-semibold tracking-tight text-on-surface"
            >
              Browse indicators
            </h1>
            {tableStatus.kind === 'success' ? (
              <span className="rounded-full bg-surface-container-high px-2.5 py-0.5 font-mono text-[11px] font-semibold text-on-surface-variant">
                {tableStatus.totalCount.toLocaleString('en-US')} IOCs
              </span>
            ) : null}
          </div>
          <p className="mt-1 max-w-2xl text-xs text-on-surface-variant">
            Filter, order, and page the grouped dataset. Every control is
            reflected in the address bar, so reloading, Back/Forward, or sharing
            the link restores this exact view.
          </p>
        </div>
      </div>

      {params === null ? (
        <div className="mt-6 space-y-4">
          <ErrorState title="Unsupported filters" message={issues.join(' ')} />
          <Link
            to="/browse"
            search={() => ({})}
            className={`inline-block font-medium text-primary underline underline-offset-2 ${focusRingClass}`}
          >
            Reset to the default view
          </Link>
        </div>
      ) : (
        <div className="mt-6 flex flex-col items-start gap-6 lg:flex-row">
          <aside className="w-full shrink-0 rounded border border-outline-variant bg-surface-container-lowest lg:w-72">
            <div className="flex items-center justify-between border-b border-outline-variant/60 px-3 py-2">
              <span className="flex items-center gap-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-on-surface">
                <span
                  aria-hidden="true"
                  className="material-symbols-outlined text-[16px] text-primary"
                >
                  tune
                </span>
                Filter Telemetry
              </span>
              {hasActiveBrowseFilters(params) ? (
                <Link
                  to="/browse"
                  search={() => ({})}
                  className={`font-mono text-[10px] font-semibold uppercase tracking-wider text-primary hover:underline ${focusRingClass}`}
                >
                  Clear filters
                </Link>
              ) : (
                <span className="font-mono text-[10px] uppercase tracking-wider text-outline">
                  Default view
                </span>
              )}
            </div>

            <form
              className="space-y-4 p-3"
              onSubmit={(event) => {
                event.preventDefault()
                goTo({
                  tag: tagDraft.trim() === '' ? null : tagDraft.trim(),
                  provider:
                    providerDraft.trim() === '' ? null : providerDraft.trim(),
                  malware:
                    malwareDraft.trim() === '' ? null : malwareDraft.trim(),
                  target: targetDraft.trim() === '' ? null : targetDraft.trim(),
                  lastSeenFrom: fromDatetimeLocalValue(fromDraft),
                  lastSeenTo: fromDatetimeLocalValue(toDraft),
                  page: 1,
                })
              }}
            >
              <fieldset>
                <legend className={fieldLabelClass}>Indicator type</legend>
                <div
                  role="group"
                  aria-label="Filter by indicator type"
                  className="mt-2 flex flex-wrap gap-1.5"
                >
                  <button
                    type="button"
                    aria-pressed={params.type === null}
                    onClick={() => goTo({ type: null, page: 1 })}
                    className={`rounded-full px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider transition-colors ${focusRingClass} ${
                      params.type === null
                        ? 'bg-primary text-on-primary'
                        : 'bg-surface-container-low text-on-surface-variant hover:bg-surface-container'
                    }`}
                  >
                    All Types
                  </button>
                  {iocTypeTokens.map((token) => (
                    <button
                      key={token}
                      type="button"
                      aria-pressed={params.type === token}
                      onClick={() => goTo({ type: token, page: 1 })}
                      className={`rounded-full px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider transition-colors ${focusRingClass} ${
                        params.type === token
                          ? 'bg-primary text-on-primary'
                          : 'bg-surface-container-low text-on-surface-variant hover:bg-surface-container'
                      }`}
                    >
                      {iocTypeLabels[token]}
                    </button>
                  ))}
                </div>
              </fieldset>

              <div>
                <label htmlFor="browse-tag" className={fieldLabelClass}>
                  Tag
                </label>
                <TagAutocompleteInput
                  id="browse-tag"
                  value={tagDraft}
                  onChange={setTagDraft}
                  className={controlClass}
                  multiple
                />
                <p className="mt-1 text-[10px] text-on-surface-variant">
                  Add multiple tags separated by commas. Any selected tag can
                  match.
                </p>
              </div>

              <div>
                <label htmlFor="browse-provider" className={fieldLabelClass}>
                  Provider
                </label>
                <ProviderAutocompleteInput
                  id="browse-provider"
                  value={providerDraft}
                  onChange={setProviderDraft}
                  className={controlClass}
                />
                <p className="mt-1 text-[10px] text-on-surface-variant">
                  Add multiple providers separated by commas. Any selected
                  provider can match.
                </p>
              </div>

              <div>
                <label htmlFor="browse-malware" className={fieldLabelClass}>
                  Malware
                </label>
                <input
                  id="browse-malware"
                  type="text"
                  value={malwareDraft}
                  maxLength={BROWSE_MALWARE_MAX_LENGTH}
                  onChange={(event) => setMalwareDraft(event.target.value)}
                  className={controlClass}
                />
                <p className="mt-1 text-[10px] text-on-surface-variant">
                  Match a stored malware value (case-insensitive, at most{' '}
                  {BROWSE_MALWARE_MAX_LENGTH} characters).
                </p>
              </div>

              <div>
                <label htmlFor="browse-target" className={fieldLabelClass}>
                  Target
                </label>
                <input
                  id="browse-target"
                  type="text"
                  value={targetDraft}
                  maxLength={BROWSE_TARGET_MAX_LENGTH}
                  onChange={(event) => setTargetDraft(event.target.value)}
                  className={controlClass}
                />
                <p className="mt-1 text-[10px] text-on-surface-variant">
                  Match a stored target value (case-insensitive, at most{' '}
                  {BROWSE_TARGET_MAX_LENGTH} characters).
                </p>
              </div>

              <fieldset>
                <legend className={fieldLabelClass}>Observed period</legend>
                <div className="mt-2 grid grid-cols-2 gap-1">
                  {observedPeriodPresets.map((preset) => (
                    <button
                      key={preset.value}
                      type="button"
                      onClick={() =>
                        goTo({
                          lastSeenFrom:
                            preset.value === 'all'
                              ? null
                              : observedPeriodFrom(preset.value),
                          lastSeenTo: null,
                          page: 1,
                        })
                      }
                      className={`rounded px-2 py-1.5 text-center font-mono text-[10px] font-semibold uppercase tracking-wider transition-colors ${focusRingClass} ${
                        preset.value === 'all' &&
                        params.lastSeenFrom === null &&
                        params.lastSeenTo === null
                          ? 'bg-primary text-on-primary'
                          : 'bg-surface-container-low text-on-surface-variant hover:bg-surface-container'
                      }`}
                    >
                      {preset.label}
                    </button>
                  ))}
                </div>
                <div className="mt-2 grid grid-cols-2 gap-1">
                  <div>
                    <label
                      htmlFor="browse-lastseen-from"
                      className="font-mono text-[9px] uppercase tracking-wider text-outline"
                    >
                      From
                    </label>
                    <input
                      id="browse-lastseen-from"
                      type="datetime-local"
                      value={fromDraft}
                      onChange={(event) => setFromDraft(event.target.value)}
                      className="mt-1 w-full rounded border border-outline-variant bg-surface-container-lowest px-2 py-1 font-mono text-[11px] text-on-surface"
                    />
                  </div>
                  <div>
                    <label
                      htmlFor="browse-lastseen-to"
                      className="font-mono text-[9px] uppercase tracking-wider text-outline"
                    >
                      To
                    </label>
                    <input
                      id="browse-lastseen-to"
                      type="datetime-local"
                      value={toDraft}
                      onChange={(event) => setToDraft(event.target.value)}
                      className="mt-1 w-full rounded border border-outline-variant bg-surface-container-lowest px-2 py-1 font-mono text-[11px] text-on-surface"
                    />
                  </div>
                </div>
              </fieldset>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label htmlFor="browse-order" className={fieldLabelClass}>
                    Order by
                  </label>
                  <select
                    id="browse-order"
                    value={params.orderBy}
                    onChange={(event) =>
                      goTo({
                        orderBy: event.target.value as BrowseParams['orderBy'],
                        page: 1,
                      })
                    }
                    className={controlClass}
                  >
                    {browseOrderByOptions.map((option) => (
                      <option key={option} value={option}>
                        {option}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label htmlFor="browse-dir" className={fieldLabelClass}>
                    Direction
                  </label>
                  <select
                    id="browse-dir"
                    value={params.dir}
                    onChange={(event) =>
                      goTo({
                        dir: event.target.value as BrowseParams['dir'],
                        page: 1,
                      })
                    }
                    className={controlClass}
                  >
                    {browseDirOptions.map((option) => (
                      <option key={option} value={option}>
                        {option}
                      </option>
                    ))}
                  </select>
                </div>
              </div>

              <div>
                <label htmlFor="browse-page-size" className={fieldLabelClass}>
                  Page size
                </label>
                <select
                  id="browse-page-size"
                  value={String(params.pageSize)}
                  onChange={(event) =>
                    goTo({ pageSize: Number(event.target.value), page: 1 })
                  }
                  className={controlClass}
                >
                  {browsePageSizeOptions.map((option) => (
                    <option key={option} value={String(option)}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>

              <button
                type="submit"
                className={`w-full rounded bg-primary px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-on-primary transition-colors hover:bg-primary-container ${focusRingClass}`}
              >
                Apply filters
              </button>
            </form>
          </aside>

          <div className="w-full min-w-0 flex-1">
            {tableStatus.kind === 'pending' ? (
              <LoadingState label="Loading indicators…" />
            ) : null}
            {tableStatus.kind === 'error' ? (
              <BrowseErrorState
                error={tableStatus.error}
                onRetry={() => tableHandleRef.current?.reload()}
              />
            ) : null}
            {tableStatus.kind === 'forbidden' ? (
              <ForbiddenState message="You do not have permission to browse indicators." />
            ) : null}
            {tableStatus.kind === 'empty' ? (
              <EmptyState
                title="No indicators found"
                message="No stored indicators match the current filters."
                action={
                  hasActiveBrowseFilters(params) ? (
                    <Link
                      to="/browse"
                      search={() => ({})}
                      className={`font-medium text-primary underline underline-offset-2 ${focusRingClass}`}
                    >
                      Clear filters
                    </Link>
                  ) : undefined
                }
              />
            ) : null}

            <div
              className={`overflow-hidden rounded border border-outline-variant bg-surface-container-lowest ${
                showTable ? '' : 'hidden'
              }`}
            >
              <div className="w-full overflow-x-auto">
                <ClientOnly fallback={<BrowseTableFallback />}>
                  <Suspense fallback={<BrowseTableFallback />}>
                    <LazyBrowseTable
                      ref={tableHandleRef}
                      params={params}
                      onTableParams={handleTableParams}
                      onStatus={setTableStatus}
                      onCopy={copyIndicator}
                      onOpenDetail={openDetail}
                    />
                  </Suspense>
                </ClientOnly>
              </div>
              {tableStatus.kind === 'success' ? (
                <div className="flex flex-wrap items-center justify-between gap-2 border-t border-outline-variant/60 bg-surface-container-low/40 px-3 py-2 font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">
                  <span className="flex items-center gap-2">
                    <span
                      aria-hidden="true"
                      className="h-2 w-2 rounded-full bg-tertiary"
                    />
                    Showing {tableStatus.shown} of{' '}
                    {tableStatus.totalCount.toLocaleString('en-US')} matched
                    indicators
                  </span>
                  <span>Source-attributed · page {tableStatus.page}</span>
                </div>
              ) : null}
            </div>
          </div>
        </div>
      )}

      {toast ? (
        <div
          role="status"
          aria-live="polite"
          className="fixed bottom-6 right-6 z-50 flex items-center gap-2 rounded bg-inverse-surface px-4 py-2 font-mono text-xs text-inverse-on-surface"
        >
          <span
            aria-hidden="true"
            className="material-symbols-outlined text-[16px] text-tertiary-fixed"
          >
            check_circle
          </span>
          <span>{toast}</span>
        </div>
      ) : null}
    </section>
  )
}

export function BrowseErrorState({
  error,
  onRetry,
}: {
  error: unknown
  onRetry: () => void
}) {
  if (error instanceof ApiError && error.status === 403) {
    return (
      <ForbiddenState message="You do not have permission to browse indicators." />
    )
  }
  return (
    <ErrorState
      title="Could not load indicators"
      message={
        error instanceof Error
          ? error.message
          : 'The request could not be completed.'
      }
      correlationId={
        error instanceof ApiError ? error.correlationId : undefined
      }
      onRetry={onRetry}
    />
  )
}

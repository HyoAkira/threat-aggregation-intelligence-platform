@import 'tailwindcss';

/*
 * Design tokens for the Threat Intelligence console: the approved Material-style
 * tonal palette and the Geist / JetBrains Mono type pairing from the approved
 * Stitch cyber-intelligence design system. Pages opt into these
 * utilities; they are additive so existing utilities keep working unchanged.
 */
@theme {
  --color-primary: #003ec7;
  --color-on-primary: #ffffff;
  --color-primary-container: #0052ff;
  --color-on-primary-container: #dfe3ff;
  --color-primary-fixed: #dde1ff;
  --color-primary-fixed-dim: #b7c4ff;
  --color-on-primary-fixed: #001452;
  --color-on-primary-fixed-variant: #0038b6;
  --color-inverse-primary: #b7c4ff;

  --color-secondary: #5b5e67;
  --color-on-secondary: #ffffff;
  --color-secondary-container: #dfe2ed;
  --color-on-secondary-container: #61646d;
  --color-secondary-fixed: #dfe2ed;
  --color-secondary-fixed-dim: #c3c6d0;
  --color-on-secondary-fixed: #181c23;

  --color-tertiary: #005b33;
  --color-on-tertiary: #ffffff;
  --color-tertiary-container: #007644;
  --color-on-tertiary-container: #77ffaf;
  --color-tertiary-fixed: #72fcac;
  --color-tertiary-fixed-dim: #53df92;
  --color-on-tertiary-fixed: #00210f;

  --color-error: #ba1a1a;
  --color-on-error: #ffffff;
  --color-error-container: #ffdad6;
  --color-on-error-container: #93000a;

  --color-warning: #b45309;
  --color-warning-container: #fef3c7;
  --color-on-warning-container: #78350f;

  --color-background: #f8f9ff;
  --color-on-background: #0b1c30;
  --color-surface: #f8f9ff;
  --color-surface-dim: #cbdbf5;
  --color-surface-bright: #f8f9ff;
  --color-surface-tint: #004ced;
  --color-surface-variant: #d3e4fe;
  --color-surface-container-lowest: #ffffff;
  --color-surface-container-low: #eff4ff;
  --color-surface-container: #e5eeff;
  --color-surface-container-high: #dce9ff;
  --color-surface-container-highest: #d3e4fe;
  --color-on-surface: #0b1c30;
  --color-on-surface-variant: #434656;
  --color-outline: #737688;
  --color-outline-variant: #c3c5d9;
  --color-scrim: #000000;
  --color-inverse-surface: #213145;
  --color-inverse-on-surface: #eaf1ff;

  --font-sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
}

/* Google Material Symbols icon font (loaded globally via the root route head).
 * Layered below utilities so size/color utilities can override it. */
@keyframes ioc-chat-enter {
  from {
    opacity: 0;
    transform: translateY(0.75rem) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@layer components {
  /* API keys are not passwords; keep password managers from offering to save them. */
  .credential-input {
    -webkit-text-security: disc;
  }

  /* The investigation chat window lifts in like a support widget. */
  .ioc-chat-enter {
    animation: ioc-chat-enter 160ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .ioc-chat-enter {
      animation: none;
    }
  }

  .material-symbols-outlined {
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
    -webkit-font-smoothing: antialiased;
    user-select: none;
  }
}

/*
 * DataTables unstyled core generates structural DOM (container, layout rows,
 * pager, processing indicator, header wrappers). These rules map that structure
 * onto the existing design tokens; no DataTables theme CSS is imported.
 */
@layer components {
  .dt-container {
    position: relative;
  }

  table.dataTable {
    width: 100%;
  }

  /* The log table has five dense fields. Fixed layout keeps a long message or
   * exception from deciding the width of every other column. The cell content
   * is responsible for wrapping inside the proportions declared by the table. */
  .admin-logs-table {
    table-layout: fixed;
    width: calc(100% + 3px) !important;
  }

  .admin-logs-table th,
  .admin-logs-table tbody td {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .admin-logs-table tbody td {
    vertical-align: top;
  }

  .admin-logs-exception {
    position: relative;
    width: max-content;
    max-width: 100%;
  }

  .admin-logs-exception summary::-webkit-details-marker {
    display: none;
  }

  .admin-logs-exception-icon {
    transition: transform 120ms ease;
  }

  .admin-logs-exception[open] .admin-logs-exception-icon {
    transform: rotate(180deg);
  }

  .admin-logs-exception-popover {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(32rem, calc(100vw - 2rem));
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--color-error) 25%, var(--color-outline-variant));
    border-radius: 0.25rem;
    background: var(--color-surface-container-lowest);
    box-shadow: 0 12px 28px
      color-mix(in srgb, var(--color-on-surface) 16%, transparent);
  }

  @media (max-width: 639px) {
    /* Correlation IDs are useful for investigation but secondary to the log
     * itself on a phone-sized viewport. Removing that column gives timestamp,
     * message, level, and the exception action enough room to breathe. */
    .admin-logs-correlation-column,
    .admin-logs-table col:nth-child(4),
    .admin-logs-table tbody td:nth-child(4) {
      display: none;
    }

    .admin-logs-table {
      width: 100% !important;
    }

    .admin-logs-table col:nth-child(1) {
      width: 27% !important;
    }

    .admin-logs-table col:nth-child(2) {
      width: 18% !important;
    }

    .admin-logs-table col:nth-child(3) {
      width: 40% !important;
    }

    .admin-logs-table col:nth-child(5) {
      width: 15% !important;
    }

    .admin-logs-timestamp {
      display: block;
      line-height: 1.35;
    }

    .admin-logs-exception-popover {
      right: -2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .admin-logs-exception-icon {
      transition: none;
    }
  }

  /* DataTables generates the body cells, so their padding lives here rather
   * than in the React slots. Matches the header's px-3/py-2 rhythm with extra
   * vertical room so the first row does not sit against the header. */
  table.dataTable tbody td {
    padding: 0.625rem 0.5rem;
  }

  table.dataTable tbody td:first-child {
    padding-inline-start: 0.75rem;
  }

  /* Keep the indicator readable on narrow screens. The table already scrolls
   * horizontally, so give its primary value enough room to use three lines. */
  @media (max-width: 639px) {
    table.dataTable:not(.admin-logs-table) tbody td:first-child {
      min-width: 16rem;
    }
  }

  table.dataTable tbody td:last-child {
    padding-inline-end: 0.75rem;
  }

  .dt-column-header {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .dt-column-order {
    position: relative;
    display: inline-block;
    width: 0.8em;
    height: 1.25em;
    flex: none;
  }

  .dt-column-order::before,
  .dt-column-order::after {
    position: absolute;
    left: 0.05em;
    font-size: 8px;
    line-height: 1;
    color: var(--color-outline);
    opacity: 0;
    transition: opacity 100ms ease;
  }

  .dt-column-order::before {
    content: '\25B2';
    top: 0;
  }

  .dt-column-order::after {
    content: '\25BC';
    bottom: 0;
  }

  th.dt-orderable-none .dt-column-order {
    display: none;
  }

  th.dt-orderable-asc,
  th.dt-orderable-desc {
    cursor: pointer;
  }

  /* Sortable columns show a faint, separated up/down hint. */
  th.dt-orderable-asc .dt-column-order::before,
  th.dt-orderable-desc .dt-column-order::after {
    opacity: 0.3;
  }

  th.dt-orderable-asc:hover .dt-column-order::before,
  th.dt-orderable-desc:hover .dt-column-order::after {
    opacity: 0.8;
  }

  /* When sorted, only the active direction is visible. */
  th.dt-ordering-asc .dt-column-order::before {
    color: var(--color-primary);
    opacity: 1;
  }

  th.dt-ordering-asc .dt-column-order::after {
    opacity: 0;
  }

  th.dt-ordering-desc .dt-column-order::after {
    color: var(--color-primary);
    opacity: 1;
  }

  th.dt-ordering-desc .dt-column-order::before {
    opacity: 0;
  }

  .dt-layout-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-outline-variant) 60%, transparent);
    background-color: color-mix(
      in srgb,
      var(--color-surface-container-low) 40%,
      transparent
    );
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .dt-layout-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dt-paging {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .dt-paging-button {
    cursor: pointer;
    border: 1px solid var(--color-outline-variant);
    border-radius: 0.25rem;
    background-color: var(--color-surface-container-lowest);
    padding: 0.375rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-on-surface);
    transition: background-color 120ms ease;
  }

  .dt-paging-button:hover:not(.disabled):not(.current) {
    background-color: var(--color-surface-container-low);
  }

  .dt-paging-button.current {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .dt-paging-button.disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .dt-paging-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .dt-processing {
    position: absolute;
    top: 0;
    inset-inline: 0;
    margin: 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--color-inverse-surface);
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-inverse-on-surface);
    display: none;
  }
}

* {
  box-sizing: border-box;
}

html,
body,
#app {
  min-height: 100%;
}

body {
  margin: 0;
  background-color: var(--color-surface);
  color: var(--color-on-surface);
}

/* Data-view scroll containers stay flush with the dense instrument aesthetic. */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-thumb {
  background: var(--color-outline-variant);
  border-radius: 9999px;
}
</file>

<file path="src/ThreatIntelligence.API/Program.cs">
using System.Text;
using MassTransit;
using Serilog.Core;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.IdentityModel.Tokens;
using Scalar.AspNetCore;
using Serilog;
using ThreatIntelligence.Application;
using ThreatIntelligence.API.Authorization;
using ThreatIntelligence.API.Errors;
using ThreatIntelligence.API.Serialization;
using ThreatIntelligence.Infrastructure.Configuration;
using ThreatIntelligence.Infrastructure;
using ThreatIntelligence.Infrastructure.Persistence;
using ThreatIntelligence.API.Mcp;
using ModelContextProtocol.Server;
using ModelContextProtocol.AspNetCore;
using Microsoft.Extensions.Options;
using ThreatIntelligence.Application.AI;
using ThreatIntelligence.API.Chat;

EnvironmentConfiguration.LoadDotEnv();

var builder = WebApplication.CreateBuilder(args);
var logLevelSwitch = new LoggingLevelSwitch();

builder.Host.UseSerilog((context, services, loggerConfiguration) => loggerConfiguration
    .ReadFrom.Configuration(context.Configuration)
    .MinimumLevel.ControlledBy(logLevelSwitch)
    .ReadFrom.Services(services)
    .Enrich.FromLogContext()
    .Enrich.WithProperty("Service", "ThreatIntelligence.API"));

// Add services to the container.

builder.Services.AddControllers(options => options.Conventions.Add(new AdminControllerConvention()))
    .AddJsonOptions(options => ApiJson.Configure(options.JsonSerializerOptions));
builder.Services.Configure<ApiBehaviorOptions>(options =>
{
    options.InvalidModelStateResponseFactory = context =>
    {
        var detail = string.Join(
            " ",
            context.ModelState
                .Where(entry => entry.Value?.Errors.Count > 0)
                .SelectMany(entry => entry.Value!.Errors.Select(error =>
                    string.IsNullOrWhiteSpace(error.ErrorMessage)
                        ? entry.Key
                        : $"{entry.Key}: {error.ErrorMessage}")));
        if (string.IsNullOrWhiteSpace(detail))
        {
            detail = "One or more request values are invalid.";
        }

        return ApiProblemFactory.Result(
            context.HttpContext,
            StatusCodes.Status400BadRequest,
            ApiProblemFactory.ValidationCode,
            "Validation failed",
            detail);
    };
});
builder.Services.AddSingleton(logLevelSwitch);
// Learn more about configuring OpenAPI at https://aka.ms/aspnet/openapi
builder.Services.AddOpenApi(options =>
{
    options.AddDocumentTransformer<BearerSecuritySchemeDocumentTransformer>();
    options.AddOperationTransformer<AnonymousSecurityOperationTransformer>();
    options.AddOperationTransformer<ApiProblemOpenApiTransformer>();
});
var jwt = ThreatIntelligenceOptions.BindAndValidate(builder.Configuration).Jwt;
builder.Services.AddApplicationServices()
                   .AddInfrastructureServices(builder.Configuration);
var rabbitMq = ThreatIntelligenceOptions.BindAndValidate(builder.Configuration).RabbitMq;
builder.Services.AddMassTransit(configurator =>
{
    configurator.UsingRabbitMq((context, bus) =>
    {
        bus.Message<ThreatIntelligence.Application.Fetches.FetchJob>(message =>
            message.SetEntityName(rabbitMq.Exchange));
        bus.Host(new Uri($"rabbitmq://{rabbitMq.Host}:{rabbitMq.Port}/"), host =>
        {
            host.Username(rabbitMq.User);
            host.Password(rabbitMq.Password);
        });
    });
});
var signingKey = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(jwt.Secret));
builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)
    .AddJwtBearer(options =>
    {
        options.TokenValidationParameters = new TokenValidationParameters
        {
            ValidateIssuerSigningKey = true,
            IssuerSigningKey = signingKey,
            ValidateIssuer = true,
            ValidIssuer = jwt.Issuer,
            ValidateAudience = true,
            ValidAudience = jwt.Audience,
            ValidateLifetime = true,
            ClockSkew = TimeSpan.FromMinutes(2),
            ValidAlgorithms = [SecurityAlgorithms.HmacSha256],
            NameClaimType = System.Security.Claims.ClaimTypes.Name,
            RoleClaimType = System.Security.Claims.ClaimTypes.Role
        };
        options.Events = new JwtBearerEvents
        {
            OnChallenge = async challengeContext =>
            {
                challengeContext.HandleResponse();
                challengeContext.Response.StatusCode = StatusCodes.Status401Unauthorized;
                await ApiProblemFactory.WriteAsync(challengeContext.Response, ApiProblemFactory.Create(
                    challengeContext.HttpContext,
                    StatusCodes.Status401Unauthorized,
                    ApiProblemFactory.UnauthenticatedCode,
                    "Unauthorized",
                    "Authentication is required to access this resource."), challengeContext.HttpContext.RequestAborted);
            },
            OnForbidden = async forbiddenContext =>
            {
                forbiddenContext.Response.StatusCode = StatusCodes.Status403Forbidden;
                await ApiProblemFactory.WriteAsync(forbiddenContext.Response, ApiProblemFactory.Create(
                    forbiddenContext.HttpContext,
                    StatusCodes.Status403Forbidden,
                    ApiProblemFactory.ForbiddenCode,
                    "Forbidden",
                    "You do not have permission to perform this action."), forbiddenContext.HttpContext.RequestAborted);
            }
        };
    });
builder.Services.AddAuthorization(options =>
{
    options.FallbackPolicy = new AuthorizationPolicyBuilder()
        .RequireAuthenticatedUser()
        .Build();
    options.AddPolicy("Admin", policy => policy.RequireRole("Admin"));
});

// Register MCP server for public IOC tools
builder.Services.AddMcpServer()
    .WithHttpTransport(options => options.Stateless = true)
    .WithToolsFromAssembly(typeof(PublicIocMcpServer).Assembly);
builder.Services.AddScoped<PublicIocMcpServer>();
builder.Services.AddScoped<IInProcessIocMcpClient, InProcessIocMcpClient>();
builder.Services.AddScoped<ThreatIntelligence.Infrastructure.AI.IocChatService>();
builder.Services.AddSingleton<ChatRateLimiter>();

// Register MCP configuration and rate limiter
builder.Services.Configure<McpConfiguration>(builder.Configuration.GetSection("Mcp"));
builder.Services.AddSingleton<McpRateLimiter>(sp =>
{
    var config = sp.GetRequiredService<IOptions<McpConfiguration>>().Value;
    return new McpRateLimiter(config);
});

var app = builder.Build();

app.Use(async (httpContext, next) =>
{
    var correlationId = httpContext.Request.Headers.TryGetValue("X-Correlation-ID", out var header)
        && !string.IsNullOrWhiteSpace(header)
        ? header.ToString()
        : httpContext.TraceIdentifier;

    httpContext.Response.Headers["X-Correlation-ID"] = correlationId;
    httpContext.Items["CorrelationId"] = correlationId;
    using (Serilog.Context.LogContext.PushProperty("CorrelationId", correlationId))
    {
        await next();
    }
});

app.UseSerilogRequestLogging();

app.UseMiddleware<ApiExceptionHandlingMiddleware>();
app.UseStatusCodePages(ApiProblemStatusCodePages.HandleAsync);
app.UseMiddleware<McpMiddleware>();

// Configure the HTTP request pipeline.
if (app.Environment.IsDevelopment() || app.Environment.IsEnvironment("Testing"))
{
    app.MapOpenApi().AllowAnonymous();
    app.MapScalarApiReference().AllowAnonymous();
}

app.UseHttpsRedirection();

app.UseAuthentication();
app.UseAuthorization();

app.MapControllers();
app.MapMcp("/mcp").AllowAnonymous();
app.MapHealthChecks("/health").AllowAnonymous();
app.MapHealthChecks("/health/live", new Microsoft.AspNetCore.Diagnostics.HealthChecks.HealthCheckOptions
{
    Predicate = _ => false
}).AllowAnonymous();

await using (var scope = app.Services.CreateAsyncScope())
{
    var initializer = scope.ServiceProvider.GetRequiredService<DatabaseInitializer>();
    await initializer.InitializeAsync(app.Lifetime.ApplicationStopping);
}

app.Run();

public partial class Program;

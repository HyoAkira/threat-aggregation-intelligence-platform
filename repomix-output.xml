        await client.FetchFeedAsync(CancellationToken.None);

        Assert.Contains(
            handler.LastRequest!.Headers.UserAgent,
            product => product.Product is not null && !string.IsNullOrWhiteSpace(product.Product.Name));
    }

    [Fact]
